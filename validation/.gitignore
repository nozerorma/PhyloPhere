# Paper validation (tier1, tier2, truthsets).
# Tracked: the scripts that build and run a fixture, its READMEs and specs, the GUI template, the reports, the
# reference papers and the truth sets. Ignored: everything those scripts regenerate.

# Built fixture content. Each fixture's scripts/build.py and scripts/build_cds.py recreate it.
tier1/input/**/align/
tier1/input/**/align_cds/
tier1/input/**/aln/
tier1/input/**/gene_trees/
tier1/input/**/oc_run/
tier1/input/**/*.fasta
tier1/input/**/*.fa
tier1/input/**/*.phy
tier1/input/**/*.aln
tier1/input/**/*.nwk
tier1/input/**/*.newick
tier1/input/**/*.nh
tier1/input/**/*.tree
tier1/input/**/*.tre
tier1/input/**/*.nex
tier1/input/**/*.phyml_tree*
tier1/input/**/*.iqtree.log
tier1/input/**/*.tsv
tier1/input/**/*.txt

# Raw inputs fetched by build.py.
tier1/input/**/*.coor_*
tier1/input/**/*.gb
tier1/input/**/*.gbk
tier1/input/**/*.genbank

# Exceptions: the files that describe and rebuild a fixture.
!tier1/input/**/README.md
!tier1/input/**/build.py
!tier1/input/**/build_cds.py
!tier1/input/**/*.spec.json
!tier1/input/**/positive_selection/*.tsv

# Run outputs: one directory per run under tier1/output/ and tier1/previous_work/output/.
tier1/output/**
!tier1/output/.gitkeep
tier1/previous_work/output/**
tier1/previous_work/input/**/*.tsv

# Bytecode.
__pycache__/
*.pyc
