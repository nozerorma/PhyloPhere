/*
 * ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 * Configuration file for setting up global parameters, process-specific resource requirements,
 * and execution profiles. This ensures optimal resource allocation and flexibility across
 * different compute environments.
 * This file can be left essentially untouched by the user, as most parameters are set in conf/common.config and other config files. 
 * ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 */

// The Nextflow log can be redirected to a stable directory with `export NXF_LOG_FILE="log/nextflow.log"`,
// set in the shell before the run.

// ── Global parameters ────────────────────────────────────────────────────────

// Global default params, used in configs
params {
    // Container flags. The singularity and apptainer profiles set them to true; do not modify here.
    use_singularity             = false
    use_apptainer               = false
    // executor.$slurm below is parsed whatever the active profile (it sits outside profiles{}),
    // so these three need a top-level default, as use_singularity and use_apptainer do.
    // They are editable in the GUI (Resources tab, SLURM executor group); the executor.$slurm
    // block explains each one and gui/models/resources.py holds the GUI defaults.
    slurm_queue_size            = '8'
    slurm_submit_rate_limit     = '30/1min'
    slurm_exit_read_timeout     = '4h'
}

// ── Profiles ─────────────────────────────────────────────────────────────────

// The singularity and apptainer profiles run the pipeline from a local SIF image, and set
// where the image cache lives. Apptainer is the successor of Singularity, and Nextflow
// exposes each one as its own scope.
// See https://nf-co.re/docs/usage/installation#pipeline-software
// and https://nf-co.re/tools#how-the-singularity-image-downloads-work
// See https://www.nextflow.io/docs/latest/config.html#scope-singularity

profiles {
    // Container profiles
    singularity {
        params {
            use_singularity         =  true
        }
        // Pre-pulled local SIF, as in the apptainer profile.
        process.container = "$baseDir/apptainer/miralnso-phylophere-latest.img"
        singularity.enabled         = true
        singularity.autoMounts      = true
        // The cache sits on an external drive: /home has little free space and /tmp (tmpfs, 7.5 GB)
        // is too small to unpack the image layers during a cold pull.
        singularity.cacheDir        = "/media/miguel/adfbf391-5867-414b-8af7-bceb102e6e92/apptainer_cache"
        // ociAutoPull must be false: the inline pull-then-exec of Nextflow 25.x fails with
        // "Failed to create container process: Operation not permitted" under the Ubuntu 24.04
        // AppArmor user-namespace restrictions. The SIF has to be pulled beforehand.
        singularity.ociAutoPull     = false
    }
    apptainer {
        params {
            use_apptainer           =  true
        }
        // Pre-pulled local SIF, which avoids the inline pull-then-exec failure of Nextflow 25.x
        // on a cold cache. The SIF must exist at $baseDir/apptainer/miralnso-phylophere-latest.img.
        process.container = "$baseDir/apptainer/miralnso-phylophere-latest.img"
        apptainer.enabled         = true
        apptainer.autoMounts      = true
        // The cache sits on an external drive: /home has little free space and /tmp (tmpfs, 7.5 GB)
        // is too small to unpack the image layers during a cold pull.
        apptainer.cacheDir        = "/media/miguel/adfbf391-5867-414b-8af7-bceb102e6e92/apptainer_cache"
        // ociAutoPull must be false, for the reason given in the singularity profile.
        apptainer.ociAutoPull     = false
    }
    
    // Execution profiles
    // slurm submits one SLURM job per task. The local profile also runs on a cluster: the whole
    // pipeline then sits in a single allocation on one node, and the work is spread over its threads.
    slurm {
        params {
            slurm_queue                = ''         // SLURM partition — "" = the cluster default; set by the GUI / -params-file
            max_memory                 = 128.GB
            max_cpus                   = 128
            max_time                   = 960.h
        }
        process {
            executor = 'slurm'
            // A non-text value (e.g. a bare `--slurm_queue`, which Nextflow reads as true)
            // means no partition, so SLURM uses its default.
            queue    = (params.slurm_queue instanceof CharSequence) ? params.slurm_queue.toString() : ''
            // params.max_* are ceilings: any request above them, including the `* task.attempt`
            // escalation of a retry, is clamped to them.
            resourceLimits = [
                cpus:   params.max_cpus as int,
                memory: params.max_memory as nextflow.util.MemoryUnit,
                time:   params.max_time as nextflow.util.Duration
            ]
        }
    }

    // Ad hoc local run. On a cluster, adjust the ceilings to the allocation.
    local {
        params {
            // These ceilings match the get_allocated_cpus(32) and get_allocated_mem(64) fallbacks
            // of the executor{} block below; the two must stay in sync.
            max_memory                 = 64.GB
            max_cpus                   = 32
            max_time                   = 5.day
        }
        process {
            // Same clamping as the slurm profile: a smaller machine sets --max_cpus and
            // --max_memory instead of carrying its own per-process table.
            resourceLimits = [
                cpus:   params.max_cpus as int,
                memory: params.max_memory as nextflow.util.MemoryUnit,
                time:   params.max_time as nextflow.util.Duration
            ]
        }
    }
}

// ── Environment and shell ────────────────────────────────────────────────────

// These variables keep the user's local Python and R libraries from shadowing those of the container.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'PhyloPhere'
    author          = """Miguel Ramon Alonso"""
    homePage        = 'https://github.com/nozerorma/PhyloPhere'
    description     = """Nexflow pipeline for running phylogenetic analyses"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=21.04.0'
    version         = '2.0'
    doi             = ''
}

// ── Allocation helpers ───────────────────────────────────────────────────────

// Fetch the CPUs and memory of the current execution node, from the SLURM environment when
// present and from a fixed default otherwise. They feed executor.$local below.

def parse_slurm_cpu_value(value, int fallback) {
    if (value == null) {
        return fallback
    }

    def text = value.toString().trim()
    if (!text) {
        return fallback
    }

    if (text ==~ /^\d+$/) {
        return text.toInteger()
    }

    def matcher = text =~ /^(\d+)(?:\(x\d+\))?$/
    if (matcher.matches()) {
        return matcher[0][1].toInteger()
    }

    return fallback
}

def get_allocated_cpus(int node_max_cpu) {
    return parse_slurm_cpu_value(
        System.getenv('SLURM_CPUS_PER_TASK:-1') ?: System.getenv('SLURM_JOB_CPUS_PER_NODE'),
        node_max_cpu
    )
}

def get_allocated_mem(int node_max_mem) {
    def memPerCpu = System.getenv('SLURM_MEM_PER_CPU')
    def cpusPerTask = parse_slurm_cpu_value(
        System.getenv('SLURM_CPUS_PER_TASK:-1') ?: System.getenv('SLURM_JOB_CPUS_PER_NODE'),
        0
    )
    if (memPerCpu && cpusPerTask) {
        // Use integer division to compute total memory in GB
        node_max_mem = memPerCpu.toInteger().intdiv(1000) * cpusPerTask
    }
    return "${node_max_mem}.GB"
}

// ── Executors ────────────────────────────────────────────────────────────────

// Executor configuration: local and slurm
executor {
    $local {
        // Total cores and memory come from the SLURM allocation when there is one
        cpus     = get_allocated_cpus(32)
        memory   = get_allocated_mem(64)
    }
    $slurm {
        // The lab account's SLURM QOS caps concurrent CPUs at 100 cluster-wide (`sacctmgr show qos`,
        // lab_anavarro: cpu=100), shared by every job the lab runs, not only this pipeline. Each
        // Nextflow instance keeps its own queueSize budget, unaware of the others, so the CPUs of
        // concurrent instances (several phenotypes, or the exploratory and complete passes that the
        // GUI batch mode launches) add up against the same ceiling. A submission above it is
        // rejected with QOSMaxCpuPerUserLimit (exit 53): the job never starts and neither
        // .command.log nor .exitcode is written.
        // CAAS_CORE_BATCHED requests 4 cpus and process_resample 12 (conf/resources.config).
        // A queueSize of 8 with up to 12 cpus per slot is at most 96 cpus per instance, under the
        // ceiling. Two instances of CAAS_CORE_BATCHED request 2 x slurm_queue_size x 4 cpus
        // (64 at the default of 8); a third instance would need this arithmetic revisited.
        // When several phenotypes run in parallel, lower queueSize further (or the %N cap of the
        // SBATCH array) so that the sum over all running instances stays under 100.
        submitRateLimit  = params.slurm_submit_rate_limit
        queueSize        = params.slurm_queue_size as int
        // A rejected or killed job never writes .exitcode, and Nextflow waits this long before
        // it declares the task failed. Until then such a task is reported as RUNNING, which
        // looks like an indefinite hang instead of a retryable failure. The value is long
        // enough to tolerate transient filesystem (NFS) staging lag and short enough not to
        // mask a dead job for days.
        exitReadTimeout  = params.slurm_exit_read_timeout as nextflow.util.Duration
    }
}

// ── Shared configuration ─────────────────────────────────────────────────────

// Resource, parameter and per-workflow settings live in conf/.
includeConfig 'conf/resources.config'
includeConfig 'conf/common.config'
includeConfig 'conf/ct.config'
includeConfig 'conf/rerconverge.config'
includeConfig 'conf/enrichment.config'
includeConfig 'conf/ct_disambiguation.config'
includeConfig 'conf/ct_postproc.config'
includeConfig 'conf/ct_accumulation.config'
includeConfig 'conf/fade.config'
includeConfig 'conf/vep.config'
includeConfig 'conf/scoring.config'

