/*
 * SCORING module configuration
 *
 * Composite CAAS scoring at position-level and gene-level.
 * Integrates outputs from CT_POSTPROC, FADE, RERConverge,
 * and CT_ACCUMULATION into a unified scoring framework.
 */

params {
    // ── Enrichment / STRING / COMPARE on scoring gene lists ──────────────────────
    scoring_string              = true
    scoring_compare_fdr         = 0.15
    scoring_compare_top_n       = 20
    scoring_stress              = true
    scoring_stress_top_n        = 25
    scoring_stress_rank_metric  = "spearman"

    // ── Thresholds for Enrichment gene list extraction ────────────────────────────
    scoring_position_top_pct            = scoring_position_top_pct          ?: 0.10       // Top 10% positions by CAAS_score (25%, 5%, 1% are hardcoded)
    scoring_gene_top_pct                = scoring_gene_top_pct              ?: 0.10       // Top 10% genes by each gene-level score (25%, 5%, 1% are hardcoded)

    // ── Standalone mode fallbacks ──────────────────────────────────────────
    // When scoring runs without upstream pipeline channels, provide paths directly. Leave empty ("") to skip that component.
    scoring_postproc_input              = scoring_postproc_input            ?: ""         // filtered_discovery.tsv
    scoring_fade_summary_top            = scoring_fade_summary_top          ?: ""         // fade_summary_top.tsv
    scoring_fade_summary_bottom         = scoring_fade_summary_bottom       ?: ""         // fade_summary_bottom.tsv
    scoring_rer_input                   = scoring_rer_input                 ?: ""         // rerconverge_summary_{trait}.tsv
    scoring_accum_dir                   = scoring_accum_dir                 ?: ""         // directory with accumulation_{scheme}_aggregated_results.csv
    scoring_vep_primateai               = scoring_vep_primateai             ?: ""         // primateai_scores.tsv
    scoring_vep_cosmic                  = scoring_vep_cosmic                ?: ""         // cosmic_scores.tsv
    scoring_fade_site_top               = scoring_fade_site_top             ?: ""         // fade_site_bf_top.tsv
    scoring_fade_site_bottom            = scoring_fade_site_bottom          ?: ""         // fade_site_bf_bottom.tsv
    scoring_window_size_bp              = scoring_window_size_bp            ?: 1000000    // overlap-report genomic window size
    scoring_background_input            = scoring_background_input          ?: ""         // cleaned_background_main.txt
    caas_perms_file                     = caas_perms_file                   ?: ""         // CAAS permulation RDS (corStat_byrank) for standalone SCORING p.perm
}
