/*
 * CT disambiguation configuration
 */

params {
    // Signification meta output consumed as disambiguation input (standalone runs).
    signification_from = signification_from ?: ""

    ct_disambig_asr_mode            = ct_disambig_asr_mode              ?: "precomputed"
    ct_disambig_asr_model           = ct_disambig_asr_model             ?: "lg"
    ct_disambig_asr_cache_dir       = ct_disambig_asr_cache_dir         ?: ""
    ct_disambig_convergence_mode    = ct_disambig_convergence_mode      ?: "focal_clade" // focal_clade uses each pair's individual mrca as source of truth; mrca uses ALL pairs mrca.

    // Canonical posterior threshold used:
    //   1. By disambiguation_main.py --posterior-threshold (ASR reconstruction stage)
    //   2. By CAAS_PREPARE_POSTPROC_INPUT (row-removal in post-processing stage)
    //   3. By ASR_ROBUSTNESS (site-retention filter: PASS iff p_min >= threshold)
    ct_disambig_posterior_threshold = ct_disambig_posterior_threshold   ?: 0.1

    // mp.Pool worker cap per child before recycling (memory hygiene, not a resource knob).
    // Thread/worker concurrency itself is derived from task.cpus (see conf/resources.config).
    ct_disambig_max_tasks_per_child = ct_disambig_max_tasks_per_child ?: 50

    // ASR robustness diagnostics (parallel module — does not affect cluster filtering).
    // Disambiguation always runs with --run-diagnostics, so the required JSONL files are present.
    asr_robustness = asr_robustness ?: true
}
