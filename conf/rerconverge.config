// rerconverge.config — RERconverge: relative evolutionary rates for continuous and binary traits.
// PhyloPhere | conf/

params {
    // ── Essential / common parameters ────────────────────────────────────────
    rer_trait_mode                = 'auto' // Trait type routing: 'auto' | 'continuous' | 'binary'
    rer_transform                 = 'ha_logit' // Trait transform: 'auto', 'ha_logit', 'logit', 'arcsin', 'log10', 'none'

    // ── Advanced parameters ──────────────────────────────────────────────────

    // Gene tree and matrix output paths
    gene_trees                    = "$baseDir/Data/Gene_trees/geneTrees.txt"
    trait_out                     = "$baseDir/Data/RER/RER_Traits/${params.traitname}.polished.output"
    trees_out                     = "$baseDir/Data/RER/RER_Objects/geneTrees.masterTree.pruned.output"
    matrix_out                    = "${params.outdir}/rer_objects/${params.traitname}.RERmatrix.output"

    // Quality thresholds and winsorization
    rer_minsp                     = "15"  // Minimum number of species required per gene
    winsorizeRER                  = "3"   // Winsorization threshold for RER values
    winsorizeTrait                = "3"   // Winsorization threshold for trait values

    // Permutation null calibration
    rer_perm_batches              = 10    // Number of permutation batches (0 = skip)
    rer_perms_per_batch           = 100   // Permutations per batch
    rer_batch_seed                = 1998 // Batch i uses seed + i - 1; batch boundaries define the simulated null

    // Binary mode options
    rer_binary_clade              = 'all' // Binary mode clade marking: 'all' | 'ancestral' | 'terminal'
    rer_min_pos                   = 2     // Minimum foreground lineages per gene in binary mode

    // Reporting and visualization thresholds
    rer_top_n_labels              = 20    // Top N genes to label on plots

    // Standalone and precomputed inputs
    rer_perms_file                = ""    // Standalone null: compatibility RDS file or directory of corStat block RDS files
    rer_continuous_file           = ""    // Precomputed continuous RER summary RDS file
    rer_binary_file               = ""    // Precomputed binary RER summary RDS file (binary traits)
    rer_universe_file             = ""    // RER tested-gene background universe file
    rer_gene_scores               = ""    // SCORING fcs_stats.tsv input for cross-module flags
}
