/*
 * RERconverge configuration
 */
params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    // Note: Main switch `rer_tool` lives in common.config ("continuous" | "build_trait")
    rer_trait_mode                = rer_trait_mode                ?: 'auto' // Trait type routing: 'auto' | 'continuous' | 'binary'

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================
    gene_trees                    = gene_trees                    ?: "$baseDir/Data/Gene_trees/geneTrees.txt"
    trait_out                     = trait_out                     ?: "$baseDir/Data/RER/RER_Traits/${params.traitname}.polished.output"
    trees_out                     = trees_out                     ?: "$baseDir/Data/RER/RER_Objects/geneTrees.masterTree.pruned.output"
    matrix_out                    = matrix_out                    ?: "${params.outdir}/rer_objects/${params.traitname}.RERmatrix.output"
    rer_minsp                     = rer_minsp                     ?: "15"  // Minimum number of species required per gene
    winsorizeRER                  = winsorizeRER                  ?: "3"   // Winsorization threshold for RER values
    winsorizeTrait                = winsorizeTrait                ?: "3"   // Winsorization threshold for trait values
    rer_perm_batches              = rer_perm_batches              ?: 10    // Number of permutation batches (0 = skip)
    rer_perms_per_batch           = rer_perms_per_batch           ?: 100   // Permutations per batch
    rer_binary_clade              = rer_binary_clade              ?: 'all' // Binary mode clade marking: 'all' | 'ancestral' | 'terminal'
    rer_min_pos                   = rer_min_pos                   ?: 2     // Minimum foreground lineages per gene in binary mode
    rer_pval_threshold            = rer_pval_threshold            ?: 0.05  // Significance threshold for report tables
    rer_pval_column               = rer_pval_column               ?: 'p.perm' // P-value column for sorting/filtering
    rer_top_n_labels              = rer_top_n_labels              ?: 20    // Top N genes to label on plots
    rer_top_pct                   = rer_top_pct                   ?: 0.10  // Top 10% cutoff for RER report
    rer_top5_pct                  = rer_top5_pct                  ?: 0.05  // Top 5% cutoff for RER report
    rer_top1_pct                  = rer_top1_pct                  ?: 0.01  // Top 1% cutoff for RER report
    rer_transform                 = rer_transform                 ?: 'ha_logit' // Trait transform: 'auto', 'ha_logit', 'logit', 'arcsin', 'log10', 'none'
    rer_perms_file                = rer_perms_file                ?: ""    // Standalone permulations RDS file
    rer_continuous_file           = rer_continuous_file           ?: ""    // Precomputed continuous RER summary RDS file
    rer_universe_file             = rer_universe_file             ?: ""    // RER tested-gene background universe file
    rer_gene_scores               = rer_gene_scores               ?: ""    // SCORING fcs_stats.tsv input for cross-module flags
}
