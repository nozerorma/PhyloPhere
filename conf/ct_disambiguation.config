// ct_disambiguation.config — CT disambiguation: ancestral state reconstruction (ASR) and the directional polarization of CAAS/CAAP.
// PhyloPhere | conf/

params {
    // ── Essential / common parameters ────────────────────────────────────────
    ct_disambig_asr_model           = "lg"          // ASR substitution model ("lg")
    // Required by the observed scoring (CAAS_CORE_BATCHED, CAAS_OBSERVED). It is the ASR result cache: a gene found
    // there is read, a gene missing from it is computed and written to it. The default is a writable directory
    // inside the project, not an empty value.
    ct_disambig_asr_cache_dir       = "${projectDir}/caches/.asr_cache" // ASR cache/precomputed-states directory (created if absent)
    ct_disambig_hypotheses_pairs    = ""            // contrast_hypotheses_pairs.tsv (FOP per-(hypothesis,domain) PSS weights). Weights the in-tree per-side FOP pooling of the hypothesis harvest. Integrated runs take it from this run's contrast selection; a standalone disambiguation run auto-discovers it in --outdir/data_exploration/2.CT/1.Traitfiles/; absent -> equal-weight node pooling.

    // ── Advanced parameters ──────────────────────────────────────────────────

    ct_disambig_posterior_threshold = 0.1           // Residues with an ASR posterior below it are dropped from the recorded distribution of a node (the most probable one is kept); that mass is charged as worst case in the score

    // ASR diagnostics
    asr_diagnostics                 = true          // Render the ASR diagnostics report (9.ASR_diagnostics.html)

    // Performance
    ct_disambig_max_tasks_per_child = 50            // Worker task recycling cap

    // Standalone input overrides
    meta_caas_from                  = ""            // global_meta_caas.tsv of a previous run: locates that run's outdir to reuse its permulation exports
}
