/*
 * CT Disambiguation configuration
 * Resolves ancestral states (ASR) to determine directional polarization of CAAS/CAAP
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    ct_disambig_asr_mode            = ct_disambig_asr_mode              ?: "precomputed" // ASR mode: "precomputed" | "compute"
    ct_disambig_asr_model           = ct_disambig_asr_model             ?: "lg"          // ASR substitution model ("lg")
    ct_disambig_convergence_mode    = ct_disambig_convergence_mode      ?: "focal_clade" // Convergence reference mode: "focal_clade" | "mrca"
    ct_disambig_posterior_threshold = ct_disambig_posterior_threshold   ?: 0.1           // ASR posterior probability threshold (0.10)

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================

    // Sensitivity and robustness testing
    asr_robustness                  = asr_robustness                    ?: true          // Enable ASR robustness sensitivity diagnostic

    // Performance and batching
    ct_disambig_max_tasks_per_child = ct_disambig_max_tasks_per_child   ?: 50            // Worker task recycling cap

    // Standalone input overrides
    ct_disambig_asr_cache_dir       = ct_disambig_asr_cache_dir         ?: ""            // Directory containing precomputed ASR states
    signification_from              = signification_from                ?: ""            // Standalone signification input directory
}
