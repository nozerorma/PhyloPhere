/*
 * CT Disambiguation configuration
 * Resolves ancestral states (ASR) to determine directional polarization of CAAS/CAAP
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    ct_disambig_asr_model           = "lg"          // ASR substitution model ("lg")
    // Required by the observed scoring (CAAS_CORE_BATCHED, CAAS_OBSERVED); it is the ASR result cache: a gene found
    // there is read, a gene missing from it is computed and written to it. It defaults to a run-local writable
    // directory rather than "".
    ct_disambig_asr_cache_dir       = "${projectDir}/caches/.asr_cache" // ASR cache/precomputed-states directory (created if absent)
    ct_disambig_hypotheses_pairs    = ""            // contrast_hypotheses_pairs.tsv (FOP per-(hypothesis,domain) PSS weights). Weights the in-tree per-side FOP pooling of the hypothesis harvest. Integrated runs take it from this run's contrast selection; a standalone disambiguation run auto-discovers it in --outdir/data_exploration/2.CT/1.Traitfiles/; absent -> equal-weight node pooling. [T3c SC3]

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================

    ct_disambig_posterior_threshold = 0.1           // ASR posterior probability threshold (0.10)

    // Sensitivity and robustness testing
    asr_robustness                  = true          // Enable ASR robustness sensitivity diagnostic

    // Performance
    ct_disambig_max_tasks_per_child = 50            // Worker task recycling cap

    // Standalone input overrides
    meta_caas_from                  = ""            // global_meta_caas.tsv of a previous run: locates that run's outdir to reuse its permulation exports
    signification_from              = ""            // Deprecated alias for meta_caas_from, kept for older scripts/configs
}
