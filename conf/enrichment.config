/*
 * Enrichment configuration
 */
params {
    // Enable enrichment module
    enrichment = enrichment ?: false

    // Inputs for standalone enrichment mode (optional when piping from CT postproc)
    enrichment_background_input = enrichment_background_input ?: ""
    enrichment_gene_lists_input = enrichment_gene_lists_input ?: ""
    accumulation_enrichment_gene_lists_input = accumulation_enrichment_gene_lists_input ?: ""

    // Core enrichment settings
    enrichment_project_name = enrichment_project_name ?: "Enrichment_clusterProfiler"
    enrichment_accumulation_project_name = enrichment_accumulation_project_name ?: "Enrichment_Accumulation"
    enrichment_organism = enrichment_organism ?: "hsapiens"

    enrichment_databases_default = enrichment_databases_default ?: "geneontology_Biological_Process_noRedundant,geneontology_Cellular_Component_noRedundant,geneontology_Molecular_Function_noRedundant,pathway_KEGG,pathway_Reactome,pathway_Wikipathway,pathway_Wikipathway_cancer,disease_Disgenet,disease_OMIM,phenotype_Human_Phenotype_Ontology,network_CORUMA,network_Kinase_target"
    enrichment_databases_extra = enrichment_databases_extra ?: "pathway_Panther,network_PPI_BIOGRID,network_Transcription_Factor_target,network_miRNA_target,chromosomalLocation_CytogeneticBand"

    // Statistical thresholds
    enrichment_min_num    = enrichment_min_num    ?: 5
    enrichment_max_num    = enrichment_max_num    ?: 500
    enrichment_fdr        = enrichment_fdr        ?: 0.15
    enrichment_top_thr    = enrichment_top_thr    ?: 15
    enrichment_report_num = enrichment_report_num ?: 20
    enrichment_threads    = enrichment_threads    ?: 8
    enrichment_enable_overlap_heatmap = enrichment_enable_overlap_heatmap ?: true
    enrichment_enable_enrichment_map  = enrichment_enable_enrichment_map  ?: false
    enrichment_overlap_top_terms      = enrichment_overlap_top_terms      ?: 50
    enrichment_compare_metric         = enrichment_compare_metric         ?: 'overlap'

    // ── STRING enrichment ────────────────────────────────────────────────────
    string = string ?: false
    string_project_name   = string_project_name ?: 'STRING_Analysis'
    string_species        = string_species        ?: 9606
    string_required_score    = string_required_score    ?: 400
    // network_score_thr: higher threshold used for walktrap clustering and network
    // visualisation (cleaner graphs); enrichment uses required_score (see STRING_general.Rmd).
    string_network_score_thr = string_network_score_thr ?: 700

    // Statistical thresholds
    string_fdr            = string_fdr         ?: 0.15
    string_top_thr        = string_top_thr     ?: 15
    string_report_num     = string_report_num  ?: 20
    // PPI density test (STRINGdb get_ppi_enrichment): does the interest set have more
    // internal interactions than expected by chance? It HONOURS the custom background.
    string_enable_ppi     = string_enable_ppi  ?: true

    // ── FCS (Wilcoxon-AUC) enrichment ─────────────────────────
    fcs_min_genes = fcs_min_genes ?: 5
    // Dual-threshold significance (RERconverge categorical convention, msae210):
    //   a set is "significant" when its BH-adjusted p < fcs_fdr AND — when
    //   permulations are available — its permulation p < fcs_pperm_thr. The two are
    //   independent knobs: fcs_fdr (relaxed because the few-species regime is
    //   underpowered) controls multiplicity; fcs_pperm_thr is the phylogenetic
    //   non-independence filter. With no permulations, only fcs_fdr applies.
    fcs_fdr       = fcs_fdr       ?: 0.15
    fcs_pperm_thr = fcs_pperm_thr ?: 0.025
    fcs_top_n     = fcs_top_n     ?: 20
    rer_permulation_enrichment = rer_permulation_enrichment ?: false
    // CAAS genome-wide permulation-excess null → p.perm on the score_*_asr rankings
    // of the CAAS scoring FCS report (parallels rer_permulation_enrichment).
    caas_permulation_enrichment = caas_permulation_enrichment ?: false

    gmt_dir                     = gmt_dir                   ?: "/homes/users/mramon/scratch/2.Primates/1.Primates_data/4.External_DBs/GMTs"

    // ── POSENRICH: position-wise enrichment (XL-mHG) ─────────────────────────
    // NOT the gene FCS — its own parameters (members are POSITIONS, not genes).
    posenrich                   = posenrich                 ?: false
    // Set-size bounds: min / max POSITIONS per set to test.
    posenrich_min_size          = posenrich_min_size        ?: 5
    posenrich_max_size          = posenrich_max_size        ?: 1000
    // XL-mHG X: minimum set positions required above the mHG cutoff for it to
    // count (>=2 neutralises one-hit-wonders; the position analog of the old
    // min_positive_overlap).
    posenrich_min_overlap       = posenrich_min_overlap     ?: 2
    // No permulation at position level: the exact XL-mHG p.adj already corrects
    // the cutoff-optimisation, and the CAAS permulation null is a naive random
    // relabeling (random cross-tree pairs, NOT the observed matched sister pairs)
    // so it would not isolate the phenotype here. `n_le_genes` flags within-gene
    // clumping instead. (The gene-level FCS still uses p.perm; see its report.)
    // Optional override: a static caastools background.output. Empty => use the
    // in-run discovery background (ct_results.background_file). The engine
    // restricts it to the cleaned_background genes (minus the negative overlap).
    posenrich_background_file   = posenrich_background_file  ?: ""
    gene_ensembl_file           = params.gene_ensembl_file
    domain_variability_file     = domain_variability_file   ?: "/homes/users/mramon/scratch/4.Generate_alignments_from_codons/results_ppga/20260615_200027/reports/variability/domain_variability.tsv"
    ucr_positions_file          = ucr_positions_file        ?: "/homes/users/mramon/scratch/4.Generate_alignments_from_codons/results_ppga/20260615_200027/reports/variability/ucr_positions.tsv"
    fubar_sites_file            = fubar_sites_file          ?: "/homes/users/mramon/scratch/4.Generate_alignments_from_codons/results_ppga/20260615_200027/reports/positive_selection/fubar_sites.tsv"
    egg_members_file            = egg_members_file          ?: "/homes/users/mramon/scratch/2.Primates/1.Primates_data/4.External_DBs/eggNOG/9443_members.tsv"
    egg_annotations_file        = egg_annotations_file      ?: "/homes/users/mramon/scratch/2.Primates/1.Primates_data/4.External_DBs/eggNOG/9443_annotations.tsv"
}
