/*
 * Enrichment configuration
 * FCS pathway enrichment, DOMINO active module identification, and POSENRICH position enrichment
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    string_db_dir               = string_db_dir             ?: ""   // Path to STRING DB local cache directory
    gmt_dir                     = gmt_dir                   ?: ""   // Directory containing custom GMT gene set files. Leave blank to auto-fetch the default GO BP/MF + Reactome + WikiPathways set (bin/resolve_gmts.py), falling back to assets/gmt/ if offline
    string_species              = string_species            ?: 9606 // STRING species NCBI taxid (default: 9606 human)

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================

    string_cache_dir            = string_cache_dir          ?: ""   // Persistent cache dir for auto-downloaded STRING files (default: ~/.cache/phylophere/string); string_db_dir is checked first if set

    // FCS gene-set enrichment parameters
    fcs_min_genes               = fcs_min_genes             ?: 5    // Minimum set size (genes) for FCS enrichment
    fcs_max_genes               = fcs_max_genes             ?: 1000  // Maximum set size (genes) for FCS enrichment (0 = no limit)
    fcs_fdr                     = fcs_fdr                   ?: 0.15 // Benjamini-Hochberg FDR threshold for FCS (fallback for the per-method thresholds below)
    fcs_fdr_wilcoxon            = fcs_fdr_wilcoxon          ?: (fcs_fdr ?: 0.15)  // sig_wilcoxon FDR gate: RER standard 0.15 + p.perm gate
    fcs_fdr_lachenbruch         = fcs_fdr_lachenbruch       ?: 0.05  // sig_lachenbruch FDR gate: analytic, no perm gate -> stricter
    fcs_fdr_permsum             = fcs_fdr_permsum           ?: 0.05  // sig_permulation FDR gate: gene-label shuffle null -> stricter
    fcs_pperm_thr               = fcs_pperm_thr             ?: 0.025// Permulation p-value threshold for FCS (Wilcoxon gate only)
    fcs_top_n                   = fcs_top_n                 ?: 20   // Top N sets to display in report tables
    caas_permulation_enrichment = caas_permulation_enrichment ?: true // Use CAAS permulations for Wilcoxon FCS null
    // Number of GMT files per FCS_COMPUTE_BATCHED task. fcs_run_all()'s BH
    // correction is already scoped per database throughout fcs_enrich.R, so
    // splitting the GMT set across independent Nextflow tasks and
    // row-concatenating their results (FCS_CONCAT) changes nothing statistically.
    fcs_batch_size               = fcs_batch_size            ?: 4

    // Cross-module comparison report (15.Comparison_report.Rmd)
    // Tier 4D -- unpaired CAAS x RER gene-score concordance null. The CAAS
    // phenotype-labeling null and the RER Brownian-motion null share no seed or
    // cycle order, so this is a randomization null on the concordance statistic
    // ("observed CAAS/RER agreement no larger than for two independent gene-score
    // vectors of matched marginal shape"), NOT a joint permulation p.
    comparison_perm_null        = comparison_perm_null        ?: true       // Enable the CAAS x RER concordance null chunk
    comparison_perm_stat        = comparison_perm_stat        ?: "spearman" // "spearman" | "topk_overlap"
    comparison_perm_topk        = comparison_perm_topk        ?: 0.05       // top-fraction for the topk_overlap statistic

    // DOMINO active module identification thresholds
    domino_network_score_thr    = domino_network_score_thr  ?: 700  // STRING combined score threshold for DOMINO network edges
    domino_slice_thr            = domino_slice_thr          ?: 0.3  // DOMINO network slice relevance threshold
    domino_module_thr           = domino_module_thr         ?: 0.05 // DOMINO module significance threshold
    publish_domino_intermediates = publish_domino_intermediates ?: false // Publish DOMINO intermediate network files (debug)

    // POSENRICH position-wise enrichment parameters
    posenrich_min_size          = posenrich_min_size        ?: 5    // Minimum position set size
    posenrich_max_size          = posenrich_max_size        ?: 0    // Maximum position set size (0 = no limit)
    posenrich_padj_thr          = posenrich_padj_thr        ?: 0.15 // Adjusted p-value cutoff for POSENRICH
    posenrich_background_file   = posenrich_background_file  ?: ""   // Static background override file
    // Number of GMT files per POSENRICH_RUN_BATCHED task (1 = no batching, run
    // POSENRICH_RUN as one monolithic task over all GMTs, same as before batching
    // existed). BH correction is already scoped per (direction, db) inside
    // posenrich_enrich.py, so splitting by GMT file changes nothing statistically.
    posenrich_batch_size        = posenrich_batch_size      ?: 4
    domain_variability_file     = domain_variability_file   ?: ""   // Domain variability file. Leave blank to auto-generate via a cached Pfam-A + hmmscan
    pfam_cache_dir              = pfam_cache_dir            ?: ""   // Local Pfam-A.hmm + Pfam-A.clans.tsv cache dir (default: ~/.cache/phylophere/pfam); downloaded once, never committed
    domain_ref_species          = domain_ref_species        ?: "Homo_sapiens" // Reference species for domain-variability hmmscan
    ucr_positions_file          = ucr_positions_file        ?: ""   // UCR positions file. Leave blank to auto-generate from the alignment (Valdar variability + UCR detection)
    fubar_sites_file            = fubar_sites_file          ?: ""   // FUBAR sites file (generated by ortholog_characterizator) — cannot be generated in-house (HyPhy per-site selection fit needs the full phylogeny + codon alignment + MCMC/VB inference)
    egg_members_file            = egg_members_file          ?: ""   // eggNOG members file
    egg_annotations_file        = egg_annotations_file      ?: ""   // eggNOG annotations file
}
