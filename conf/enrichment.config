/*
 * Enrichment configuration
 */
params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    // Note: Main toggles `enrichment` and `posenrich` live in common.config
    string_db_dir               = string_db_dir             ?: ""   // Path to STRING DB local cache directory

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================
    gmt_dir                     = gmt_dir                   ?: ""   // Directory containing custom GMT gene set files
    string_species              = string_species            ?: 9606 // STRING species NCBI taxid (default 9606 human)

    // DOMINO active module identification thresholds
    domino_network_score_thr    = domino_network_score_thr  ?: 700  // STRING combined score threshold for DOMINO network edges
    domino_slice_thr            = domino_slice_thr          ?: 0.3  // DOMINO network slice relevance threshold
    domino_module_thr           = domino_module_thr         ?: 0.05 // DOMINO module significance threshold
    publish_domino_intermediates = publish_domino_intermediates ?: false // Publish DOMINO network.sif/domino_modules/edge_scores to outdir/ami/domino/<consumer> (off by default: large, not needed by the AMI report itself, only for manual regeneration)

    // FCS (Wilcoxon-AUC) gene-set enrichment parameters
    fcs_min_genes               = fcs_min_genes             ?: 5    // Minimum set size (genes) for FCS enrichment
    fcs_fdr                     = fcs_fdr                   ?: 0.15 // Benjamini-Hochberg FDR threshold for FCS
    fcs_pperm_thr               = fcs_pperm_thr             ?: 0.025// Permulation p-value threshold for FCS
    fcs_top_n                   = fcs_top_n                 ?: 20   // Top N sets to display in report tables
    caas_permulation_enrichment = caas_permulation_enrichment ?: true// Use CAAS permulations for FCS null

    // POSENRICH position-wise enrichment parameters
    posenrich_min_size          = posenrich_min_size        ?: 5    // Minimum position set size
    posenrich_max_size          = posenrich_max_size        ?: 0    // Maximum position set size (0 = no limit)
    posenrich_padj_thr          = posenrich_padj_thr        ?: 0.15 // Adjusted p-value cutoff for POSENRICH
    posenrich_background_file   = posenrich_background_file  ?: ""   // Static background override file
    domain_variability_file     = domain_variability_file   ?: ""   // Domain variability file (generated by ortholog_characterizator)
    ucr_positions_file          = ucr_positions_file        ?: ""   // UCR positions file (generated by ortholog_characterizator)
    fubar_sites_file            = fubar_sites_file          ?: ""   // FUBAR sites file (generated by ortholog_characterizator)
    egg_members_file            = egg_members_file          ?: ""   // eggNOG members file
    egg_annotations_file        = egg_annotations_file      ?: ""   // eggNOG annotations file
}
