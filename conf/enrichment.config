/*
 * Enrichment configuration
 */
params {
    // Inputs for standalone Accumulation-AMI mode (optional when piping from CT postproc)
    accumulation_enrichment_gene_lists_input = accumulation_enrichment_gene_lists_input ?: ""

    // Project/report names are derived per-consumer as "<Tool>_${params.traitname}".
    gmt_dir                     = gmt_dir                   ?: ""

    // ── STRING (AMI analysis support) ─────────────────────────────────────────
    // STRING is used ONLY for ID mapping ($map()), background caching, and
    // per-DOMINO-module functional labelling (get_enrichment_local()/
    // get_enrichment()) now -- module finding + significance is DOMINO's job
    // (see below), and there is no standalone whole-list STRING term-enrichment
    // report anymore (see 13.AMI_analysis.Rmd). Network-edge filtering is
    // DOMINO's own domino_network_score_thr (below) -- none of the 3 STRINGdb
    // methods still in use ($map/$set_background/$get_enrichment) are affected
    // by a combined-score threshold, so there used to be a string_required_score
    // param here that did nothing; it's been removed.
    string_species        = string_species        ?: 9606
    string_db_dir            = string_db_dir            ?: ""

    // ── DOMINO active module identification ──────────────────────────────────
    // Replaces STRING's walktrap clustering + get_ppi_enrichment() significance
    // (both cannot honour a custom background >2000 proteins; our
    // cleaned_background is ~10,447 -- see subworkflows/ENRICHMENT/domino.nf).
    // network_score_thr: STRING combined_score cutoff for edges kept when
    // building DOMINO's input network.sif. Measured against real bottom10 CAAS
    // gene lists: 700 covers 81.8% of background nodes / 77.5% of list genes,
    // vs 900's 62.7%/58.8% and 400's noisier 99.1%/99.0% -- matches this
    // pipeline's existing production network-confidence convention.
    domino_network_score_thr = domino_network_score_thr ?: 700
    // DOMINO's own defaults (src/runner.py): slice_threshold gates which network
    // slices are "relevant" before module search; module_threshold is the
    // Bonferroni-style significance gate for accepting a final module.
    domino_slice_thr         = domino_slice_thr         ?: 0.3
    domino_module_thr        = domino_module_thr        ?: 0.05

    // ── FCS (Wilcoxon-AUC) enrichment ─────────────────────────
    fcs_min_genes = fcs_min_genes ?: 5

    // Dual-threshold significance (RERconverge categorical convention, msae210):
    //   a set is "significant" when its BH-adjusted p < fcs_fdr AND — when
    //   permulations are available — its permulation p < fcs_pperm_thr. The two are
    //   independent knobs: fcs_fdr (relaxed because the few-species regime is
    //   underpowered) controls multiplicity; fcs_pperm_thr is the phylogenetic
    //   non-independence filter. With no permulations, only fcs_fdr applies.
    fcs_fdr       = fcs_fdr       ?: 0.15
    fcs_pperm_thr = fcs_pperm_thr ?: 0.025
    fcs_top_n     = fcs_top_n     ?: 20
    rer_permulation_enrichment = rer_permulation_enrichment ?: true

    // CAAS genome-wide permulation-excess null → p.perm on the score_*_asr rankings
    // of the CAAS scoring FCS report (parallels rer_permulation_enrichment).
    caas_permulation_enrichment = caas_permulation_enrichment ?: true

    // ── POSENRICH: position-wise enrichment (Fisher-exact, fixed cutoffs) ────
    // NOT the gene FCS — its own parameters (members are POSITIONS, not genes).
    // Set-size bounds: min / max POSITIONS per set to test (0 = no cap; GMT-style
    // sources only — the broad characterization layers are never size-filtered).
    posenrich_min_size          = posenrich_min_size        ?: 5
    posenrich_max_size          = posenrich_max_size        ?: 0
    // Fisher's exact test at three fixed foreground cutoffs (top 10/5/1% of
    // scored positions per direction), run per (ranking, database, pathway).
    // Significance is dual-gated — BH-adjusted p < posenrich_padj_thr AND
    // fold-enrichment clearing posenrich_fold_thr (or its reciprocal, for
    // depletion) — because Fisher/hypergeometric tests gain enormous power at
    // this N (~1.47M positions), enough that a barely-there deviation from
    // the null ratio can otherwise reach a "significant" p-value on its own.
    // See posenrich_enrich.py's docstring.
    posenrich_padj_thr          = posenrich_padj_thr        ?: 0.15
    posenrich_fold_thr          = posenrich_fold_thr        ?: 1.5

    // No permulation at position level: the exact Fisher p already corrects for
    // the fixed cutoff (there is no cutoff search to correct for), and the CAAS
    // permulation null is a naive random relabeling (random cross-tree pairs,
    // NOT the observed matched sister pairs) so it would not isolate the
    // phenotype here. (The gene-level FCS still uses p.perm; see its report.)
    // Optional override: a static caastools background.output. Empty => use the
    // in-run discovery background (ct_results.background_file). The engine
    // restricts it to the cleaned_background genes (minus the negative overlap).
    posenrich_background_file   = posenrich_background_file  ?: ""
    gene_ensembl_file           = params.gene_ensembl_file  ?: ""
    domain_variability_file     = domain_variability_file   ?: ""
    ucr_positions_file          = ucr_positions_file        ?: ""
    fubar_sites_file            = fubar_sites_file          ?: ""
    egg_members_file            = egg_members_file          ?: ""
    egg_annotations_file        = egg_annotations_file      ?: ""
}
