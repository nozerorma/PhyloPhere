// enrichment.config — Enrichment: FCS pathway enrichment, DOMINO active modules and POSENRICH position enrichment.
// PhyloPhere | conf/

params {
    // ── Essential / common parameters ────────────────────────────────────────
    string_db_dir               = ""   // Path to STRING DB local cache directory
    fcs_enabled                 = true // Gate FCS (ranked-Wilcoxon) enrichment
    auto_fetch_gmt              = false // With gmt_dir blank, also download the current GO and WikiPathways gene sets (added to the versioned ones in subworkflows/ENRICHMENT/dat)
    auto_fetch_eggnog           = false // Download the eggNOG orthogroup pair of eggnog_taxid instead of using the copy versioned in subworkflows/ENRICHMENT/dat (human members, tax level 9443)
    gmt_dir                     = "${projectDir}/subworkflows/ENRICHMENT/dat" // Directory containing GMT gene set files (default: curated GMTs in subworkflows/ENRICHMENT/dat)
    string_species              = params.ref_species_taxid ?: 9606 // STRING species NCBI taxid (default: ref_species_taxid or 9606)

    // ── Advanced parameters ──────────────────────────────────────────────────

    string_cache_dir            = ""   // Persistent cache dir for auto-downloaded STRING files (default: ~/.cache/phylophere/string); string_db_dir is checked first if set

    // FCS gene-set enrichment parameters
    fcs_min_genes               = 10   // Minimum set size (genes) for FCS enrichment
    fcs_max_genes               = 0    // Maximum set size (genes) for FCS enrichment (0 = no limit)
    fcs_fdr                     = 0.15 // Benjamini-Hochberg threshold on the permulation p of each set (q.perm), per ranking and database; also the FDR of POSENRICH
    fcs_pperm_thr               = 0.025 // Raw permulation-p threshold of the Redlich analytic rule; independent of q.perm significance
    fcs_analytic_levels         = "0.05,0.1,0.15" // Analytic rule of Redlich et al. 2024, reported as redlich_level: BH of the analytic p below each level, and p.perm below fcs_pperm_thr
    fcs_cluster_threshold       = 0.2  // Term blocks of the selected sets: minimum Jaccard of the full gene sets inside a block (complete linkage)
    fcs_top_n                   = 20   // Top N sets to display in report tables
    caas_permulation_enrichment = true // Use CAAS permulations for Wilcoxon FCS null
    // Number of GMT files per FCS_COMPUTE_BATCHED task. The BH correction of fcs_enrich.R is scoped
    // per database, so splitting the GMT set across tasks and row-concatenating the results
    // (FCS_CONCAT) does not change the adjusted p-values.
    fcs_batch_size               = 4
    fcs_block_batch_genes        = 1000 // Genes per GENE_P task; memory grows with genes per batch x total cycles

    // DOMINO active module identification thresholds
    domino_network_score_thr    = 700  // STRING combined score threshold for DOMINO network edges
    domino_slice_thr            = 0.3  // DOMINO network slice relevance threshold
    ami_description_fdr         = 0.10 // Descriptive STRING labels only; separate from gene/FCS/module tests
    ami_max_blocks              = 8    // Blocks shown in the label and the block summary of each AMI module; the tables keep every block
    ami_block_threshold         = 0.2  // Minimum Jaccard of the module genes of any two terms in the same AMI block (complete linkage)
    domino_module_thr           = 0.05 // DOMINO module significance threshold
    publish_domino_intermediates = false // Publish DOMINO intermediate network files (debug)

    // POSENRICH position-wise enrichment parameters
    posenrich_min_size          = 2    // Minimum position set size
    posenrich_max_size          = 0    // Maximum position set size (0 = no limit)
    posenrich_background_file   = ""   // Static background override file
    // Number of GMT files per POSENRICH_RUN_BATCHED task (1 = no batching: POSENRICH_RUN runs one task over
    // all GMTs). The BH correction of posenrich_enrich.py is scoped per (ranking, database), so splitting
    // by GMT file does not change the adjusted p-values.
    posenrich_batch_size        = 4
    posenrich_domains           = true // Include Pfam annotations; generate when file is blank
    position_registry_memory   = '' // Full normalized registry
    position_module_memory     = '' // Full positional tables
    position_annotation_memory = '' // Full reference annotation; override for small inputs
    domain_variability_file     = ""   // Domain variability file. Blank generates Pfam on productive alignments; accepts original PPGA and explicit coordinate formats
    pfam_cache_dir              = ""   // Local Pfam-A.hmm + Pfam-A.clans.tsv cache dir (default: ~/.cache/phylophere/pfam); downloaded once and reused
    domain_ref_species          = params.ref_species_name ?: "Homo_sapiens" // Reference species for domain-variability hmmscan
    posenrich_ucr               = true // Include UCR annotations; generate when file is blank
    ucr_positions_file          = ""   // UCR positions file. Blank generates global sliding UCR on productive alignments; accepts original PPGA tables
    posenrich_custom_file       = ""   // TSV: gene, zero-based CAAS position, term, optional description; no header
    fubar_sites_file            = ""   // FUBAR sites file produced by ortholog_characterizator; this pipeline does not generate it (the HyPhy per-site fit needs the full phylogeny, the codon alignment and MCMC/VB inference)
    eggnog_taxid                = params.clade_taxid ?: "9443" // eggNOG taxon level (default: clade_taxid or 9443)
    egg_members_file            = ""   // eggNOG members file. Leave blank to use the versioned pair (or the download, with auto_fetch_eggnog)
    egg_annotations_file        = ""   // eggNOG annotations file. Leave blank together with egg_members_file (same resolution as that file)

    // POSENRICH modular (WP10): registro común + caracterización + localización dentro de
    // proteínas + asociación global + proximidad. La inferencia histórica (Lachenbruch) sigue
    // omitida; este flag no la reactiva ni recupera el nulo histórico.
    posenrich_modular           = false // Activa componentes descriptivos; inferencia retenida hasta validar universo/control
    posenrich_ranking           = "caas_score" // Ranking principal: caas_score (continuo, mejor lado) o minus_log10_pemp (sensibilidad explícita sobre el p.emp compartido)
    posenrich_aggregation       = "mean"  // Agregación principal entre genes: mean (igual peso) o pair_weighted (sensibilidad)
    posenrich_n_permutations    = 999   // Solicitud reservada; B_valid=0 hasta validar el control
    posenrich_seed              = 1     // Semilla reservada para el prototipo de control
    posenrich_radios            = "0,5,10" // Radios descriptivos de proximidad proteica (residuos de referencia), fijados antes del contraste
}
