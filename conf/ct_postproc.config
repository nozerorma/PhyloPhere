/*
 * CT Post-Processing configuration
 * Handles cluster filtering, gene-level quality filtering, and characterization
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    caas_postproc_mode          = caas_postproc_mode          ?: "filter" // "filter" (production single run) | "exploratory" (parameter sweep)
    filter_minlen               = filter_minlen               ?: 3        // Minimum alignment length required per cluster
    filter_maxcaas              = filter_maxcaas              ?: 0.7      // Maximum CAAS density fraction allowed per cluster
    gene_filter_mode            = gene_filter_mode            ?: "dubious" // Outlier removal mode: "none" | "extreme" | "dubious" | "both"

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================

    // Exploratory parameter sweep values
    minlen_values               = minlen_values               ?: "2,3,4,10" // Parameter sweep values for exploratory mode
    maxcaas_values              = maxcaas_values              ?: "0.6,0.7,0.8" // Parameter sweep values for exploratory mode

    // Gene-level outlier thresholds
    extreme_threshold           = extreme_threshold           ?: 0.99      // Top quantile cutoff for extreme genes (0.99 = top 1%)
    iqr_multiplier              = iqr_multiplier              ?: 3.0       // IQR multiplier for dubious gene threshold (e.g. 3.0x IQR)

    // Directional gene sets (downstream exports)
    postproc_top                = postproc_top                ?: "" // Top-direction candidate genes list file (for FADE / RER gene_set mode)
    postproc_bottom             = postproc_bottom             ?: "" // Bottom-direction candidate genes list file (for FADE / RER gene_set mode)

    // Standalone input overrides
    disambiguation_input        = disambiguation_input        ?: "" // Standalone caas_convergence_master.csv override
    disambiguation_dir          = disambiguation_dir          ?: "" // Standalone disambiguation directory or .tar.gz archive
    background_input            = background_input            ?: "" // Standalone background file(s) or directory override
}
