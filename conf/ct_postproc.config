/*
 * CT Post-Processing configuration
 * Handles cluster filtering, gene-level quality filtering, and characterization
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    caas_postproc_mode          = "filter" // "filter" (production single run) | "exploratory" (parameter sweep)
    filter_minlen               = 3        // Minimum alignment length required per cluster
    gene_filter_mode            = "dubious" // Outlier removal mode: "none" | "extreme" | "dubious" | "both"
    remove_caas_clusters        = true      // Discard spatial CAAS clusters from filtered discovery, decoupled from gene filtering

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================

    // Exploratory parameter sweep values
    minlen_values               = "2,3,4,10" // Parameter sweep values for exploratory mode
    maxcaas_values              = "0.6,0.7,0.8" // Parameter sweep values for exploratory mode

    // Gene-level outlier thresholds
    extreme_threshold           = 0.99      // Top quantile cutoff for extreme genes (0.99 = top 1%)
    iqr_multiplier              = 3.0       // IQR multiplier for dubious gene threshold (e.g. 3.0x IQR)

    // Directional gene sets (downstream exports)
    postproc_top                = "" // Top-direction candidate genes list file (for FADE / RER gene_set mode)
    postproc_bottom             = "" // Bottom-direction candidate genes list file (for FADE / RER gene_set mode)

    // Standalone input overrides
    disambiguation_input        = "" // Standalone caas_convergence_master.csv override
    disambiguation_dir          = "" // Standalone disambiguation directory or .tar.gz archive
    background_input            = "" // Standalone background file(s) or directory override
}
