// ct_postproc.config — CT_POSTPROC: cluster filtering, gene-level quality filtering and characterization.
// PhyloPhere | conf/

params {
    // ── Essential / common parameters ────────────────────────────────────────
    caas_postproc_mode          = "filter" // "filter" (production single run) | "exploratory" (parameter sweep)
    filter_minlen               = 3        // Minimum interval span in alignment columns
    filter_min_positions        = null     // Minimum candidates per interval; null retains the legacy gene-count gate of filter_minlen. Set explicitly to separate interval count from span.
    filter_maxcaas              = 0.7      // Maximum CAAS density of a cluster window (count / span); used by the filter mode and by the null
    caas_map_dir                = params.containsKey("vep_map_dir") ? params.vep_map_dir : "" // Directory of the trimmer's per-gene MAP tables (GENE*.map.tsv, see github.com/nozerorma/ortholog_characterizator). When set, cluster trains measure their span in untrimmed alignment columns, in the observed filter and in the permulation null alike, and VEP maps positions with the same tables. Empty: trimmed-alignment coordinates. A gene without a MAP file keeps trimmed coordinates. The default is the value of vep_map_dir when that parameter is defined.
    remove_extreme_genes        = true      // Remove the genes whose CAAS count exceeds the far fence of their gene-length stratum (Extreme; any gene). Uses gene_filter_strata and gene_filter_k_far
    remove_dubious_genes        = true      // Remove the genes whose CAAS count exceeds the near fence of their stratum and that carry a cluster train (Dubious). Uses gene_filter_strata, gene_filter_k_near and the cluster parameters filter_minlen, filter_maxcaas, filter_min_positions
    remove_caas_clusters        = true      // Discard spatial CAAS clusters from filtered discovery, decoupled from gene filtering

    // ── Advanced parameters ──────────────────────────────────────────────────

    // Exploratory parameter sweep values
    minlen_values               = "2,3,4,10" // Parameter sweep values for exploratory mode
    maxcaas_values              = "0.6,0.7,0.8" // Parameter sweep values for exploratory mode

    // Gene-level outlier fences (used by remove_extreme_genes and remove_dubious_genes)
    gene_filter_strata          = 10        // Number of equal-size gene-length strata; a gene is compared with genes of its own length
    gene_filter_k_far           = 3.0       // IQR multiplier of the far fence (Q3 of the stratum + k x IQR); a gene above it is Extreme
    gene_filter_k_near          = 1.5       // IQR multiplier of the near fence; a gene above it is Dubious only when it also carries a cluster train

    // Gene-removal settings of the strict analysis (the null of the hypotheses without conserved pairs and the strict pass).
    // null: the setting of the normal run. Cluster parameters have no strict counterpart: they act inside the replay tiles,
    // which produce the normal and the strict tables together.
    strict_remove_extreme_genes = null  // Remove Extreme genes in the strict analysis; null takes remove_extreme_genes
    strict_remove_dubious_genes = null  // Remove Dubious genes in the strict analysis; null takes remove_dubious_genes
    strict_gene_filter_strata   = null  // Gene-length strata of the strict analysis; null takes gene_filter_strata
    strict_gene_filter_k_far    = null  // Far-fence IQR multiplier of the strict analysis; null takes gene_filter_k_far
    strict_gene_filter_k_near   = null  // Near-fence IQR multiplier of the strict analysis; null takes gene_filter_k_near

    // Report 8.1: characterization of the genes removed by the gene filter (needs no extra computation in the pipeline)
    removed_genes_report        = true  // Render report 8.1 (variability, Pfam, UCR, FUBAR and genomic windows of the Normal, Extreme, Dubious and Both genes)
    removed_genes_window_mb     = 100   // Genomic window size of report 8.1, in Mb
    gene_variability_file       = ""   // gene_variability.tsv of the PPGA run (per-gene Valdar summary); blank omits whole-gene variability
    position_variability_dir    = ""   // Directory of per-gene <gene>.prot.entropy.tsv tables (PROT_VAR_RAW of the PPGA run); blank omits per-column variability
    // Pfam, UCR and FUBAR tables of report 8.1 are domain_variability_file, ucr_positions_file and fubar_sites_file (conf/posenrich.config); each must declare coordinate_space CAAS_0based, and a blank one omits its section

    // Directional gene sets (downstream exports)

    // Standalone input overrides
    disambiguation_input        = "" // Standalone caas_convergence_master.csv override
    disambiguation_dir          = "" // Standalone disambiguation directory or .tar.gz archive
    background_input            = "" // Standalone background file(s) or directory override
}
