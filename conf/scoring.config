// scoring.config — SCORING: composite CAAS scores at position and gene level.
// PhyloPhere | conf/

// Integrates the outputs of CT_POSTPROC, FADE, RERConverge and CT_ACCUMULATION.

params {
    // ── Essential / common parameters ────────────────────────────────────────
    scoring_gene_top_pct                = 0.10       // Top fraction for candidate gene extraction (0.10 = top 10%)
    scoring_position_top_pct            = 0.10       // Top fraction for position extraction (0.10 = top 10%)
    auto_generate_ensembl               = false      // Generate gene_ensembl_file via BioMart if unset
    ensembl_dataset                     = ""         // Ensembl BioMart dataset (blank -> derived from ref_species_name)

    // ── Advanced parameters ──────────────────────────────────────────────────

    // Downstream characterization and active modules
    scoring_ami                         = true       // Enable AMI active module identification report
    scoring_string                      = true       // Enable STRING DB integration
    scoring_compare_fdr                 = 0.15       // FDR cutoff for cross-tool comparison report
    scoring_compare_top_n               = 20         // Top N genes to highlight in comparison report

    scoring_window_size_bp              = 1000000    // Genomic window size in bp for overlap reports

    // Evidence of the N best positions of position_scores.tsv (what each domain of each hypothesis saw: MRCA, tip species
    // and residues, domain scores); written after SCORING to scoring/evidence/. 0 = off. Needs the observed discovery.tab
    // (a run through the core, or discovery_from) and ct_disambig_asr_cache_dir.
    caas_evidence_top_n                  = 0

    // Standalone mode fallbacks (used when running SCORING independently)
    scoring_postproc_input              = ""         // filtered_discovery.tsv
    scoring_fade_summary_top            = ""         // fade_summary_top.tsv
    scoring_fade_summary_bottom         = ""         // fade_summary_bottom.tsv
    scoring_fade_site_top               = ""         // fade_site_bf_top.tsv
    scoring_fade_site_bottom            = ""         // fade_site_bf_bottom.tsv
    scoring_rer_input                   = ""         // rerconverge_summary_{trait}.tsv
    scoring_accum_dir                   = ""         // Directory with accumulation results
    scoring_background_input            = ""         // cleaned_background_main.txt
    scoring_hypotheses_pairs            = ""         // contrast_hypotheses_pairs.tsv (FOP per-pair PSS weights). Integrated runs take it from this run's contrast selection; a standalone --scoring run auto-discovers it in --outdir/data_exploration/2.CT/1.Traitfiles/. Set explicitly to override.

    // VEP precomputed fallbacks (shared with POSENRICH)
    scoring_vep_primateai               = ""         // primateai_scores.tsv
    scoring_vep_cosmic                  = ""         // cosmic_scores.tsv

    // CAAS permulation null inputs (for reusing prior nulls)
    caas_perms_file                     = ""         // CAAS permulation RDS for standalone SCORING
    caas_pos_cycle_caas_file            = ""         // perm_pos_cycle_caas.tsv.gz from a prior CAAS_CORE_MERGE (p.emp numerator/denominator)
    caas_perm_harvest_file              = ""         // permulation_harvest.tsv of the permulation harvest (draws, rejections, acceptance by PSS tolerance, capacity); feeds the "Null harvest" tab of the scoring report
    caas_perm_manifest_file             = ""         // permulation_manifest.tsv of the permulation harvest (design of the canonical pairs of each null cycle); feeds the design panel of the scoring report
    caas_pos_sample_file                = ""         // perm_pos_sample.tsv from a prior CAAS_CORE_MERGE
    caas_pos_quantiles_file             = ""         // perm_pos_quantiles.tsv from a prior CAAS_CORE_MERGE
    caas_pos_detail_file                = ""         // perm_pos_detail/ shard dir (or one perm_pos_detail.tsv.gz) from a prior CAAS_CORE_MERGE; input of the CT_ACCUMULATION permulation null
    caas_gene_cycle_scores_file         = ""         // gene_cycle_scores.tsv from a prior CAAS_CORE_MERGE; input of the CT_ACCUMULATION permulation null
}
