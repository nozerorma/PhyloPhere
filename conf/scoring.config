/*
 * SCORING module configuration
 *
 * Composite CAAS scoring at position-level and gene-level.
 * Integrates outputs from CT_POSTPROC, FADE, RERConverge,
 * and CT_ACCUMULATION into a unified scoring framework.
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    scoring_gene_top_pct                = scoring_gene_top_pct              ?: 0.10       // Top fraction for candidate gene extraction (0.10 = top 10%)
    scoring_position_top_pct            = scoring_position_top_pct          ?: 0.10       // Top fraction for position extraction (0.10 = top 10%)
    scoring_concordance_tau             = scoring_concordance_tau           ?: 0.8        // FOP POINT 3: harvest-wide derived_agreement threshold a grouping scheme must reach to enter convergence_schemes
    scoring_weight_caas                 = scoring_weight_caas               ?: 1.0        // Weight assigned to CAAS score component
    scoring_weight_rer                  = scoring_weight_rer                ?: 1.0        // Weight assigned to RERconverge component
    scoring_weight_fade                 = scoring_weight_fade               ?: 1.0        // Weight assigned to FADE component
    scoring_rer_direction               = scoring_rer_direction             ?: "both"     // RER direction filter: "accelerated" | "decelerated" | "both"

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================

    // Downstream characterization and active modules
    scoring_ami                         = scoring_ami                       ?: true       // Enable AMI active module identification report
    scoring_string                      = scoring_string                    ?: true       // Enable STRING DB integration
    scoring_compare_fdr                 = scoring_compare_fdr               ?: 0.1        // FDR cutoff for cross-tool comparison report
    scoring_compare_top_n               = scoring_compare_top_n             ?: 20         // Top N genes to highlight in comparison report

    // Robustness and stress testing
    scoring_stress                      = scoring_stress                    ?: true       // Enable scoring robustness/stress testing
    scoring_stress_top_n                = scoring_stress_top_n              ?: 25         // Top N genes for stress test evaluation
    scoring_stress_rank_metric          = scoring_stress_rank_metric        ?: "spearman" // Metric for rank correlation in stress test (spearman/pearson)
    scoring_window_size_bp              = scoring_window_size_bp            ?: 1000000    // Genomic window size in bp for overlap reports

    // Standalone mode fallbacks (used when running SCORING independently)
    scoring_postproc_input              = scoring_postproc_input            ?: ""         // filtered_discovery.tsv
    scoring_fade_summary_top            = scoring_fade_summary_top          ?: ""         // fade_summary_top.tsv
    scoring_fade_summary_bottom         = scoring_fade_summary_bottom       ?: ""         // fade_summary_bottom.tsv
    scoring_fade_site_top               = scoring_fade_site_top             ?: ""         // fade_site_bf_top.tsv
    scoring_fade_site_bottom            = scoring_fade_site_bottom          ?: ""         // fade_site_bf_bottom.tsv
    scoring_rer_input                   = scoring_rer_input                 ?: ""         // rerconverge_summary_{trait}.tsv
    scoring_accum_dir                   = scoring_accum_dir                 ?: ""         // Directory with accumulation results
    scoring_background_input            = scoring_background_input          ?: ""         // cleaned_background_main.txt

    // VEP precomputed fallbacks (shared with POSENRICH)
    scoring_vep_primateai               = scoring_vep_primateai             ?: ""         // primateai_scores.tsv
    scoring_vep_cosmic                  = scoring_vep_cosmic                ?: ""         // cosmic_scores.tsv

    // CAAS permulation null inputs (for reusing prior nulls)
    caas_perms_file                     = caas_perms_file                   ?: ""         // CAAS permulation RDS for standalone SCORING
    caas_pos_pval_file                  = caas_pos_pval_file                ?: ""         // perm_pos_pval.tsv from a prior CAAS_PERMULATION
    caas_pos_sample_file                = caas_pos_sample_file              ?: ""         // perm_pos_sample.tsv from a prior CAAS_PERMULATION
    caas_pos_quantiles_file             = caas_pos_quantiles_file           ?: ""         // perm_pos_quantiles.tsv from a prior CAAS_PERMULATION
    caas_pos_detail_file                = caas_pos_detail_file              ?: ""         // perm_pos_detail/ shard dir (or legacy perm_pos_detail.tsv.gz) from a prior CAAS_PERMULATION
}
