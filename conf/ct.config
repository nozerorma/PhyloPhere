/*
 * CAASTOOLS (CT) configuration
 */
params {
    // CT general option
    ct_tool                     = ct_tool                   ?: "discovery,resample,bootstrap" // Options: "discovery", "resample", "bootstrap", "all"
    publish_intermediates       = publish_intermediates     ?: false // Publish intermediate files (discovery, background, resample, bootstrap) for debugging
    ct_discovery_batch_size     = ct_discovery_batch_size   ?: 25 // Number of genes per DISCOVERY task; 1 keeps one-task-per-gene, >1 uses a staged manifest so Seqera task scripts stay small
    ct_bootstrap_batch_size     = ct_bootstrap_batch_size   ?: 10 // Number of genes per BOOTSTRAP task; 1 keeps one-task-per-gene, >1 uses a staged manifest so Seqera task scripts stay small
    // NOTE: intra-task concurrency (the batch "workers") is derived from task.cpus
    // (the process resource label), not a param — see conf/resources.config.

    // Common DISCOVERY and BOOTSTRAP options
    caas_config                 = caas_config               ?: "" // Path to CAASTOOLS configuration file
    patterns                    = patterns                  ?: "1,2,3" // CT patterns to search for, comma-separated

    // Check CAASTOOLS documentation for description of these parameters
    // Fraction-based thresholds: resolved to floor(n_pairs * fraction) at runtime.
    // 0.0 = none allowed, 1.0 = all pairs allowed (no filter).
    // min_divergent_fraction: fraction of pairs that must show amino acid divergence (no conservation).
    // 1.0 = all pairs must diverge; 0.67 = at least 2/3 must diverge.
    min_divergent_fraction      = min_divergent_fraction    ?: 0.5  // Minimum fraction of pairs required to show AA divergence (resolves to max_conserved = floor(n*(1-f)))
    max_bg_gaps_fraction        = max_bg_gaps_fraction      ?: 0.0  // Max fraction of pairs allowed to have background gaps
    max_fg_gaps_fraction        = max_fg_gaps_fraction      ?: 0.0  // Max fraction of pairs allowed to have foreground gaps
    max_gaps_fraction           = max_gaps_fraction         ?: 0.0  // Max fraction of pairs allowed to have any gaps
    max_bg_miss_fraction        = max_bg_miss_fraction      ?: 0.0  // Max fraction of pairs allowed to have background missing data
    max_fg_miss_fraction        = max_fg_miss_fraction      ?: 0.0  // Max fraction of pairs allowed to have foreground missing data
    max_miss_fraction           = max_miss_fraction         ?: 0.0  // Max fraction of pairs allowed to have any missing data
    miss_pair                   = miss_pair                 ?: true // Enforce missing pairs in paired mode (when fg/bg miss is the same)
    caap_mode                   = caap_mode                 ?: true // Whether to use CAAP mode (properties-based)

    // RESAMPLE options
    fgsize                      = fgsize                    ?: "6" // Foreground size (for strategy random)
    bgsize                      = bgsize                    ?: "6" // Background size (for strategy random)
    perm_strategy               = perm_strategy             ?: "BM" // Permutation strategy: "FGBG" | "BM"
    traitvalues                 = traitvalues               ?: "" // Path to trait values file (for strategy BM)
    perms_cycles                = perms_cycles              ?: "100" // Number of resampling cycles
    chunk_size                  = chunk_size                ?: "500" // Max number of resampled groups per output file
    include_b0                  = include_b0                ?: false // Whether to include the main hypothesis (b0) in the analysis

    // CAAS permulation-excess: N permuted labelings (a SUBSET of `perms_cycles`) run as a
    // full-pool bootstrap export → genes×N FCS null. Decoupled from `perms_cycles` (used
    // for significance) so the heavy full-pool pass stays small. See
    // docs/CAAS_PERMULATION_EXCESS.md and --caas_permulation_enrichment.
    caas_full_perms             = caas_full_perms           ?: 1000 // N full-pool permulations for the CAAS FCS null

    // BOOTSTRAP and SIGNIFICATION standalone inputs (resume from a prior stage's output)
    discovery_from              = discovery_from            ?: ""   // Discovery output dir from a previous CT DISCOVERY run. Required for BOOTSTRAP standalone.
    resample_from               = resample_from             ?: ""   // Resample output from a previous CT RESAMPLE run. Required for BOOTSTRAP standalone.
    bootstrap_from              = bootstrap_from            ?: ""   // Directory of .boot files from permutation tests. Required for SIGNIFICATION standalone.

    // Significance thresholds
    alpha_threshold            = alpha_threshold            ?: 0.05     // Alpha level for both hypergeometric and permutation tests

    //// Do not run these debug options unless needed and always check with a very small number of cycles ////
    export_groups              = export_groups              ?: false // Path to export groups file (DEBUG) -- null = disabled
    export_perm_discovery      = export_perm_discovery      ?: false // Path to export permuted discovery file (DEBUG) -- null = disabled
}
