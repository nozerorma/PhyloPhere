// ct.config — CAASTOOLS (CT): discovery, resampling and permulation null parameters.
// PhyloPhere | conf/
params {
    // ── Essential / common parameters ────────────────────────────────────────
    ct_tool                     = "discovery,resample" // CT stages to run, comma-separated. resample: harvests the permulated labelings (the null) from the tree and the trait; reads no alignments and can run alone. discovery: replays the real labeling (b_0) and the harvested labelings over the alignments in one pass of the permulation core (the discovery of the real labeling is its b_0 slice); it needs the labelings of resample, from this run or from --resample_from. Only the real labeling is replayed with --caas_full_perms 0
    
    // Discovery params
    patterns                    = "1,2,3" // CT patterns to search for, comma-separated
    min_divergent_fraction      = 0.5 // Minimum fraction of pairs required to show AA divergence (0.75 = 3/3 for K=3, 3/4 for K=4)
    caap_mode                   = true // Enable CAAP (amino acid properties-based) grouping mode
    multi_hypothesis            = true // Enable multi-hypothesis discovery across all generated non-replacement contrast hypotheses

    // Resample / perm-replay params
    chunk_size                  = "500" // Max number of resampled groups per output file
    resample_use_n              = true // Use sample size (n/c) count traits for Jeffreys CI filtering in permulations if available
    perm_strategy               = "auto" // Permutation strategy: "auto" (best-fit BM vs OU via AICc) | "OU" | "BM"
    caas_full_perms             = 1000 // Accepted permulations harvested (resample) and replayed (discovery) as the CAAS null, one setting for both steps; 0 replays only the real labeling (no null)
    max_tries                   = 1000000 // Maximum simulation attempts cap for pool harvesting
    perm_match_pss              = true // Build the canonical pairs of every permulation one by one so that their PSS follows the PSS of the observed canonical pairs (accepted only if each pair is within perm_match_pss_tol). Not applied to count traits (CI gate)
    perm_match_pss_tol          = 0.25 // Relative PSS tolerance of that matching: each pair must satisfy |log(PSS_null / PSS_obs)| <= log(1 + tol)
    max_fop                     = 100 // Max FOP alternative hypotheses (H1..Hn) per contrast, observed and null
    caas_perms_postproc         = true // Apply the observed CT_POSTPROC cluster and gene filters (filter_minlen/maxcaas, gene_filter_mode) to the per-cycle CAAS permulation null pool, so that caas_perms.rds follows the same filters as filtered_discovery.tsv. Set false to disable; needs gene_ensembl_file.

    // ── Advanced parameters ──────────────────────────────────────────────────



    // Missingness parameters in discovery mode and otherwise
    caas_config                 = "" // Path to CAAStools configuration file (auto-derived from contrast_selection.nf)
    max_bg_gaps_fraction        = 0.0  // Max fraction of pairs allowed to have background gaps
    max_fg_gaps_fraction        = 0.0  // Max fraction of pairs allowed to have foreground gaps
    max_gaps_fraction           = 0.0  // Max fraction of pairs allowed to have any gaps
    max_bg_miss_fraction        = 0.0  // Max fraction of pairs allowed to have background missing data
    max_fg_miss_fraction        = 0.0  // Max fraction of pairs allowed to have foreground missing data
    max_miss_fraction           = 0.0  // Max fraction of pairs allowed to have any missing data
    miss_pair                   = true // Enforce missing pairs in paired mode

    // Pipeline recovery
    discovery_from              = ""   // discovery.tab of a previous run: scored by CAAS_OBSERVED instead of replaying the observed labeling
    resample_from               = ""   // Resample output from a previous CT RESAMPLE run

    // Batching logic (performance)
    ct_core_batch_size          = 20 // Genes per CAAS_CORE_BATCHED task (perm-replay + ASR replay of the permulation null); 1 = one task per gene

    // Publishing norms (debug)
    publish_intermediates       = false // Publish intermediate files (discovery, background, resample) for debugging
}
