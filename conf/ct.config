/*
 * CAASTOOLS (CT) configuration
 */
params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    ct_tool                     = ct_tool                   ?: "discovery,resample,bootstrap" // CT stages to run (discovery,resample,bootstrap)
    patterns                    = patterns                  ?: "1,2,3" // CT patterns to search for, comma-separated
    min_divergent_fraction      = min_divergent_fraction    ?: 0.5  // Minimum fraction of pairs required to show AA divergence (0.5 = at least half)
    caap_mode                   = caap_mode                 ?: true // Enable CAAP (amino acid properties-based) grouping mode
    perm_strategy               = perm_strategy             ?: "BM" // Permutation strategy: "FGBG" (foreground/background) | "BM" (Brownian Motion) | "lambda" (Pagel's Lambda)
    perms_cycles                = perms_cycles              ?: "100" // Number of resampling cycles for significance testing
    caas_full_perms             = caas_full_perms           ?: 1000 // N full-pool permulations for the CAAS FCS null
    target_pairs                = target_pairs              ?: 0    // Target number of independent pairs for lean contrast filtering (0 = unconstrained)
    max_tries                   = max_tries                 ?: 1000000 // Maximum simulation attempts cap for pool harvesting
    fgsize                      = fgsize                    ?: "6" // Foreground size (for strategy random)
    bgsize                      = bgsize                    ?: "6" // Background size (for strategy random)
    traitvalues                 = traitvalues               ?: "" // Path to trait values file (for strategy BM)

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================
    publish_intermediates       = publish_intermediates     ?: false // Publish intermediate files (discovery, background, resample, bootstrap) for debugging
    ct_discovery_batch_size     = ct_discovery_batch_size   ?: 25 // Number of genes per DISCOVERY task
    ct_bootstrap_batch_size     = ct_bootstrap_batch_size   ?: 10 // Number of genes per BOOTSTRAP task
    caas_config                 = caas_config               ?: "" // Path to CAAStools configuration file
    max_bg_gaps_fraction        = max_bg_gaps_fraction      ?: 0.0  // Max fraction of pairs allowed to have background gaps
    max_fg_gaps_fraction        = max_fg_gaps_fraction      ?: 0.0  // Max fraction of pairs allowed to have foreground gaps
    max_gaps_fraction           = max_gaps_fraction         ?: 0.0  // Max fraction of pairs allowed to have any gaps
    max_bg_miss_fraction        = max_bg_miss_fraction      ?: 0.0  // Max fraction of pairs allowed to have background missing data
    max_fg_miss_fraction        = max_fg_miss_fraction      ?: 0.0  // Max fraction of pairs allowed to have foreground missing data
    max_miss_fraction           = max_miss_fraction         ?: 0.0  // Max fraction of pairs allowed to have any missing data
    miss_pair                   = miss_pair                 ?: true // Enforce missing pairs in paired mode
    chunk_size                  = chunk_size                ?: "500" // Max number of resampled groups per output file
    include_b0                  = include_b0                ?: false // Whether to include the main hypothesis (b0) in the analysis
    discovery_from              = discovery_from            ?: ""   // Discovery output dir from a previous CT DISCOVERY run
    resample_from               = resample_from             ?: ""   // Resample output from a previous CT RESAMPLE run
    bootstrap_from              = bootstrap_from            ?: ""   // Directory of .boot files from permutation tests
    alpha_threshold            = alpha_threshold            ?: 0.05     // Alpha level for hypergeometric and permutation tests
    export_groups              = export_groups              ?: false // Path to export groups file (DEBUG)
    export_perm_discovery      = export_perm_discovery      ?: false // Path to export permuted discovery file (DEBUG)
}
