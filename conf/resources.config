
/*
 * Resource configuration: defaults + process label requirements
 */

params {
    // Defaults used when no profile overrides are active
    max_memory = 64.GB
    max_cpus   = 64
    max_time   = 5.day
}

process {
    // ── Generic labels ─────────────────────────────────────────────────────
    withLabel:process_low {
        cpus   = { 1 }
        memory = { 500.MB }
        time   = { 2.h }
    }
    withLabel:process_medium {
        cpus   = { 2 }
        memory = { 4.GB }
        time   = { 4.h }
    }
    withLabel:process_long_compute {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel:process_reporting {
        cpus          = { 8 }
        memory        = { 6.GB * task.attempt }
        time          = { 4.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withLabel:process_reporting_phenotype {
        cpus   = { 10 }
        memory = { 6.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel:process_reporting_dataset {
        cpus   = { 4 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    // DATASET_PRUNE renders a large Rmarkdown and can exceed generic
    // process_reporting_dataset defaults on first attempt.
    withName: 'DATASET_PRUNE' {
        cpus          = { 4 }
        memory        = { 16.GB * task.attempt }
        time          = { 4.h   * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withLabel:process_contrast_selection {
        cpus   = { 8 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // ── Trait Exploration ───────────────────────────────────────────────────
    withName: 'PHENOTYPE_EXPLORATION' {
        cpus   = { 10 }
        memory = { 6.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'DATASET_EXPLORATION' {
        cpus   = { 4 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CONTRAST_ALGORITHM' {
        cpus   = { 8 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'CI_COMPOSITION_REPORT' {
        cpus   = { 8 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'DERIVE_ALI_SP_NAMES' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'TREE_CLEANUP' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ── CT Batched Discovery and Perm-Replay ────────────────────────────────
    // These labels are submitted in the hundreds per run (one SLURM job per batch) --
    // by far the biggest share of this pipeline's concurrent CPU footprint, and so the
    // ones most exposed to the lab QOS's 100-cpu cluster-wide cap (see nextflow.config's
    // executor.$slurm comment). Diagnosed 2026-08-01: SLURM was rejecting a fraction of
    // these submissions with QOSMaxCpuPerUserLimit (exit 53, job never starts) even
    // after the queueSize fix, since the cap is shared with everything else the lab is
    // running at that moment -- retry on 53 (alongside the existing OOM/kill codes) so a
    // rejected batch is resubmitted once QOS pressure eases, instead of the whole run
    // needing a manual kill + restart.
    withLabel:process_discovery {
        cpus   = { 1 }
        memory = { 2.GB }
        time   = { 1.h * task.attempt }
        maxForks   = 8 // Number of parallel jobs to run. Should be total assigned cores % cores per job
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withLabel:process_resample {
        cpus   = { 12 }
        memory = { 4.GB }
        time   = { 4.h * task.attempt }
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withLabel:process_perm_replay {
        cpus   = { 1 }
        memory = { 16.GB }
        time   = { 72.h * task.attempt }
        maxForks   = 8
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withName: 'DISCOVERY_BATCHED' {
        cpus   = { 4 }
        memory = { 2.GB * task.attempt }
        time   = { 3.h * task.attempt }
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withLabel:process_discovery_batched {
        cpus   = { 4 }
        memory = { 2.GB * task.attempt }
        time   = { 3.h * task.attempt }
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }

    withLabel:process_perm_replay_batched {
        // cpus halved 8->4 (2026-09-14): FOP multi-hypothesis mode fans each
        // resample cycle out to caas_full_perms x max_fop labelings (up to ~5e4,
        // vs ~1e3 pre-FOP), so each of the `cpus` concurrent `ct perm-replay`
        // workers now holds a much bigger F/Bg/chunk-buffer footprint. Halving
        // worker count doubles the per-worker share of `memory` at the same
        // total allocation, trading wall time (still well inside the 128h/attempt
        // budget) for OOM headroom instead of just raising `memory` further.
        cpus   = { 4 }
        memory = { 16.GB * task.attempt }
        time   = { 128.h * task.attempt }
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }

    // ── CT Concat ──────────────────────────────────────────────────────────
    withName: 'CONCAT_DISCOVERY' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'CONCAT_BACKGROUND' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'CONCAT_RESAMPLE' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    // RESAMPLE runs permulations.R: the pool harvest (target-aware, scales with
    // caas_full_perms) PLUS the serial FOP-mirror hypothesis harvest. Now that
    // the harvest target is caas_full_perms (default 1000, no separate larger
    // pool — see conf/ct.config) this falls inside the shared process_resample
    // label's ~1e3-1e4 sizing, so no override is needed here. If a run with
    // caas_full_perms pushed well past 1e4 (or caas_perms_fop with a large
    // max_fop) overruns process_resample's 4h/4GB, the FOP mirror loop needs
    // streaming writes + parallelism (see permulations.R "FOP mirror" section)
    // rather than reintroducing a bigger box here.
    withName: 'CHECK_MIN_CONTRASTS' {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // ── CT Post-Processing ────────────────────────────────────────────────
    withName: 'CT_FILTER' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel:CT_FILTER {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CAAS_FILTER_GENES' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CAAS_BACKGROUND_CLEANUP' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CT_FILTER_SUMMARY' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }
    withName: 'CT_POSTPROC_REPORT' {
        cpus   = { 12 }
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // ── CT Meta-CAAS ─────────────────────────────────────────────────────
    withName: 'CAAS_META_CAAS_REPORT' {
        cpus   = { 12 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Phase 4 — CT_DISAMBIGUATION_RUN gene-batch chunking (observed disambiguation)
    // See subworkflows/CT_DISAMBIGUATION/ct_disambiguation.nf. Chunked by
    // params.ct_disambig_batch_size (default 1 = unbatched, uses only
    // CT_DISAMBIGUATION_RUN below, distinct from Phase 3's
    // ct_disambig_perms_batch_size two sections down -- same "genes per
    // batch" shape, different pipeline stage). Batches are recombined by
    // CT_DISAMBIGUATION_MERGE (row-concat/directory-union, no cross-gene
    // aggregation needed -- see merge_disambiguation_batches.py's module
    // docstring) and replotted once by CT_DISAMBIGUATION_PLOTS.
    // ═══════════════════════════════════════════════════════════════════════
    // Unbatched (ct_disambig_batch_size=1): sized for the FULL ~16k-gene
    // metadata table + worker pool resident at once (increased memory for
    // large metadata; scales on retry).
    withName: 'CT_DISAMBIGUATION_RUN' {
        cpus   = { 12 }
        memory = { 8.GB * task.attempt }
        time   = { 16.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // One-shot pandas split of global_meta_caas.tsv into N gene-subset files;
    // I/O + a single full-table read, not compute-heavy.
    withName: 'CT_DISAMBIGUATION_SPLIT_GENES' {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
    // Per-batch share of the same disambiguation run: sized down from the
    // monolithic task above since each batch only holds
    // ct_disambig_batch_size genes' worth of metadata, not the full run --
    // NOT YET PROFILED on a real cluster run (see project memory); revisit
    // once a real batch's peak RSS/wall time is known.
    withName: 'CT_DISAMBIGUATION_RUN_BATCHED' {
        cpus   = { 4 }
        memory = { 3.GB * task.attempt }
        time   = { 2.h  * task.attempt }
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    // Row-concat/directory-union merge of N batches' outputs -- I/O bound,
    // not compute-heavy (see CAAS_PERMS_MERGE_DETAIL's analogous Phase 3
    // entry below).
    withName: 'CT_DISAMBIGUATION_MERGE' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    // Re-runs generate_bulk_plots() once against the merged master CSV --
    // roughly the plotting-only share of CT_DISAMBIGUATION_RUN's own
    // footprint above, without the per-gene ASR/codeml compute.
    withName: 'CT_DISAMBIGUATION_PLOTS' {
        cpus   = { 8 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Phase 3 — CAAS_PERMS_DISAMBIGUATE gene-batch chunking (permulation-null
    // ASR replay). See subworkflows/CT/caas_permulation.nf. Chunked by
    // params.ct_disambig_perms_batch_size (default 1 = unbatched, distinct
    // from Phase 4's ct_disambig_batch_size above). gene_cycle_scores.tsv/
    // perm_pos_sample.tsv/perm_pos_quantiles.tsv depend on a genome-wide
    // percent_rank histogram, so batches only ever emit perm_pos_detail/
    // shards; CAAS_PERMS_REBUILD (own withName override below, near
    // CAAS_PERMS_AGGREGATE) re-derives the rest once, with
    // no ASR replay needed.
    // ═══════════════════════════════════════════════════════════════════════
    withName: 'CAAS_PERMS_DISAMBIGUATE' {
        cpus   = { 16 }
        memory = { 16.GB * task.attempt }
        time   = { 24.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // Per-batch share of the same ASR replay: sized down from the monolithic
    // task above since each batch only replays a gene subset (ct_disambig_perms_batch_size).
    //
    // cpus dropped 8 -> 4 (2026-09-17, docs/CT_DISAMBIGUATION_REPLAY_PERFORMANCE.md "ground-up
    // rework"): each batch reserves `cpus` from the lab's shared 100-cpu SLURM QOS regardless of
    // how much it actually uses, and with two phenotypes run concurrently (the common case here,
    // not a one-off -- see nextflow.config's executor comment) the old cpus=8 x
    // slurm_queue_size=12 x 2 concurrent instances demanded ~192 cpus against a 100-cpu ceiling.
    // Measured live via `sacct`: jobs submitted within the same ~20s burst saw queue wait grow
    // from ~1s to 9m28s purely as a function of submission order, while actual run time (once
    // started) stayed flat at a few minutes -- the QOS cap, not per-task compute, was gating
    // throughput. `--workers` (the in-task mp.Pool size) is `task.cpus` (caas_permulation.nf), so
    // this halves intra-batch parallelism too -- a deliberate, moderate tradeoff (not a straight
    // cut to 1-2) to keep meaningful per-batch speed while doubling safe concurrent-batch count.
    // 2 instances x slurm_queue_size(12) x cpus(4) = 96, back under 100 with the same margin the
    // original (single-instance) tuning reasoned about -- no slurm_queue_size change needed, since
    // it already happened to match the 2-concurrent-phenotype case once cpus is halved.
    withName: 'CAAS_PERMS_DISAMBIGUATE_BATCHED' {
        // Base memory sized for batches containing genes with heavy
        // FOP-hypothesis fanout: such a gene's replay splits into many chunks
        // (gene_wrapper.py's _perms_worker_replay, "ctx load"), and the
        // per-chunk ASR-context reload cost degrades sharply under memory
        // pressure. 20GB keeps that reload cheap even for the heaviest
        // batches. The high-cpu partition's 256cpu/1.43TB-RAM nodes make this
        // a non-issue for the cluster's memory budget (cpus are the actual
        // shared-QOS constraint, see comment above).
        cpus   = { 4 }
        memory = { 20.GB * task.attempt }
        time   = { 8.h  * task.attempt }
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withName: 'CAAS_PERMS_MERGE_DETAIL' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CAAS_PERMS_AGGREGATE' {
        cpus   = { 1 }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // gene_cycle_scores.tsv is genome-wide x n_cycles; scoring_caas_perms.R
    // reads it via readr then does 6 sequential select()+pivot_wider() passes
    // over the full table (one per global/top/bottom x asr/caas column), so
    // this needs real headroom rather than process_medium's default.
    withName: 'CAAS_PERMS_REBUILD' {
        cpus          = { 2 }
        memory        = { 24.GB * task.attempt }
        time          = { 6.h   * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

    // ── ASR Robustness Diagnostics ──────────────────────────────────────────
    withName: 'EXTRACT_DISAMBIG_DIR' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'ASR_ROBUSTNESS_REPORT' {
        cpus   = { 8 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // ── CT Accumulation ───────────────────────────────────────────────────
    withName: 'CT_ACCUMULATION_AGGREGATE' {
        cpus   = { 16 }
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withName: 'CT_ACCUMULATION_RANDOMIZE' {
        cpus   = { 12 }
        memory = { 24.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withName: 'ACCUMULATION_REPORT' {
        cpus   = { 8 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'ACCUMULATION_GENE_LISTS' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // SELECTION
    // ── Selection Utils ─────────────────────────────────────────────────────
    withName: 'EXTRACT_EXTREME_SPECIES' {
        cpus   = { 1 }
        memory = { 1.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'FILTER_FASTA_TO_TREE' {
        cpus   = { 1 }
        memory = { 1.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    // ── Shared alignment prep (SELECTION_PREP) ────────────────────────────
    withName: 'PREP_ALIGNMENTS' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 30.m  * task.attempt }
    }
    withName: 'PREP_ALIGNMENTS_BATCHED' {
        cpus   = { 10 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    // ── FADE ──────────────────────────────────────────────────────────────
    withName: 'PHYLIP_TO_FASTA' {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
    withName: 'ANNOTATE_TREE_FG' {
        cpus   = { 8 }
        memory = { 4.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
    withName: 'ANNOTATE_TREE_FG_BATCHED' {
        cpus          = { 8 }
        memory        = { 8.GB * task.attempt }
        time          = { 1.h  * task.attempt }
        errorStrategy = { task.exitStatus in [140, 137, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withName: 'FADE_BATCHED' {
        // CPUs (set here) == internal workers (--workers ${task.cpus}); cpuPerWorker = 1.
        // Each HyPhy call gets --cpu 1 and OMP/BLAS thread vars = 1, so N workers
        // use exactly N CPUs — matching the SLURM allocation and stopping node saturation.
        // Increase cpus here (the researcher knob) for more intra-task parallelism.
        cpus   = { 8 }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'COLLECT_GENE_SETS' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
    withName: 'FADE_RUN' {
        cpus   = { 12 }
        memory = { 16.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withName: 'FADE_REPORT' {
        cpus   = { 12 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'FADE_GENE_LISTS' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ── VEP characterization ────────────────────────────────────────────────
    withLabel: 'process_vep' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'PRIMATEAI_MAP' {
        // Streams the full PrimateAI-3D database (~2 GB gz); needs enough memory
        // to hold the in-memory position lookup table.
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withName: 'COSMIC_MAP' {
        // Streams the full COSMIC database.
        // to hold the in-memory position lookup table.
        cpus   = { 2 }
        memory = { 8.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    // ── RERconverge ─────────────────────────────────────────────────────────
    withName: 'RER_TRAIT' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    // RER_TREES reads all gene trees into R at once; needs significantly more
    // memory than the generic process_reporting label provides (8 GB × attempt).
    withName: 'RER_TREES' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // RER_MATRIX loads the same gene-tree forest as RER_TREES and then calls
    // getAllResiduals() — needs at least as much memory as RER_TREES.
    withName: 'RER_MATRIX' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // RER analysis as such loads the same gene-tree forest as RER_TREES and then calls
    // getAllResiduals() — needs at least as much memory as RER_TREES.
    withName: 'RER_CONT' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: 'RER_BIN' {
        cpus   = { 4 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'RER_REPORT' {
        cpus   = { 8 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'RER_GENE_LISTS' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ── SCORING (core, unbatched) ────────────────────────────────
    withName: 'SCORING_COMPUTE' {
        cpus   = { 8 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'SCORING_REPORT' {
        cpus   = { 8 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'SCORING_COMPARE_REPORT' {
        cpus   = { 12 }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }

    }
    // ── AMI (DOMINO active modules) ───────────
    withName: 'SCORING_AMI_REPORT' {
        cpus   = { 12 }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Phase 2 — FCS enrichment stats chunking by GMT database.
    // See subworkflows/ENRICHMENT/fcs.nf. fcs_run_all()/p.adjust("BH") already
    // runs per-db, so chunking the GMT loop across N Nextflow tasks (param:
    // fcs_batch_size) changes nothing statistically.
    // ═══════════════════════════════════════════════════════════════════════
    withName: 'SCORING_FCS_REPORT' {
        cpus          = { 12 }
        memory        = { 16.GB * task.attempt }
        time          = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'RER_FCS_REPORT' {
        cpus          = { 8 }
        memory        = { 32.GB * task.attempt }
        time          = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [3, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // One batch holds fcs_batch_size (default 4) of the 17 curated GMTs rather
    // than all of them, so this should sit well below SCORING_FCS_REPORT/
    // RER_FCS_REPORT's monolithic footprint (16-32 GB) -- sized conservatively
    // here (not yet profiled on a real cluster run) since the RERconverge null-
    // permulation matrices (fcs_run_permulation/fcs_null_enrichstat_vectorized)
    // scale with n_perms x genes x gene-sets-in-this-batch, not just GMT count.
    withLabel:process_fcs_batched {
        cpus          = { 8 }
        memory        = { 8.GB * task.attempt }
        time          = { 4.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

    // ═══════════════════════════════════════════════════════════════════════
    // Phase 1 — POSENRICH_RUN chunking by GMT/db source.
    // See subworkflows/ENRICHMENT/posenrich.nf. run_permulation_for_terms()
    // already scopes BH correction per (direction, db) group, so chunking the
    // sources loop across N Nextflow tasks (param: posenrich_batch_size)
    // changes nothing statistically. POSENRICH_BUILD_GMT (the COSMIC/PAI3D
    // genomic scan below) is deliberately NOT chunked -- a genuinely global
    // single pass over multi-GB gzip files that chunking by gene would only
    // multiply I/O for, with no memory benefit beyond what the OOM-retry
    // config below already gives.
    // ═══════════════════════════════════════════════════════════════════════
    // BUILD_GMT holds a genome-wide (chrom, nt_pos) -> {(gene, col)} lookup in
    // memory for the whole background gene universe (build_genomic_to_pos),
    // which can exceed 16GB on a large universe; the `* task.attempt` scaling
    // is only effective with an explicit retry-on-OOM errorStrategy below.
    withName: 'POSENRICH_BUILD_GMT' {
        cpus          = { 8 }
        memory        = { 16.GB * task.attempt }
        time          = { 2.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'POSENRICH_RUN' {
        cpus          = { 8 }
        memory        = { 16.GB * task.attempt }
        time          = { 8.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // One batch holds only a handful of GMTs' worth of terms (plus, for the one
    // batch that carries it, the characterization layer) rather than all 17, so
    // this is sized well below POSENRICH_RUN's monolithic footprint.
    withLabel:process_posenrich_batched {
        cpus          = { 4 }
        memory        = { 4.GB * task.attempt }
        time          = { 4.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
}
