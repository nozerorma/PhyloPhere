// resources.config — Default limits and the resource request of each process label and process.
// PhyloPhere | conf/

params {
    // Defaults used when no profile overrides are active
    max_memory = 64.GB
    max_cpus   = 64
    max_time   = 5.day
}

process {
    // ── Generic labels ───────────────────────────────────────────────────────
    withLabel:process_low {
        cpus   = { 1 }
        memory = { 500.MB }
        time   = { 2.h }
    }
    // POSITION_REGISTRY (posenrich_registry.py) is single-threaded and ran about 37 min on the
    // malignant prevalence run (6.4 M positions). Its own label keeps the 2 h process_low cap from
    // applying. Memory stays in the withName block for POSITION_REGISTRY below.
    withLabel:process_registry {
        cpus   = { 1 }
        time   = { 4.h * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 2 }
        memory = { 4.GB }
        time   = { 4.h }
    }
    withLabel:process_long_compute {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withLabel:process_reporting {
        cpus          = { 8 }
        memory        = { 6.GB * task.attempt }
        time          = { 4.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withLabel:process_reporting_phenotype {
        cpus   = { 10 }
        memory = { 6.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel:process_reporting_dataset {
        cpus   = { 4 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    // DATASET_PRUNE renders a large Rmarkdown and can exceed generic
    // process_reporting_dataset defaults on first attempt.
    withName: 'DATASET_PRUNE' {
        cpus          = { 4 }
        memory        = { 16.GB * task.attempt }
        time          = { 4.h   * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withLabel:process_contrast_selection {
        cpus   = { 8 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // ── Trait Exploration ────────────────────────────────────────────────────
    withName: 'PHENOTYPE_EXPLORATION' {
        cpus   = { 2 }
        memory = { 6.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'DATASET_EXPLORATION' {
        cpus   = { 4 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CONTRAST_ALGORITHM' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'CI_COMPOSITION_REPORT' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'DERIVE_ALI_SP_NAMES' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withName: 'TREE_CLEANUP' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ── CT permulation batches ───────────────────────────────────────────────
    // These labels are submitted in the hundreds per run (one SLURM job per batch), the largest share of the
    // concurrent CPU footprint of the pipeline and so the most exposed to the 100-cpu cluster-wide QOS cap of the
    // lab account (see the executor.$slurm block of nextflow.config). The cap is shared with everything else the
    // lab runs, so SLURM can reject a submission with QOSMaxCpuPerUserLimit (exit 53, the job never starts).
    // Exit 53 is therefore retried together with the OOM and kill codes: a rejected batch is resubmitted when the
    // QOS pressure eases, without a manual restart of the run.
    withLabel:process_discovery {
        cpus   = { 1 }
        memory = { 2.GB }
        time   = { 1.h * task.attempt }
        maxForks   = 8 // Number of parallel jobs to run. Should be total assigned cores % cores per job
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withLabel:process_resample {
        cpus   = { 12 }
        memory = { 4.GB }
        time   = { 4.h * task.attempt }
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }


    // ── CT Concat ────────────────────────────────────────────────────────────
    withName: 'CONCAT_RESAMPLE' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    // RESAMPLE runs permulations.R: the pool harvest (target-aware, scales with caas_full_perms) and the serial
    // FOP-mirror hypothesis harvest. It peaked at 3.0-3.5 GB with 12 hypotheses x 1000 cycles, 75-88% of the 4 GB
    // of the process_resample label, which has no `* task.attempt`, so a retry would repeat the same request. Memory
    // grows with hypotheses x cycles and was not measured beyond that design, hence the large scaled request.
    // Beyond about 1e4 caas_full_perms, or multi_hypothesis with a large max_fop, the FOP mirror loop would need
    // streaming writes and parallelism (see the "FOP mirror" section of permulations.R) rather than more memory.
    withName: 'RESAMPLE' {
        cpus   = { 12 }
        memory = { 24.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'CHECK_MIN_CONTRASTS' {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // ── CT Post-Processing ───────────────────────────────────────────────────
    withName: 'CT_FILTER' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withLabel:CT_FILTER {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CAAS_FILTER_GENES' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CAAS_BACKGROUND_CLEANUP' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CT_FILTER_SUMMARY' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }
    withName: 'CT_POSTPROC_REPORT' {
        cpus   = { 2 }
        memory = { 6.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // ── CT Meta-CAAS ─────────────────────────────────────────────────────────
    // Both reports read the observed discovery table, which reaches hundreds of MB (337 MB in the cancer runs); the
    // pattern report exceeded 4 GB on it. R reports a killed pandoc as exit status 1, so a retry never triggers and the
    // first request has to hold the table.
    withName: 'CAAS_META_CAAS_REPORT' {
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    withName: 'CAAS_SIGNIFICANCE_REPORT' {
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
    }

    // ── Observed labeling ────────────────────────────────────────────────────
    // In a run through the core, the observed labeling is the b_0 slice of CAAS_CORE_BATCHED (sized below) and
    // CAAS_CORE_OBSERVED writes its files; CAAS_OBSERVED scores a discovery.tab that already exists.
    // CAAS_OBSERVED scores every gene of a discovery.tab with a worker pool: the full per-gene ASR records and the
    // worker pool are resident at once, so memory scales on retry. The requests are not measured.
    withName: 'CAAS_OBSERVED' {
        cpus   = { 12 }
        memory = { 8.GB * task.attempt }
        time   = { 16.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // Explains the N best positions after SCORING (N is small, for example 10): one worker per gene, the full ASR
    // record of each resident at once, ASR read from the cache. Measured with N = 10: toy data set (12 hypotheses,
    // 4 workers) 4 s wall, 0.72 GB (sacct MaxRSS of the batch step); PEPC (100 hypotheses, 1 worker) 1.9 s, 0.16 GB.
    // The requests are far above that on purpose: long genes were not measured, and the retries scale them.
    withName: 'CAAS_EVIDENCE' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // Reads the b_0 slices of all the batches, sorts the discovery rows by gene and streams the meta tables;
    // the rows of the whole discovery table (4.4 million at the largest scale seen) are held in memory
    // once. Not measured; memory scales on retry.
    withName: 'CAAS_CORE_OBSERVED|CAAS_CORE_OBSERVED_STRICT' {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // One task per gene batch: the perm-replay kernel, then the ASR replay of the same genes. The two steps
    // run in sequence, so the request covers the larger of them: the replay peaked at 6.9 GB and the ASR
    // replay at 2.7 GB (Slurm MaxRSS of the batch step; 12 hypotheses x 1000 cycles, 20 genes per batch).
    // At full scale (11.8k genes, batches of 20) the replay has a heavy tail: six of 804 batches took 42
    // to 179 min at 8 cpus, averaging 5.5 busy cores, which is why the time limit is long; the effect of
    // 4 cpus on that tail has not been measured.
    withName: 'CAAS_CORE_BATCHED' {
        cpus   = { 4 }
        memory = { 20.GB * task.attempt }
        time   = { 12.h  * task.attempt }
        errorStrategy = { task.exitStatus in [53, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    // One merge per block of cycles (merge_null_block.py): the tile tables of all the gene batches of the block, in memory
    // together, with gene removal, the pools of the cycle and the gene statistics. Measured on synthetic tiles with the
    // densities of the 1000-cycle cancer null (11.8k genes, 500 cycles per block, 4.5 M units, 11.2 M scored entries): 43 s
    // and 2.9 GB peak, so the request leaves about 2x headroom; it follows the block, not the number of cycles of the run.
    withName: 'CAAS_CORE_MERGE|CAAS_CORE_MERGE_STRICT' {
        cpus          = { 2 }
        memory        = { 6.GB * task.attempt }
        time          = { 1.h   * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // Reduction retains positional counters and validates one matrix block at a time.
    // Explicit caas_export_single additionally allocates global matrices and needs more memory.
    withName: 'CAAS_CORE_MERGE_REDUCE|CAAS_CORE_MERGE_REDUCE_STRICT' {
        cpus          = { 2 }
        memory        = { (params.caas_export_single ? 12.GB : 6.GB) * (task.attempt * task.attempt) }
        time          = { 1.h   * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // Counters of the position-level null (null_position_stats.py): the universe holds the positions the null scores, a
    // count holds one block's scored positions.
    withName: 'CAAS_NULL_UNIVERSE|CAAS_NULL_COUNT|CAAS_NULL_COUNTERS' {
        cpus          = { 1 }
        memory        = { 8.GB * task.attempt }
        time          = { 2.h   * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // The strict tables are published under <outdir>/strict/ (the publishDir of the two processes reads ext.publish_prefix)
    withName: 'CAAS_CORE_OBSERVED_STRICT|CAAS_CORE_MERGE_STRICT|CAAS_CORE_MERGE_REDUCE_STRICT' {
        ext.publish_prefix = '/strict'
    }

    // ── ASR Diagnostics ───────────────────────────────────────────
    withName: 'EXTRACT_DISAMBIG_DIR' {
        cpus   = { 2 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'ASR_DIAGNOSTICS_REPORT' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // ── POSENRICH level 1: Accumulation ──────────────────────────────────────────────────────
    withName: 'ACCUMULATION_TEST' {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    // ── Selection utils (SELECTION) ──────────────────────────────────────────
    withName: 'EXTRACT_EXTREME_SPECIES' {
        cpus   = { 1 }
        memory = { 1.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'FILTER_FASTA_TO_TREE' {
        cpus   = { 1 }
        memory = { 1.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    // ── Shared alignment prep (SELECTION_PREP) ───────────────────────────────
    withName: 'PREP_ALIGNMENTS' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 30.m  * task.attempt }
    }
    withName: 'PREP_ALIGNMENTS_BATCHED' {
        cpus   = { 10 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    // ── FADE ─────────────────────────────────────────────────────────────────
    withName: 'PHYLIP_TO_FASTA' {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
    withName: 'ANNOTATE_TREE_FG' {
        cpus   = { 8 }
        memory = { 4.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
    withName: 'ANNOTATE_TREE_FG_BATCHED' {
        cpus          = { 8 }
        memory        = { 8.GB * task.attempt }
        time          = { 1.h  * task.attempt }
        errorStrategy = { task.exitStatus in [140, 137, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 3
    }
    withName: 'FADE_BATCHED' {
        // CPUs (set here) == internal workers (--workers ${task.cpus}); cpuPerWorker = 1.
        // Each HyPhy call gets --cpu 1 and OMP/BLAS thread variables = 1, so N workers
        // use exactly N CPUs, matching the SLURM allocation and avoiding node saturation.
        // Raise cpus here for more intra-task parallelism.
        cpus   = { 8 }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'COLLECT_GENE_SETS' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 30.m * task.attempt }
    }
    withName: 'FADE_RUN' {
        cpus   = { 12 }
        memory = { 16.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    // The merge reads the small tables of the FADE tasks; the report reads the two merged tables of a direction.
    withName: 'FADE_TABLES' {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withName: 'FADE_REPORT' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'FADE_GENE_LISTS' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ── VEP characterization ─────────────────────────────────────────────────
    withLabel: 'process_vep' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'PRIMATEAI_MAP' {
        // Streams the full PrimateAI-3D database (~2 GB gz); needs enough memory
        // to hold the in-memory position lookup table.
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withName: 'COSMIC_MAP' {
        // Streams the full COSMIC database; the memory holds the in-memory position lookup table.
        cpus   = { 2 }
        memory = { 8.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withName: 'ENSEMBL_VEP_ANNOTATE' {
        // The first use per species and assembly populates a multi-GB offline VEP cache with
        // vep_install (download and local indexing) before annotating; the 4 h of process_medium
        // is too tight for that one-time cost. The cache is persistent (see ensembl_vep.nf), so
        // later runs against the same cache only annotate.
        cpus   = { 2 }
        memory = { 4.GB  * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    // ── RERconverge ──────────────────────────────────────────────────────────
    withName: 'RER_TRAIT' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    // RER_TREES reads all gene trees into R at once; it needs far more memory than the
    // generic process_reporting label provides (6 GB x attempt).
    withName: 'RER_TREES' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // RER_MATRIX loads the same gene-tree forest as RER_TREES and then calls
    // getAllResiduals(), so it needs at least as much memory as RER_TREES.
    withName: 'RER_MATRIX' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    // RER_CONT retains the gene-tree forest, simulates one null batch and writes
    // corStat blocks. Gene p calibration retains all cycles of at most 1000 genes.
    // The forest remains a separate memory cost; the request awaits real profiling.
    withName: 'RER_CONT' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: 'RER_BIN' {
        cpus   = { 4 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'RER_REPORT' {
        cpus   = { 8 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'RER_GENE_LISTS' {
        cpus   = { 1 }
        memory = { 500.MB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // ── SCORING (core, unbatched) ────────────────────────────────────────────
    // The peak memory of SCORING_COMPUTE is not measured. A full-genome run of an earlier, R-side scoring peaked at
    // 22.5 GB by Slurm's MaxRSS (23.5 GB by the trace), and attempts at 8 and 16 GB were killed; the request keeps
    // a wide margin above that figure and scales on retry.
    withName: 'SCORING_COMPUTE' {
        cpus   = { 2 }
        memory = { 32.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'SCORING_REPORT' {
        cpus   = { 2 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'SCORING_COMPARE_REPORT' {
        cpus   = { 12 }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }

    }
    // ── AMI (DOMINO active modules) ──────────────────────────────────────────
    withName: 'SCORING_AMI_REPORT' {
        cpus   = { 12 }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    // ── FCS enrichment ───────────────────────────────────────────────────────
    // Chunked by GMT database (subworkflows/ENRICHMENT/fcs.nf). fcs_run_all() applies the BH adjustment per
    // database, so splitting the GMT loop over fcs_batch_size-sized tasks does not change the adjusted p-values.
    withName: 'SCORING_FCS_REPORT' {
        cpus          = { 12 }
        memory        = { 16.GB * task.attempt }
        time          = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'RER_FCS_REPORT' {
        cpus          = { 8 }
        memory        = { 32.GB * task.attempt }
        time          = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [3, 137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    // Pathway null tasks hold genes x cycles-per-block and one GMT batch. GENE_P
    // instead holds fcs_block_batch_genes x ALL cycles, with calibration copies.
    // The shared request is conservative; real 10k profiling remains pending.
    // Compatibility import of a single RDS also loads the whole legacy null.
    withLabel:process_fcs_batched {
        cpus          = { 8 }
        memory        = { 8.GB * task.attempt }
        time          = { 4.h  * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143, Integer.MAX_VALUE] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }

    // ── Report and plotting processes: implicit thread pools ─────────────────
    // These render Rmarkdown or matplotlib figures on 2 cpus. No script reads
    // REPORT_CORES; the implicit pools are readr/vroom (whose default is the
    // NODE's core count, not the allocation's), data.table and OpenBLAS/OpenMP.
    // They are pinned to the task's cpus so a 2-cpu task does not run hundreds
    // of threads on 2 cores.
    withName: 'FADE_REPORT|ASR_DIAGNOSTICS_REPORT|CT_POSTPROC_REPORT|SCORING_REPORT|CAAS_META_CAAS_REPORT|CAAS_SIGNIFICANCE_REPORT|PHENOTYPE_EXPLORATION|CONTRAST_ALGORITHM|CI_COMPOSITION_REPORT|SCORING_COMPUTE' {
        beforeScript = { "export VROOM_THREADS=${task.cpus} OMP_NUM_THREADS=${task.cpus} OPENBLAS_NUM_THREADS=${task.cpus} MKL_NUM_THREADS=${task.cpus} NUMEXPR_NUM_THREADS=${task.cpus} R_DATATABLE_NUM_THREADS=${task.cpus}" }
    }
    // Position references contain millions of rows on a full dataset.
    withName: 'POSITION_REGISTRY' {
        memory = { params.position_registry_memory ?: (background.size() < 20000 ? '8 GB' : '64 GB') }
    }
    // The universe uses the builder of Accumulation (8 GB there). Level 2 reads one block of the null at a time
    // (1.5 GB measured for 500 cycles and 474,450 term-gene pairs); the memory stays in this withName block because
    // a label would override the directive of the process.
    withName: 'POSENRICH_UNIVERSE' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'POSENRICH_WITHIN_GENE' {
        cpus          = { 2 }
        memory        = { params.posenrich_within_gene_memory ?: 16.GB * task.attempt }
        time          = { 4.h * task.attempt }
        errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: 'POSENRICH_CHARACTERIZE|POSENRICH_PROXIMITY' {
        memory = { params.position_module_memory ?: (registry.toRealPath().resolve('positions.tsv').size() < 200000000 ? '4 GB' : '32 GB') }
    }
}
