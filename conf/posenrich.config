// posenrich.config — POSENRICH: position-level enrichment of CAAS detections on the universe U.
// Level 1 (Accumulation, exact hypergeometric test per gene), the position registry and its components
// (characterization, proximity), level 2 (concentration of the signal inside genes, calibrated with the null cycles) and the
// Pfam and UCR reference tables.
// PhyloPhere | conf/

params {
    // ── Essential / common parameters ────────────────────────────────────────
    posenrich                   = false // Enable the POSENRICH module (needs --scoring for the position registry and its components)
    accumulation_fdr            = 0.1   // Benjamini-Hochberg FDR threshold of the Accumulation test
    posenrich_domains           = true  // Include Pfam annotations; generate when domain_variability_file is blank
    posenrich_ucr               = true  // Include UCR annotations; generate when ucr_positions_file is blank

    // ── Advanced parameters ──────────────────────────────────────────────────

    // Standalone inputs of the universe U (levels 1 and 2 read the same universe.tsv.gz)
    accumulation_caas_input     = ""   // Standalone filtered_discovery.tsv input (the observed positives of U)
    accumulation_background_input = "" // Standalone cleaned_background_main.txt input (the gene list of U)
    posenrich_background_file   = ""   // Static override of the tested positions (caastools background.output)

    // Position references
    domain_variability_file     = ""   // Domain variability file. Blank generates Pfam on productive alignments; a supplied table needs an explicit coordinate_space
    pfam_cache_dir              = ""   // Local Pfam-A.hmm + Pfam-A.clans.tsv cache dir (default: ~/.cache/phylophere/pfam); downloaded once and reused
    domain_ref_species          = params.ref_species_name ?: "Homo_sapiens" // Reference species for domain-variability hmmscan
    ucr_positions_file          = ""   // UCR positions file. Blank generates global sliding UCR on productive alignments; a supplied table needs an explicit coordinate_space
    fubar_sites_file            = ""   // FUBAR sites file produced by ortholog_characterizator; this pipeline does not generate it (the HyPhy per-site fit needs the full phylogeny, the codon alignment and MCMC/VB inference)
    posenrich_custom_file       = ""   // TSV: gene, zero-based CAAS position, term, optional description; no header

    // Components of the position registry
    posenrich_collections       = ""   // Collections of level 2, comma-separated ids; blank = the informative ones inside a protein
    posenrich_min_nonzero_cycles = 30  // Null cycles with a nonzero residual a gene needs for a stable standard deviation (below it the gene is excluded)
    posenrich_holdout           = 0    // Validation mode: this many null cycles play the observed one and only holdout_fpr.tsv is written (0 = off)
    posenrich_radios            = "0,5,10" // Radii of the protein proximity (reference residues), fixed before the contrast
    position_registry_memory    = '' // Full normalized registry; blank sizes it from the background
    position_module_memory      = '' // Full positional tables; blank sizes it from the registry
    posenrich_within_gene_memory = '' // Level 2 reads one block of the null at a time; blank = 16 GB
}
