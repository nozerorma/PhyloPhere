/*
 * Reporting tool configuration (trait analysis reports)
 */

cleanup = false // Cleanup work directory after execution. Toggle at your own guise. Setting to false can be useful for debugging, but will consume more disk space.

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    outdir             = outdir             ?: "$baseDir/out" // Output directory for reports and results
    workDir            = workDir            ?: "$baseDir/out/work" // Working directory for Nextflow execution
    my_traits          = my_traits          ?: "" // Path to traits CSV file
    alignment          = alignment          ?: "" // Path to alignments directory or .tar.gz archive
    tree               = tree               ?: "" // Path to species tree file (newick format)
    traitname          = traitname          ?: "" // Name of the phenotype/trait column to analyze
    tax_id             = tax_id             ?: "" // Path to taxonomic ID mapping file (taxid to species)
    reporting          = reporting          ?: true // Generate comprehensive HTML analysis reports
    sp_colname         = sp_colname         ?: "species" // Column name for species in the traits CSV file
    clade_name         = clade_name         ?: "primates" // Focus clade name for reports
    taxon_of_interest  = taxon_of_interest  ?: "family" // Taxonomic rank of interest (e.g. family, order)
    scoring            = scoring            ?: false // Enable composite score integration module
    vep                = vep                ?: true // Enable VEP pathogenicity (PrimateAI-3D/COSMIC) annotation
    enrichment         = enrichment         ?: false // Enable FCS ranked gene-set enrichment module
    posenrich          = posenrich          ?: true // Enable position-wise enrichment module
    fade               = fade               ?: false // Enable HyPhy FADE directional selection analysis
    rer_tool           = rer_tool           ?: "" // Enable RERconverge relative evolutionary rate ("continuous" | "build_trait")
    contrast_selection = contrast_selection ?: false // Enable automatic contrast-selection extreme pruning

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================
    help               = help               ?: false // Show help and exit
    ali_format         = ali_format         ?: "fasta" // Alignment file format
    ali_sp_names       = ali_sp_names       ?: "" // Precomputed flat file of alignment species names (speeds startup)
    gene_ensembl_file  = gene_ensembl_file  ?: "" // Path to gene Ensembl mapping file (gene ID to gene name)
    seed               = seed               ?: "1998" // Random seed for reproducibility
    toy_mode           = toy_mode           ?: false // Subsample N alignments for quick smoke testing
    toy_n              = toy_n              ?: 200   // Number of alignments to sample in toy_mode
    n_trait            = n_trait            ?: "" // Trait with total individuals sampled (population size)
    c_trait            = c_trait            ?: "" // Trait with observed case count (e.g. neoplasia cases)
    secondary_trait    = secondary_trait    ?: "" // Secondary trait column to include in reports
    branch_trait       = branch_trait       ?: "" // Trait column to use for tree branch coloring
    discrete_method    = discrete_method    ?: "quintile" // Categorization: quartile, quintile, decile, median_sd, parameterized
    top_quantile       = top_quantile       ?: "0.90"   // Upper threshold for parameterized method
    bottom_quantile    = bottom_quantile    ?: "0.10"   // Lower threshold for parameterized method
    trait_type         = trait_type         ?: ""       // "" / auto = infer; "ordinal" = coded fg/bg (highest level FG, lowest BG); "continuous" = force quantiles
    contrast_max_iter  = contrast_max_iter  ?: "3"      // Max iterations for contrast selection algorithm
    min_contrasts      = min_contrasts      ?: 3    // Minimum required foreground contrasts to proceed
    prune_data         = prune_data         ?: "" // Enable data pruning
    prune_list         = prune_list         ?: "" // Primary species pruning list file
    prune_list_secondary = prune_list_secondary ?: "" // Optional secondary prune list file
    ct_disambiguation  = ct_disambiguation   ?: true // Enable CT disambiguation workflow stage
    ct_postproc        = ct_postproc         ?: true // Enable CT post-processing workflow stage
    ct_accumulation    = ct_accumulation     ?: true // Enable CT accumulation workflow stage


}

// Capture exit codes from upstream processes when piping
// Different reports and logs to capture execution details.
timeline {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
tower {
    accessToken = new File("$baseDir/token.tk").exists() ? new File("$baseDir/token.tk").text.trim() : (System.getenv('TOWER_ACCESS_TOKEN') ?: "") // Read locally from token.tk if present, otherwise environment variable
    enabled = new File("$baseDir/token.tk").exists() || System.getenv('TOWER_ACCESS_TOKEN') // Enable if token file or env variable is present
}
