/*
 * VEP characterization configuration
 * Annotates CAAS positions with PrimateAI-3D and COSMIC pathogenicity scores
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    // Cannot be generated in-house: maps each alignment codon column to its real
    // hg38 genomic/protein coordinate, which needs the full alignment-to-protein
    // pipeline (github.com/nozerorma/ortholog_characterizator), not just the
    // alignment + a public DB. Required whenever any VEP annotation source below
    // (PrimateAI-3D, COSMIC, or Ensembl VEP) is used.
    vep_map_dir                 = vep_map_dir                 ?: "" // Directory containing per-gene MAP files (e.g., GENE*.map.tsv) — see github.com/nozerorma/ortholog_characterizator
    // Illumina-licensed; redistribution not permitted, so this stays a
    // user-supplied external file with no vendoring/auto-download path.
    vep_primateai_db            = vep_primateai_db            ?: "" // Path to PrimateAI-3D pathogenicity database
    // License terms for redistribution not yet confirmed; stays external for
    // now (same treatment as PrimateAI-3D) pending that check.
    cosmic_db                   = cosmic_db                   ?: "" // Path to COSMIC mutation database
    // Ensembl VEP (the official CLI tool) — independent annotation source, runs
    // even when neither PrimateAI-3D nor COSMIC is supplied. Off by default:
    // needs a pre-downloaded, multi-GB offline cache (see vep_cache_dir below).
    vep_ensembl                 = vep_ensembl                 ?: false // Enable Ensembl VEP consequence annotation

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================
    vep_caas_input              = vep_caas_input              ?: "" // Standalone CAAS input override (defaults to CT_POSTPROC.filtered_discovery)
    vep_position_scores         = vep_position_scores         ?: "" // Standalone override for SCORING position_scores.tsv; enables the convergence_schemes gate (skips positions where it is empty). With --scoring this is auto-wired from SCORING.
    // Left empty, defaults to a persistent ~/.cache/phylophere/vep/<species>_
    // <assembly> location and is populated automatically on first use via:
    //   vep_install -a cf -s <species> -y <assembly> -c <vep_cache_dir> --NO_HTSLIB
    // (fetch-first, cache-once — same pattern as string_cache_dir elsewhere in
    // this pipeline). Set explicitly to reuse/share an already-populated cache.
    vep_cache_dir                = vep_cache_dir                ?: "" // Local Ensembl VEP offline cache directory (auto-populated on first use when vep_ensembl is set and this is left blank)
    vep_species                  = vep_species                  ?: "homo_sapiens" // Ensembl VEP --species
    vep_assembly                 = vep_assembly                 ?: "GRCh38" // Ensembl VEP --assembly
}
