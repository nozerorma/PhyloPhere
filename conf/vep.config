// vep.config — VEP characterization: PrimateAI-3D, COSMIC and Ensembl VEP annotation of CAAS positions.
// PhyloPhere | conf/

params {
    // ── Essential / common parameters ────────────────────────────────────────
    // The per-gene MAP directory is caas_map_dir (conf/ct_postproc.config). The pipeline cannot
    // generate it: it maps each alignment codon column to its hg38 genomic and protein coordinate,
    // which needs the full alignment-to-protein pipeline (github.com/nozerorma/ortholog_characterizator),
    // not only the alignment and a public database. Every VEP annotation source below (PrimateAI-3D,
    // COSMIC, Ensembl VEP) uses it.
    // PrimateAI-3D is Illumina-licensed and cannot be redistributed, so the file is supplied by the
    // user and is neither bundled nor downloaded.
    vep_primateai_db            = "" // Path to PrimateAI-3D pathogenicity database
    // Supplied by the user, like the PrimateAI-3D file.
    cosmic_db                   = "" // Path to COSMIC mutation database
    // Ensembl VEP (the official command-line tool): an annotation source independent of PrimateAI-3D
    // and COSMIC, so it runs even when neither is supplied. Off by default because it needs a
    // multi-GB offline cache (see vep_cache_dir below).
    vep_ensembl                 = false // Enable Ensembl VEP consequence annotation

    // ── Advanced parameters ──────────────────────────────────────────────────
    // Left empty, the cache is ~/.cache/phylophere/vep/<species>_<assembly> and is populated on first use with:
    //   vep_install -a cf -s <species> -y <assembly> -c <vep_cache_dir> --NO_HTSLIB
    // (downloaded once and reused, as for string_cache_dir). Set it to reuse or share a populated cache.
    vep_cache_dir                = "" // Local Ensembl VEP offline cache directory (auto-populated on first use when vep_ensembl is set and this is left blank)
    vep_species                  = "homo_sapiens" // Ensembl VEP --species
    vep_assembly                 = "GRCh38" // Ensembl VEP --assembly
}
