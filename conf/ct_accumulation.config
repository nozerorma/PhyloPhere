// ct_accumulation.config — CT_ACCUMULATION: gene-level CAAS accumulation tested by randomization.
// PhyloPhere | conf/

params {
    // ── Essential / common parameters ────────────────────────────────────────
    accumulation_randomization_type     = "cons_decile" // Randomization strategy: "naive" | "cons_decile" | "permulation" (counts the hits of the filtered CAAS_CORE_MERGE null, perm_pos_cycle_caas.tsv.gz, with N from cycle_roster.txt; it keeps the phenotype-tree structure but is not matched on conservation deciles). With the null table available (CAAS_CORE_MERGE of this run, or --caas_pos_cycle_caas_file), naive and cons_decile draw from the universe U (tested positions scored by the null in at least one cycle, plus the observed positions); without it they draw from the tested positions
    accumulation_n_randomizations       = 1000000       // Number of randomizations for burden permutation
    accumulation_fdr                    = 0.1           // Benjamini-Hochberg FDR threshold

    // ── Advanced parameters ──────────────────────────────────────────────────

    // Standalone input overrides
    accumulation_caas_input             = ""   // Standalone filtered_discovery.tsv input
    accumulation_background_input       = ""   // Standalone cleaned_background_main.txt input
    accumulation_entropy_dir            = ""   // Directory containing Valdar entropy (.entropy.tsv) files
}
