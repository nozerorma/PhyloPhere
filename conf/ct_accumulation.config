/*
 * CT_ACCUMULATION configuration
 * Tests for significant accumulation of CAAS at the gene level via permutation
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    accumulation_randomization_type     = accumulation_randomization_type   ?: "cons_decile" // Randomization strategy: "naive" | "cons_decile" | "permulation" (opt-in; reuses a prior CAAS_PERMULATION null via --caas_pos_detail_file — holds the phenotype-tree confound but is NOT conservation-decile matched)
    accumulation_n_randomizations       = accumulation_n_randomizations     ?: 1000000       // Number of randomizations for burden permutation
    accumulation_fdr                    = accumulation_fdr                  ?: 0.1           // Benjamini-Hochberg FDR threshold

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================

    // Standalone input overrides
    accumulation_caas_input             = accumulation_caas_input           ?: ""   // Standalone filtered_discovery.tsv input
    accumulation_background_input       = accumulation_background_input     ?: ""   // Standalone cleaned_background_main.txt input
    accumulation_entropy_dir            = accumulation_entropy_dir          ?: ""   // Directory containing Valdar entropy (.entropy.tsv) files
}
