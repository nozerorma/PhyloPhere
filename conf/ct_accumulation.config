/*
 * CT_ACCUMULATION configuration
 *
 * Parameters controlling the CT Accumulation subworkflow, which tests
 * for significant accumulation of CAAS at the gene level via permutation.
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    // Note: Main toggle `ct_accumulation` lives in common.config

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================
    accumulation_caas_input             = accumulation_caas_input           ?: ""   // Standalone filtered_discovery.tsv input
    accumulation_background_input       = accumulation_background_input     ?: ""   // Standalone cleaned_background_main.txt input
    accumulation_entropy_dir            = accumulation_entropy_dir          ?: ""   // Directory containing Valdar entropy (.entropy.tsv) files
    accumulation_n_randomizations       = accumulation_n_randomizations     ?: 1000000 // Number of randomizations for burden permutation
    accumulation_randomization_type     = accumulation_randomization_type   ?: "cons_decile"  // Randomization strategy: naive | cons_decile
    accumulation_seed                   = accumulation_seed                 ?: 1998    // RNG seed for accumulation randomizations
    accumulation_fdr                        = accumulation_fdr                      ?: 0.1 // Benjamini-Hochberg FDR threshold
    accumulation_pval_threshold             = accumulation_pval_threshold           ?: 0.05 // Significance p-value threshold
    accumulation_report_pval_threshold      = accumulation_report_pval_threshold    ?: 0.05 // P-value threshold for report tables
}
