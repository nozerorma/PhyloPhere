// ct_accumulation.config — CT_ACCUMULATION: gene-level CAAS accumulation tested by randomization.
// PhyloPhere | conf/

params {
    // ── Essential / common parameters ────────────────────────────────────────
    accumulation_randomization_type     = "cons_decile" // Randomization strategy: "naive" | "cons_decile" | "permulation" (reuses the CAAS_CORE_MERGE null from caas_pos_detail_file; it keeps the phenotype-tree structure but is not matched on conservation deciles)
    accumulation_n_randomizations       = 1000000       // Number of randomizations for burden permutation
    accumulation_fdr                    = 0.1           // Benjamini-Hochberg FDR threshold

    // ── Advanced parameters ──────────────────────────────────────────────────

    // Standalone input overrides
    accumulation_caas_input             = ""   // Standalone filtered_discovery.tsv input
    accumulation_background_input       = ""   // Standalone cleaned_background_main.txt input
    accumulation_entropy_dir            = ""   // Directory containing Valdar entropy (.entropy.tsv) files
}
