/*
 * FADE configuration
 * FUBAR Approach to Directional Evolution (HyPhy)
 * Tests per-site directional selection on foreground branches
 */

params {
    // =========================================================================
    // === ESSENTIAL / COMMON PARAMETERS =======================================
    // =========================================================================
    fade_model                  = fade_model                ?: 'LG'                 // Protein substitution model ('LG', 'JTT', 'WAG', 'Blosum62', 'GTR')
    fade_bf_threshold           = fade_bf_threshold         ?: 100                  // Bayes Factor threshold for directional selection (default: 100)

    // =========================================================================
    // === ADVANCED PARAMETERS =================================================
    // =========================================================================

    // HyPhy inference and MCMC sampling
    fade_method                 = fade_method               ?: 'Variational-Bayes' // Inference method: 'Variational-Bayes' | 'Collapsed-Gibbs' | 'Metropolis-Hastings'
    fade_grid                   = fade_grid                 ?: 20                   // Grid resolution for posterior estimation
    fade_chains                 = fade_chains               ?: 5                    // MCMC chain count
    fade_chain_length           = fade_chain_length         ?: 2000000              // MCMC chain length
    fade_burn_in                = fade_burn_in              ?: 1000000              // MCMC burn-in length
    fade_samples                = fade_samples              ?: 1000                 // MCMC sample count
    fade_concentration          = fade_concentration        ?: 0.5                  // Dirichlet concentration prior
    lg_dat_path                 = lg_dat_path               ?: "${projectDir}/subworkflows/SELECTION/local/dat/lg.dat"

    // Batching and performance
    selection_prep_batch_size   = selection_prep_batch_size  ?: 500                  // Alignment prep batch size per Nextflow task
    fade_batch_size             = fade_batch_size           ?: 200                  // FADE execution batch size per Nextflow task

    // Reporting and precomputed inputs
    fade_min_genes_for_heatmap  = fade_min_genes_for_heatmap ?: 2                  // Minimum genes for report heatmap
    fade_postproc_top           = fade_postproc_top         ?: ''                   // Standalone top CAAS genes list file
    fade_postproc_bottom        = fade_postproc_bottom      ?: ''                   // Standalone bottom CAAS genes list file
    fade_universe_file          = fade_universe_file        ?: ""                   // FADE tested-gene background universe file
    fade_json_dir_top           = fade_json_dir_top         ?: ""                   // Precomputed top FADE JSON directory
    fade_json_dir_bottom        = fade_json_dir_bottom      ?: ""                   // Precomputed bottom FADE JSON directory
}
