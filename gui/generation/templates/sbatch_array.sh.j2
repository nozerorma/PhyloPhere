#!/bin/bash
#SBATCH --job-name={{ runtime.sbatch_job_name }}
#SBATCH --partition={{ runtime.sbatch_partition }}
#SBATCH -t {{ runtime.sbatch_time }}
#SBATCH -N 1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH -e Slurm/slurm-%A_%a.err
#SBATCH -o Slurm/slurm-%A_%a.out
{% if runtime.sbatch_mail_user %}
#SBATCH --mail-type=START,END,FAIL
#SBATCH --mail-user={{ runtime.sbatch_mail_user }}
{% endif %}
#SBATCH --array={{ array_spec }}

# Generated by the PhyloPhere runner GUI — edit the project file and regenerate
# rather than hand-editing this file, unless you're making a one-off tweak.

mkdir -p Slurm

source /etc/profile
module purge

# Try to load Rocky 9 modulepaths and Nextflow version first
if { module load modulepath/UPF/apps 2>/dev/null || module load modulepath/haswell-rocky9 2>/dev/null; } && module load Nextflow/25.10.2 2>/dev/null; then
    echo "[sbatch] Loaded Nextflow/25.10.2 via Rocky 9 stack"
else
    # Fallback to Haswell stack
    module load modulepath/haswell 2>/dev/null
    module load Nextflow/25.04.6 2>/dev/null
    echo "[sbatch] Loaded Nextflow/25.04.6 via Haswell stack"
fi

# Load Conda
module load Miniconda3 2>/dev/null || module load Miniconda3/25.7.0-2 2>/dev/null || true

source ~/.bashrc
conda deactivate
conda activate phylophere

# --- GLOBAL RUN CONFIG ---
export RESUME="${RESUME:-{{ "1" if runtime.resume else "0" }}}"
export RUN_TOWER={{ run_defaults.tower }}

if [ "{{ run_defaults.toy_mode }}" = true ]; then
    export TAG="_toy"
    export TOY_MODE=true
    export TOY_N="{{ runtime.toy_n }}"
    export PERMS_CYCLES="1000"
    export CAAS_FULL_PERMS="100"
    export N_RANDOMIZATIONS="1000"
    export RER_PERM_BATCHES="10"
    export RER_PERMS_PER_BATCH="10"
else
    export TAG=""
    export TOY_MODE=false
    export TOY_N=""
    export PERMS_CYCLES="{{ modules.caas.perms_cycles }}"
    export CAAS_FULL_PERMS="${CAAS_FULL_PERMS:-{{ modules.caas.caas_full_perms }}}"
    export N_RANDOMIZATIONS="{{ modules.accumulation.accumulation_n_randomizations }}"
    export RER_PERM_BATCHES="{{ modules.rer.rer_perm_batches }}"
    export RER_PERMS_PER_BATCH="{{ modules.rer.rer_perms_per_batch }}"
fi

# --- INDIVIDUAL TOOL TOGGLES ---
export RUN_REPORTING={{ run_defaults.reporting }}
export RUN_CAAS={{ run_defaults.caas }}
export RUN_DISAMBIGUATION={{ run_defaults.disambiguation }}
export RUN_CT_POSTPROC={{ run_defaults.ct_postproc }}
export RUN_ACCUMULATION={{ run_defaults.accumulation }}
export RUN_RER={{ run_defaults.rer }}
export RUN_FADE={{ run_defaults.fade }}
export RUN_VEP={{ run_defaults.vep }}
export RUN_SCORING={{ run_defaults.scoring }}
export RUN_SCORING_STRESS={{ run_defaults.scoring_stress }}
export RUN_ENRICHMENT={{ run_defaults.enrichment }}
export RUN_POSENRICH={{ run_defaults.posenrich }}

# --- COMMON THINGS (shared across every phenotype in this batch) ---
export CAAS_OUTBASE="{{ runtime.results_dir }}"
export WORK_BASE="{{ runtime.work_dir }}"
export SEED="{{ general.seed }}"
export MAX_CPUS="{{ resources.slurm_max_cpus if profile == 'slurm' else resources.local_max_cpus }}"
export MAX_MEMORY="{{ resources.slurm_max_memory if profile == 'slurm' else resources.local_max_memory }}"
export MAX_TIME="{{ resources.slurm_max_time if profile == 'slurm' else resources.local_max_time }}"

export ALI_DIR="{{ runtime.alignment_dir }}"
export TREE_FILE="{{ runtime.tree_file }}"
export TRAIT_FILE="{{ runtime.trait_file }}"
export SIMPLE_TRAIT_FILE="{{ runtime.simple_trait_file }}"
export PRUNE_DIR="{{ runtime.prune_dir }}"
export BRANCH_TRAIT="{{ runtime.branch_trait }}"
export ALI_SP_NAMES="{{ runtime.ali_sp_names }}"
export INPUT_TAX_ID="{{ runtime.tax_id_file }}"

# --- CAAS ---
export CAAS_CONFIG="{{ modules.caas.caas_config_path }}"
export DISCOVERY_FROM="{{ modules.caas.discovery_from }}"
export RESAMPLE_FROM="{{ modules.caas.resample_from }}"
export BOOTSTRAP_FROM="{{ modules.caas.bootstrap_from }}"

# --- DISAMBIGUATION / POST-PROCESSING ---
export ASR_MODE="{{ modules.disambiguation.ct_disambig_asr_mode }}"
export ASR_CACHE_DIR="{{ modules.disambiguation.ct_disambig_asr_cache_dir }}"
export POSTPROC_MODE="{{ modules.disambiguation.caas_postproc_mode }}"
export POSTPROC_MINLEN="{{ modules.disambiguation.filter_minlen }}"
export POSTPROC_MAXCAAS="{{ modules.disambiguation.filter_maxcaas }}"
export POSTPROC_GENE_FILTER_MODE="{{ modules.disambiguation.gene_filter_mode }}"
export SIGNIFICATION_FROM="{{ modules.disambiguation.signification_from }}"
export DISAMBIGUATION_INPUT="{{ modules.disambiguation.disambiguation_input }}"
export DISAMBIGUATION_DIR="{{ modules.disambiguation.disambiguation_dir }}"
export BACKGROUND_INPUT="{{ modules.disambiguation.background_input }}"

# --- ACCUMULATION ---
export ENTROPY_DIR="{{ modules.accumulation.accumulation_entropy_dir }}"
export ACCUMULATION_CAAS_INPUT="{{ modules.accumulation.accumulation_caas_input }}"
export ACCUMULATION_BACKGROUND_INPUT="{{ modules.accumulation.accumulation_background_input }}"

# --- RERCONVERGE ---
export RER_TOOL="{{ rer_tool_string }}"
export GENE_TREES="{{ modules.rer.gene_trees }}"

# --- FADE ---
export FADE_MODE="{{ modules.fade.fade_mode }}"

# --- VEP ---
export VEP_PRIMATEAI_DB="{{ modules.vep.vep_primateai_db }}"
export MAP_DIR="{{ modules.vep.vep_map_dir }}"
export SCORING_VEP_COSMIC="{{ modules.vep.scoring_vep_cosmic }}"
export VEP_CAAS_INPUT="{{ modules.vep.vep_caas_input }}"

# --- SCORING ---
export SCORING_WINDOW_SIZE_BP="{{ modules.scoring.scoring_window_size_bp }}"
export GENE_ENSEMBL_FILE="{{ modules.scoring.gene_ensembl_file }}"
export SCORING_POSTPROC_INPUT="{{ modules.scoring.scoring_postproc_input }}"
export SCORING_ACCUM_DIR="{{ modules.scoring.scoring_accum_dir }}"
export SCORING_VEP_PRIMATEAI="{{ modules.scoring.scoring_vep_primateai }}"
export SCORING_BACKGROUND_INPUT="{{ modules.scoring.scoring_background_input }}"
export CAAS_PERMS_FILE="{{ modules.scoring.caas_perms_file }}"
export SCORING_FADE_SITE_TOP="{{ modules.scoring.scoring_fade_site_top }}"
export SCORING_FADE_SITE_BOTTOM="{{ modules.scoring.scoring_fade_site_bottom }}"

# --- ENRICHMENT / POSENRICH ---
export GMT_DIR="{{ modules.enrichment.gmt_dir }}"
export STRING_DB_DIR="{{ modules.enrichment.string_db_dir }}"
export EGG_MEMBERS_FILE="{{ modules.enrichment.egg_members_file }}"
export EGG_ANNOTATIONS_FILE="{{ modules.enrichment.egg_annotations_file }}"
export COSMIC_DB="{{ modules.enrichment.cosmic_db }}"
export DOMAIN_VARIABILITY_FILE="{{ modules.enrichment.domain_variability_file }}"
export UCR_POSITIONS_FILE="{{ modules.enrichment.ucr_positions_file }}"
export FUBAR_SITES_FILE="{{ modules.enrichment.fubar_sites_file }}"
export ENRICHMENT_BACKGROUND_INPUT="{{ modules.enrichment.enrichment_background_input }}"
export ENRICHMENT_GENE_LISTS_INPUT="{{ modules.enrichment.enrichment_gene_lists_input }}"
export ACCUMULATION_ENRICHMENT_GENE_LISTS_INPUT="{{ modules.enrichment.accumulation_enrichment_gene_lists_input }}"
export POSENRICH_BACKGROUND_FILE="{{ modules.enrichment.posenrich_background_file }}"

REPO_DIR="{{ general.repo_dir }}"
SINGLE_RUNNER="${REPO_DIR}/run_phenotype_single.sh"

# --- PHENOTYPE CATALOGUE ---
export SLURM_ARRAY_TASK_ID
case $SLURM_ARRAY_TASK_ID in
{% for row in runtime.phenotype_rows %}
    {{ loop.index }}) CLASS={{ row.trait_class }}; TRAIT="{{ row.trait }}"; SECONDARY="{{ row.secondary }}"; NTRAIT="{{ row.n_trait }}"; CTRAIT="{{ row.c_trait }}"; PRUNE="{{ row.prune }}"; PRUNE_SEC="{{ row.prune_secondary }}"; DISCRETE="{{ row.discrete_method }}"
{% if row.scoring_rer_input %}
        export SCORING_RER_INPUT="{{ row.scoring_rer_input }}"
{% endif %}
{% if row.scoring_fade_summary_top %}
        export SCORING_FADE_SUMMARY_TOP="{{ row.scoring_fade_summary_top }}"
{% endif %}
{% if row.scoring_fade_summary_bottom %}
        export SCORING_FADE_SUMMARY_BOTTOM="{{ row.scoring_fade_summary_bottom }}"
{% endif %}
        ;;
{% endfor %}
esac

echo "======================================================"
echo " SLURM TASK ID : $SLURM_ARRAY_TASK_ID"
echo " TRAIT         : $TRAIT  [CLASS $CLASS]"
echo "======================================================"

bash "$SINGLE_RUNNER" "$CLASS" "$TRAIT" "$SECONDARY" "$NTRAIT" "$CTRAIT" "$PRUNE" "$PRUNE_SEC" "$DISCRETE"
