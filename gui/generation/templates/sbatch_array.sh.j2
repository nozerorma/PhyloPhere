# --- PHENOTYPE CATALOGUE ---
# Shared by both the SLURM-array and local-loop dispatch paths below: one bash
# function, called either once (SLURM sets $SLURM_ARRAY_TASK_ID itself) or in a
# sequential loop over every row (no scheduler locally, so this script IS the loop).
dispatch_phenotype() {
    local task_id="$1"
    case "$task_id" in
{% for row in runtime.phenotype_rows %}
    {{ loop.index }}) CLASS={{ row.trait_class }}; TRAIT="{{ row.trait }}"; SECONDARY="{{ row.secondary }}"; NTRAIT="{{ row.n_trait }}"; CTRAIT="{{ row.c_trait }}"; PRUNE="{{ row.prune }}"; PRUNE_SEC="{{ row.prune_secondary }}"; DISCRETE="{{ row.discrete_method }}"; TRAIT_TYPE="{{ row.trait_type }}"
        ;;
{% endfor %}
    *)
        echo "Error: no phenotype row configured for task id '$task_id'" >&2
        return 1
        ;;
    esac

    echo "======================================================"
    echo " TASK ID       : $task_id"
    echo " TRAIT         : $TRAIT  [CLASS $CLASS]"
    echo "======================================================"

    bash "$SINGLE_RUNNER" "$CLASS" "$TRAIT" "$SECONDARY" "$NTRAIT" "$CTRAIT" "$PRUNE" "$PRUNE_SEC" "$DISCRETE" "$TRAIT_TYPE"
}

{% if profile == 'slurm' %}
export SLURM_ARRAY_TASK_ID
dispatch_phenotype "$SLURM_ARRAY_TASK_ID"
{% else %}
# Local runtime: no scheduler to set SLURM_ARRAY_TASK_ID or fan tasks out for us,
# so run every phenotype row sequentially, one after another, in this process.
for task_id in $(seq 1 {{ array_size }}); do
    dispatch_phenotype "$task_id"
done
{% endif %}
