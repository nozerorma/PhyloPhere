#!/bin/bash
set -Eeuo pipefail

# Generated by the PhyloPhere runner GUI — edit the project file and regenerate
# rather than hand-editing this file, unless you're making a one-off tweak.

# --- ARGUMENTS ---
CLASS="${1:?Usage: $0 <CLASS> <TRAIT> [SECONDARY_TRAIT] [N_TRAIT] [C_TRAIT] [PRUNE_FILE] [PRUNE_SECONDARY_FILE] [DISCRETE_METHOD]}"
TRAIT="${2:?TRAIT must be provided}"
SECONDARY_TRAIT="${3:-}"
N_TRAIT="${4:-}"
C_TRAIT="${5:-}"
PRUNE_FILE="${6:-}"
PRUNE_SECONDARY_FILE="${7:-}"
DISCRETE_METHOD="${8:-}"

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
timestamp=$(date +%Y%m%d_%H%M%S)

# --- ENV ACTIVATION ---
source ~/.bashrc
conda deactivate
conda activate phylophere

# Setup unique Nextflow home directory to avoid file lock collisions on history database
export NXF_HOME="$WORK_BASE/.nextflow/.nextflow_${TRAIT}"
mkdir -p "$NXF_HOME"
ln -sfn "{{ general.nextflow_plugins_dir }}" "$NXF_HOME/plugins"

# Create and cd into a unique run directory to prevent Nextflow session/cache database lock collisions
RUN_DIR="$WORK_BASE/${TRAIT}_nxf_run"
mkdir -p "$RUN_DIR"
cd "$RUN_DIR"

if [ "${POSTPROC_MODE:-}" = "exploratory" ]; then
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}_exploratory"
    RUN_TAG="_exploratory"
    # Exploratory only sweeps minlen_values x maxcaas_values and stops there — every
    # downstream module (and RER/FADE, neither of which even depend on postproc) waits
    # for the _complete pass. If RER/FADE are enabled in the project, they run there.
    RUN_ACCUMULATION=false
    RUN_VEP=false
    RUN_FADE=false
    RUN_RER=false
    RUN_SCORING=false
elif [ "${POSTPROC_MODE:-}" = "filter" ]; then
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}_complete"
    RUN_TAG="_complete"
{% if reuse_exploratory %}
    # An _exploratory pass was generated alongside this script — reuse its already-computed
    # CAAS/Disambiguation output by file instead of recomputing it (no -resume/shared-workdir
    # reliance): CT discovery/resample/bootstrap and live Disambiguation are both switched off,
    # and CT_POSTPROC (still on, now applying the single chosen filter_minlen/filter_maxcaas
    # pair instead of the exploratory sweep) reads Disambiguation's master CSV + background
    # genes straight from the _exploratory outdir. ASR robustness was already produced during
    # _exploratory (same disambiguation data), so it's not regenerated here.
    RUN_CAAS=false
    RUN_DISAMBIGUATION=false
    ASR_ROBUSTNESS=false
    EXPLORATORY_OUTDIR="${CAAS_OUTBASE}/${TRAIT}${TAG}_exploratory"
    DISAMBIGUATION_INPUT="${EXPLORATORY_OUTDIR}/ct_disambiguation/caas_convergence_master.csv"
    DISAMBIGUATION_DIR="${EXPLORATORY_OUTDIR}/ct_disambiguation"
    BACKGROUND_INPUT="${EXPLORATORY_OUTDIR}/caastools/background_genes.output"

    # REPORTING (dataset exploration + tree name-curation, and pruning for CLASS 1 rows
    # with a PRUNE_FILE) ran identically during _exploratory — same --my_traits/--tree
    # inputs regardless of POSTPROC_MODE — so rerunning it here would only reproduce the
    # same HTML/data_exploration reports a second time. Reuse instead: substitute the
    # tree/trait file the _complete pass hands to Nextflow with _exploratory's already-
    # curated (and, if this row prunes species, already-pruned) output, published
    # unconditionally by TREE_CLEANUP/DATASET_PRUNE regardless of which subworkflow
    # (REPORTING vs CONTRAST_SELECTION) invoked them. Overriding $TREE_FILE/$TRAIT_FILE
    # here — rather than wiring a new main.nf param — means every downstream consumer
    # that already falls back to params.tree (e.g. FADE's SELECTION_PREP) transparently
    # gets the curated tree with no further plumbing. Pruning is CLASS 1-only in this
    # GUI (see the CLASS-specific block below), and 0.Data_pruning.Rmd's pruned_trait_file
    # is a plain row-filtered copy of the original --my_traits file (same columns,
    # tab-separated) — safe to substitute for CLASS 1's own tab-separated TRAIT_FILE;
    # never applies to CLASS 2 (SIMPLE_TRAIT_FILE, comma-separated), which never prunes.
    RUN_REPORTING=false
    PRUNED_TREE_CANDIDATE="${EXPLORATORY_OUTDIR}/data_exploration/0.Data-pruning/pruned_tree_file.nwk"
    if [ -f "$PRUNED_TREE_CANDIDATE" ]; then
        TREE_FILE="$PRUNED_TREE_CANDIDATE"
        TRAIT_FILE="${EXPLORATORY_OUTDIR}/data_exploration/0.Data-pruning/pruned_trait_file.tsv"
    else
        TREE_FILE="${EXPLORATORY_OUTDIR}/name_curation/curated_tree.nwk"
    fi
{% endif %}
else
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}"
    RUN_TAG=""
fi
WORK_DIR="${WORK_BASE}/${TRAIT}${TAG}"
mkdir -p "${RESULTS_BASE}" "${WORK_DIR}"

# --- PRECOMPUTED REUSE (Precomputed Run tab) ---
# Every path below is base_path/<TRAIT>/<known-subpath> — verified against each
# producing process's actual publishDir, see gui/models/precomputed.py's module
# docstring for the full table. Checking a box in the GUI both sets one of these
# and switches the corresponding module off (via that module's own enable_toggle,
# so RUN_* above already reflects it) — this block only supplies the *value* each
# module's existing precomputed-fallback branch (below) was already able to consume.
PRECOMP_OUTDIR="${PRECOMP_BASE_PATH:-}/${TRAIT}"

if [ "${PRECOMP_USE_DISCOVERY:-false}" = true ]; then
    DISCOVERY_FROM="${PRECOMP_OUTDIR}/caastools/discovery.tab"
    SIGNIFICATION_FROM="${PRECOMP_OUTDIR}/signification/meta_caas/global_meta_caas.tsv"
    [ -f "$SIGNIFICATION_FROM" ] || SIGNIFICATION_FROM="${PRECOMP_OUTDIR}/signification/meta_caas/meta_caas.tsv"
    BACKGROUND_INPUT="${PRECOMP_OUTDIR}/caastools/background_genes.output"
    POSENRICH_BACKGROUND_FILE="${PRECOMP_OUTDIR}/caastools/background.output"
    # caas_perms.rds only exists if the source run had --caas_permulation_enrichment on.
    CAAS_PERMS_FILE="${PRECOMP_OUTDIR}/caas_permulation/caas_perms.rds"
fi
if [ "${PRECOMP_USE_RESAMPLE:-false}" = true ]; then
    RESAMPLE_FROM="${PRECOMP_OUTDIR}/caastools/resample.tab"
fi
if [ "${PRECOMP_USE_BOOTSTRAP:-false}" = true ]; then
    BOOTSTRAP_FROM="${PRECOMP_OUTDIR}/caastools/bootstrap.tab"
fi

if [ "${PRECOMP_USE_DISAMBIGUATION:-false}" = true ]; then
    DISAMBIGUATION_INPUT="${PRECOMP_OUTDIR}/ct_disambiguation/caas_convergence_master.csv"
    DISAMBIGUATION_DIR="${PRECOMP_OUTDIR}/ct_disambiguation"
fi

if [ "${PRECOMP_USE_POSTPROC:-false}" = true ]; then
    # gene_filtering/cleaned_backgrounds only exist if the source run had
    # gene_filter_mode != 'none' (the default).
    ACCUMULATION_CAAS_INPUT="${PRECOMP_OUTDIR}/postproc/gene_filtering/filtered_discovery.tsv"
    VEP_CAAS_INPUT="$ACCUMULATION_CAAS_INPUT"
    SCORING_POSTPROC_INPUT="$ACCUMULATION_CAAS_INPUT"
    ACCUMULATION_BACKGROUND_INPUT="${PRECOMP_OUTDIR}/postproc/cleaned_backgrounds/cleaned_background_main.txt"
    SCORING_BACKGROUND_INPUT="$ACCUMULATION_BACKGROUND_INPUT"
fi

if [ "${PRECOMP_USE_ACCUMULATION:-false}" = true ]; then
    SCORING_ACCUM_DIR="${PRECOMP_OUTDIR}/accumulation"
fi

if [ "${PRECOMP_USE_RER:-false}" = true ]; then
    RER_CONTINUOUS_FILE="${PRECOMP_OUTDIR}/rerconverge/rer_results/${TRAIT}.continuous.output"
    # perms RDS only exists if the source run's phenotype actually had permulation on.
    RER_PERMS_FILE="${PRECOMP_OUTDIR}/rerconverge/rer_results/${TRAIT}.continuous.perms.rds"
    SCORING_RER_PERMS_INPUT="$RER_PERMS_FILE"
    # Scoring's own RER fallback is RER_REPORT's rendered summary, not RER_CONT's raw
    # output above — different producer, filename carries a variable suffix so it's
    # resolved with a glob at generation time here rather than a fixed path.
    SCORING_RER_INPUT="$(ls "${PRECOMP_OUTDIR}/rerconverge/rer_results/"rerconverge_summary_*.tsv 2>/dev/null | head -n1 || true)"
fi

if [ "${PRECOMP_USE_FADE:-false}" = true ]; then
    FADE_JSON_DIR_TOP="${PRECOMP_OUTDIR}/selection/fade/top/json"
    FADE_JSON_DIR_BOTTOM="${PRECOMP_OUTDIR}/selection/fade/bottom/json"
    # summary/site TSVs are optional emits — only exist if FADE's report step actually
    # produced them for the source run.
    SCORING_FADE_SUMMARY_TOP="${PRECOMP_OUTDIR}/selection/fade/top/fade_summary_top.tsv"
    SCORING_FADE_SUMMARY_BOTTOM="${PRECOMP_OUTDIR}/selection/fade/bottom/fade_summary_bottom.tsv"
    SCORING_FADE_SITE_TOP="${PRECOMP_OUTDIR}/selection/fade/top/fade_site_bf_top.tsv"
    SCORING_FADE_SITE_BOTTOM="${PRECOMP_OUTDIR}/selection/fade/bottom/fade_site_bf_bottom.tsv"
fi

if [ "${PRECOMP_USE_VEP:-false}" = true ]; then
    # only exist if the source run had the matching DB (PrimateAI-3D/COSMIC) configured.
    SCORING_VEP_PRIMATEAI="${PRECOMP_OUTDIR}/vep/primateai_mapped.tsv"
    SCORING_VEP_COSMIC="${PRECOMP_OUTDIR}/vep/cosmic_scores.tsv"
fi

{% if resources.process_overrides %}
# Per-process cpus/memory overrides from the Resources tab's advanced table.
# Nextflow only reads these from a config file, never from --flags, so this is
# generated here and loaded last via -c below (last-defined selector wins),
# overriding conf/resources.config's own per-process defaults where set.
RESOURCES_OVERRIDE="$WORK_DIR/resources.override.config"
cat > "$RESOURCES_OVERRIDE" <<'EOF'
process {
{% for o in resources.process_overrides %}
    {{ o.selector_type }}: '{{ o.selector }}' {
{% if o.cpus %}        cpus   = { {{ o.cpus }} }
{% endif %}
{% if o.memory %}        memory = { {{ o.memory }} }
{% endif %}
    }
{% endfor %}
}
EOF
{% endif %}

# --- NEXTFLOW FLAGS ---
NF_FLAGS=(
    -profile {{ profile }}
{% if resources.process_overrides %}
    -c "$RESOURCES_OVERRIDE"
{% endif %}
)
if [ "${RUN_TOWER:-{{ run_defaults.tower }}}" = true ]; then
    NF_FLAGS+=( -with-tower )
fi
NF_FLAGS+=(
    -name "${TRAIT}${RUN_TAG}_$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-' | cut -c1-8 || printf '%08x' $RANDOM)"
    --alignment "$ALI_DIR"
    --ali_format "${ALI_FORMAT:-fasta}"
    --tree "$TREE_FILE"
    --outdir "$RESULTS_BASE"
    --seed "$SEED"
    --max_cpus "$MAX_CPUS"
    --max_memory "$MAX_MEMORY"
    --max_time "$MAX_TIME"
    --sp_colname "${SP_COLNAME:-species}"
    --clade_name "${CLADE_NAME:-primates}"
    --taxon_of_interest "${TAXON_OF_INTEREST:-family}"
)

# General flags
if [ "$RESUME" = 1 ]; then
    NF_FLAGS+=( -resume )
fi

if [ "${TOY_MODE:-{{ run_defaults.toy_mode }}}" = true ]; then
    NF_FLAGS+=(
        --toy_mode
        --toy_n "$TOY_N"
    )
fi

# conf/common.config defaults reporting/ct_disambiguation/ct_postproc/ct_accumulation/
# vep/posenrich to `?: true` — omitting a bare --flag when a GUI toggle is off does
# NOT disable them at the Nextflow level, it just silently falls back to their
# true default. Every flag with a `?: true` config default is therefore emitted
# with an explicit true/false value below, unconditionally, rather than only
# being added when its module is on (see the CT_POSTPROC/VEP incident this fixed).
NF_FLAGS+=( --reporting "${RUN_REPORTING:-{{ run_defaults.reporting }}}" )

if [ "${RUN_CAAS:-{{ run_defaults.caas }}}" = true ]; then
    NF_FLAGS+=(
        --contrast_selection
        --ct_tool "{{ ct_tool_string }}"
        --caas_config "$CAAS_CONFIG"
        --patterns "${PATTERNS:-1,2,3}"
        --perms_cycles "$PERMS_CYCLES"
        --caas_permulation_enrichment {{ run_defaults.caas_permulation_enrichment }}
        --caas_full_perms "$CAAS_FULL_PERMS"
        --top_quantile "${TOP_QUANTILE:-0.90}"
        --bottom_quantile "${BOTTOM_QUANTILE:-0.10}"
        --contrast_max_iter "${CONTRAST_MAX_ITER:-3}"
        --min_contrasts "${MIN_CONTRASTS:-3}"
        --publish_intermediates {{ run_defaults.publish_intermediates }}
        --ct_discovery_batch_size "${CT_DISCOVERY_BATCH_SIZE:-25}"
        --ct_bootstrap_batch_size "${CT_BOOTSTRAP_BATCH_SIZE:-10}"
        --min_divergent_fraction "${MIN_DIVERGENT_FRACTION:-0.5}"
        --max_bg_gaps_fraction "${MAX_BG_GAPS_FRACTION:-0.0}"
        --max_fg_gaps_fraction "${MAX_FG_GAPS_FRACTION:-0.0}"
        --max_gaps_fraction "${MAX_GAPS_FRACTION:-0.0}"
        --max_bg_miss_fraction "${MAX_BG_MISS_FRACTION:-0.0}"
        --max_fg_miss_fraction "${MAX_FG_MISS_FRACTION:-0.0}"
        --max_miss_fraction "${MAX_MISS_FRACTION:-0.0}"
        --miss_pair {{ run_defaults.miss_pair }}
        --caap_mode {{ run_defaults.caap_mode }}
        --fgsize "${FGSIZE:-6}"
        --bgsize "${BGSIZE:-6}"
        --perm_strategy "${PERM_STRATEGY:-BM}"
        --chunk_size "${CHUNK_SIZE:-500}"
        --include_b0 {{ run_defaults.include_b0 }}
        --alpha_threshold "${ALPHA_THRESHOLD:-0.05}"
        --export_groups {{ run_defaults.export_groups }}
        --export_perm_discovery {{ run_defaults.export_perm_discovery }}
{% if modules.caas.extra_flags %}
        {{ modules.caas.extra_flags }}
{% endif %}
    )
    [ -n "${TRAITVALUES:-}" ] && NF_FLAGS+=(--traitvalues "$TRAITVALUES")
else
    # conf/ct.config defaults ct_tool to "discovery,resample,bootstrap" (same `?: true`-
    # style gotcha as reporting/ct_disambiguation/etc — see the note above), so leaving
    # --ct_tool unset here does NOT turn CT() off: main.nf's `if (params.ct_tool)` stays
    # true, CT() still runs, and since neither --contrast_selection nor --caas_config is
    # passed in this branch it immediately hits ct.nf's `assert params.caas_config :
    # "CT workflow requires --caas_config."` — the crash this fixes, hit by every
    # precomputed-CT-reuse run (Precomputed Run tab's Discovery/Resample/Bootstrap boxes,
    # or a _complete pass reusing an _exploratory sibling's CAAS output) before this line
    # existed. An explicit empty string makes params.ct_tool falsy in Groovy, so CT()
    # is skipped entirely — CT_SIGNIFICATION/CT_DISAMBIGUATION still pick up
    # discovery_from/bootstrap_from/background_input/disambiguation_input directly from
    # params (see workflows/ct_signification.nf), independent of CT() ever running.
    # Must be `--ct_tool=` (one array element, embedded `=`), NOT `--ct_tool ""` (two
    # elements) — Nextflow's CLI parser treats a space-separated empty value as a bare
    # boolean flag (params.ct_tool becomes Boolean true, still truthy!); only the
    # `--flag=` form actually delivers a real, Elvis-proof empty string. Verified
    # directly against this repo's conf/ct.config before landing this fix.
    NF_FLAGS+=( --ct_tool= )
    [ -n "${DISCOVERY_FROM:-}" ] && NF_FLAGS+=(--discovery_from "$DISCOVERY_FROM")
    [ -n "${RESAMPLE_FROM:-}" ] && NF_FLAGS+=(--resample_from "$RESAMPLE_FROM")
    [ -n "${BOOTSTRAP_FROM:-}" ] && NF_FLAGS+=(--bootstrap_from "$BOOTSTRAP_FROM")
fi

# ct_disambiguation and ct_postproc both default true in conf/common.config, so both
# are always passed explicitly (see the note above) regardless of which branch below
# runs — ct_postproc's own toggle (disambig.ct_postproc) is independent of whether
# Disambiguation itself is enabled, so both it and its own params (below) are emitted
# unconditionally rather than nested inside "if RUN_DISAMBIGUATION" — a _complete run
# reusing an _exploratory pass needs ct_postproc to run with Disambiguation OFF.
NF_FLAGS+=( --ct_disambiguation "${RUN_DISAMBIGUATION:-{{ run_defaults.disambiguation }}}" )
NF_FLAGS+=( --ct_postproc "${RUN_CT_POSTPROC:-{{ run_defaults.ct_postproc }}}" )
# asr_robustness also defaults true in conf/ct_disambiguation.config — see the note
# above. Not meaningful without live Disambiguation or a precomputed disambiguation_dir,
# so a _complete reuse pass (which already got its ASR robustness report during
# _exploratory, from the same underlying disambiguation data) sets ASR_ROBUSTNESS=false.
NF_FLAGS+=( --asr_robustness "${ASR_ROBUSTNESS:-{{ run_defaults.asr_robustness }}}" )

if [ "${RUN_DISAMBIGUATION:-{{ run_defaults.disambiguation }}}" = true ]; then
    NF_FLAGS+=(
        --ct_disambig_asr_mode "$ASR_MODE"
        --ct_disambig_asr_model "${ASR_MODEL:-lg}"
        --ct_disambig_asr_cache_dir "$ASR_CACHE_DIR"
        --ct_disambig_convergence_mode "${CONVERGENCE_MODE:-focal_clade}"
        --ct_disambig_posterior_threshold "${POSTERIOR_THRESHOLD:-0.1}"
        --ct_disambig_max_tasks_per_child "${MAX_TASKS_PER_CHILD:-50}"
    )
{% if modules.disambiguation.extra_flags %}
    NF_FLAGS+=({{ modules.disambiguation.extra_flags }})
{% endif %}
else
    # Standalone mode: when skipping upstream CT/Disambiguation, pass precomputed inputs
    # (populated above for a _complete pass reusing _exploratory's output, or from the
    # Precomputed Run tab otherwise).
    [ -n "${SIGNIFICATION_FROM:-}" ] && NF_FLAGS+=(--signification_from "$SIGNIFICATION_FROM")
    [ -n "${DISAMBIGUATION_INPUT:-}" ] && NF_FLAGS+=(--disambiguation_input "$DISAMBIGUATION_INPUT")
    [ -n "${DISAMBIGUATION_DIR:-}" ] && NF_FLAGS+=(--disambiguation_dir "$DISAMBIGUATION_DIR")
    [ -n "${BACKGROUND_INPUT:-}" ] && NF_FLAGS+=(--background_input "$BACKGROUND_INPUT")
fi

if [ "${RUN_CT_POSTPROC:-{{ run_defaults.ct_postproc }}}" = true ]; then
    NF_FLAGS+=(
        --caas_postproc_mode "$POSTPROC_MODE"
        --filter_minlen "$POSTPROC_MINLEN"
        --filter_maxcaas "$POSTPROC_MAXCAAS"
        --gene_filter_mode "$POSTPROC_GENE_FILTER_MODE"
        --minlen_values "${POSTPROC_MINLEN_VALUES:-2,3,4,10}"
        --maxcaas_values "${POSTPROC_MAXCAAS_VALUES:-0.6,0.7,0.8}"
        --extreme_threshold "${POSTPROC_EXTREME_THRESHOLD:-0.99}"
        --iqr_multiplier "${POSTPROC_IQR_MULTIPLIER:-3.0}"
    )
    # ct_postproc.nf's characterization report step always runs when --ct_postproc
    # is on (its gate is `if (true)`, unconditional — see workflows/ct_postproc.nf)
    # and asserts params.gene_ensembl_file regardless of gene_filter_mode. This
    # can't be left gated behind the "if RUN_SCORING" block below: exploratory
    # mode forces RUN_SCORING=false above, so without this line gene_ensembl_file
    # never reaches Nextflow even when it's set on the Scoring tab, and the run
    # fails with "Error: --gene_ensembl_file is required for characterization
    # reports" (or "...for gene filtering" if gene_filter_mode != 'none' too).
    NF_FLAGS+=( --gene_ensembl_file "$GENE_ENSEMBL_FILE" )
fi

# ct_accumulation also defaults true in conf/common.config — see the note above.
NF_FLAGS+=( --ct_accumulation "${RUN_ACCUMULATION:-{{ run_defaults.accumulation }}}" )

if [ "${RUN_ACCUMULATION:-{{ run_defaults.accumulation }}}" = true ]; then
    NF_FLAGS+=(
        --accumulation_n_randomizations "$N_RANDOMIZATIONS"
        --accumulation_randomization_type "${ACCUMULATION_RANDOMIZATION_TYPE:-cons_decile}"
        --accumulation_seed "${ACCUMULATION_SEED:-1998}"
        --ct_disambig_asr_mode "$ASR_MODE"
        --ct_disambig_asr_cache_dir "$ASR_CACHE_DIR"
        --accumulation_entropy_dir "$ENTROPY_DIR"
        --accumulation_fdr "${ACCUMULATION_FDR:-0.1}"
        --accumulation_pval_threshold "${ACCUMULATION_PVAL_THRESHOLD:-0.05}"
        --accumulation_report_pval_threshold "${ACCUMULATION_REPORT_PVAL_THRESHOLD:-0.05}"
{% if modules.accumulation.extra_flags %}
        {{ modules.accumulation.extra_flags }}
{% endif %}
    )
else
    [ -n "${ACCUMULATION_CAAS_INPUT:-}" ] && NF_FLAGS+=(--accumulation_caas_input "$ACCUMULATION_CAAS_INPUT")
    [ -n "${ACCUMULATION_BACKGROUND_INPUT:-}" ] && NF_FLAGS+=(--accumulation_background_input "$ACCUMULATION_BACKGROUND_INPUT")
fi

# RERConverge Flags
if [ "${RUN_RER:-{{ run_defaults.rer }}}" = true ]; then
    NF_FLAGS+=(
        --rer_tool "${RER_TOOL}"
        --gene_trees "${GENE_TREES}"
        --rer_perm_batches "${RER_PERM_BATCHES}"
        --rer_perms_per_batch "${RER_PERMS_PER_BATCH}"
        --rer_minsp "${RER_MINSP:-15}"
        --winsorizeRER "${WINSORIZE_RER:-3}"
        --winsorizeTrait "${WINSORIZE_TRAIT:-3}"
        --rer_trait_mode "${RER_TRAIT_MODE:-auto}"
        --rer_binary_clade "${RER_BINARY_CLADE:-all}"
        --rer_min_pos "${RER_MIN_POS:-2}"
        --rer_pval_threshold "${RER_PVAL_THRESHOLD:-0.05}"
        --rer_pval_column "${RER_PVAL_COLUMN:-p.perm}"
        --rer_top_n_labels "${RER_TOP_N_LABELS:-20}"
        --rer_transform "${RER_TRANSFORM:-ha_logit}"
{% if modules.rer.extra_flags %}
        {{ modules.rer.extra_flags }}
{% endif %}
    )
    [ -n "${TRAIT_OUT:-}" ] && NF_FLAGS+=(--trait_out "$TRAIT_OUT")
    [ -n "${TREES_OUT:-}" ] && NF_FLAGS+=(--trees_out "$TREES_OUT")
    [ -n "${MATRIX_OUT:-}" ] && NF_FLAGS+=(--matrix_out "$MATRIX_OUT")
    [ -n "${RER_UNIVERSE_FILE:-}" ] && NF_FLAGS+=(--rer_universe_file "$RER_UNIVERSE_FILE")
    [ -n "${RER_GENE_SCORES:-}" ] && NF_FLAGS+=(--rer_gene_scores "$RER_GENE_SCORES")
else
    [ -n "${RER_CONTINUOUS_FILE:-}" ] && NF_FLAGS+=(--rer_continuous_file "$RER_CONTINUOUS_FILE")
    [ -n "${RER_PERMS_FILE:-}" ] && NF_FLAGS+=(--rer_perms_file "$RER_PERMS_FILE")
fi

# FADE Flags
if [ "${RUN_FADE:-{{ run_defaults.fade }}}" = true ]; then
    NF_FLAGS+=(
        --fade
        --fade_mode "${FADE_MODE}"
        --selection_prep_batch_size "${SELECTION_PREP_BATCH_SIZE:-500}"
        --fade_batch_size "${FADE_BATCH_SIZE:-200}"
        --fade_bf_threshold "${FADE_BF_THRESHOLD:-100}"
        --fade_model "${FADE_MODEL:-LG}"
        --fade_method "${FADE_METHOD:-Variational-Bayes}"
        --fade_grid "${FADE_GRID:-20}"
        --fade_chains "${FADE_CHAINS:-5}"
        --fade_chain_length "${FADE_CHAIN_LENGTH:-2000000}"
        --fade_burn_in "${FADE_BURN_IN:-1000000}"
        --fade_samples "${FADE_SAMPLES:-1000}"
        --fade_concentration "${FADE_CONCENTRATION:-0.5}"
        --fade_min_genes_for_heatmap "${FADE_MIN_GENES_FOR_HEATMAP:-2}"
{% if modules.fade.extra_flags %}
        {{ modules.fade.extra_flags }}
{% endif %}
    )
    [ -n "${FADE_POSTPROC_TOP:-}" ] && NF_FLAGS+=(--fade_postproc_top "$FADE_POSTPROC_TOP")
    [ -n "${FADE_POSTPROC_BOTTOM:-}" ] && NF_FLAGS+=(--fade_postproc_bottom "$FADE_POSTPROC_BOTTOM")
    [ -n "${LG_DAT_PATH:-}" ] && NF_FLAGS+=(--lg_dat_path "$LG_DAT_PATH")
    [ -n "${FADE_UNIVERSE_FILE:-}" ] && NF_FLAGS+=(--fade_universe_file "$FADE_UNIVERSE_FILE")
else
    [ -n "${FADE_JSON_DIR_TOP:-}" ] && NF_FLAGS+=(--fade_json_dir_top "$FADE_JSON_DIR_TOP")
    [ -n "${FADE_JSON_DIR_BOTTOM:-}" ] && NF_FLAGS+=(--fade_json_dir_bottom "$FADE_JSON_DIR_BOTTOM")
fi

# Scoring Flags
if [ "${RUN_SCORING:-{{ run_defaults.scoring }}}" = true ]; then
    NF_FLAGS+=(
        --scoring
        --scoring_window_size_bp "${SCORING_WINDOW_SIZE_BP:-1000000}"
        --gene_ensembl_file "${GENE_ENSEMBL_FILE}"
        --scoring_stress_top_n "${SCORING_STRESS_TOP_N:-25}"
        --scoring_stress_rank_metric "${SCORING_STRESS_RANK_METRIC:-spearman}"
        --scoring_position_top_pct "${SCORING_POSITION_TOP_PCT:-0.10}"
        --scoring_gene_top_pct "${SCORING_GENE_TOP_PCT:-0.10}"
{% if modules.scoring.extra_flags %}
        {{ modules.scoring.extra_flags }}
{% endif %}
    )
    if [ "${RUN_SCORING_STRESS:-{{ run_defaults.scoring_stress }}}" = true ]; then
        NF_FLAGS+=(--scoring_stress)
    fi
else
    [ -n "${SCORING_POSTPROC_INPUT:-}" ] && NF_FLAGS+=(--scoring_postproc_input "$SCORING_POSTPROC_INPUT")
    [ -n "${SCORING_ACCUM_DIR:-}" ] && NF_FLAGS+=(--scoring_accum_dir "$SCORING_ACCUM_DIR")
    [ -n "${SCORING_VEP_PRIMATEAI:-}" ] && NF_FLAGS+=(--scoring_vep_primateai "$SCORING_VEP_PRIMATEAI")
    [ -n "${SCORING_BACKGROUND_INPUT:-}" ] && NF_FLAGS+=(--scoring_background_input "$SCORING_BACKGROUND_INPUT")
    [ -n "${CAAS_PERMS_FILE:-}" ] && NF_FLAGS+=(--caas_perms_file "$CAAS_PERMS_FILE")
fi

# VEP Flags
# vep also defaults true in conf/common.config — see the note above.
NF_FLAGS+=( --vep "${RUN_VEP:-{{ run_defaults.vep }}}" )

if [ "${RUN_VEP:-{{ run_defaults.vep }}}" = true ]; then
    NF_FLAGS+=(
        --vep_primateai_db "${VEP_PRIMATEAI_DB}"
        --vep_map_dir "${MAP_DIR}"
        --cosmic_db "${COSMIC_DB:-}"
{% if modules.vep.extra_flags %}
        {{ modules.vep.extra_flags }}
{% endif %}
    )
else
    [ -n "${VEP_CAAS_INPUT:-}" ] && NF_FLAGS+=(--vep_caas_input "$VEP_CAAS_INPUT")
fi

# Enrichment Flags
if [ "${RUN_ENRICHMENT:-{{ run_defaults.enrichment }}}" = true ]; then
    NF_FLAGS+=(
        --enrichment
        --gmt_dir "${GMT_DIR}"
        --fcs_min_genes "${FCS_MIN_GENES:-5}"
        --fcs_fdr "${FCS_FDR:-0.15}"
        --fcs_pperm_thr "${FCS_PPERM_THR:-0.025}"
        --fcs_top_n "${FCS_TOP_N:-20}"
        --rer_permulation_enrichment {{ run_defaults.rer_permulation_enrichment }}
        --string_db_dir "${STRING_DB_DIR:-}"
        --string_species "${STRING_SPECIES:-9606}"
        --scoring_ami {{ run_defaults.scoring_ami }}
        --scoring_string {{ run_defaults.scoring_string }}
        --domino_network_score_thr "${DOMINO_NETWORK_SCORE_THR:-700}"
        --domino_slice_thr "${DOMINO_SLICE_THR:-0.3}"
        --domino_module_thr "${DOMINO_MODULE_THR:-0.05}"
        --scoring_compare_fdr "${SCORING_COMPARE_FDR:-0.15}"
        --scoring_compare_top_n "${SCORING_COMPARE_TOP_N:-20}"
{% if modules.enrichment.extra_flags %}
        {{ modules.enrichment.extra_flags }}
{% endif %}
    )
else
    [ -n "${ACCUMULATION_ENRICHMENT_GENE_LISTS_INPUT:-}" ] && NF_FLAGS+=(--accumulation_enrichment_gene_lists_input "$ACCUMULATION_ENRICHMENT_GENE_LISTS_INPUT")
fi

# POSENRICH (position-wise enrichment) flags
# posenrich also defaults true in conf/common.config — see the note above.
NF_FLAGS+=( --posenrich "${RUN_POSENRICH:-{{ run_defaults.posenrich }}}" )

if [ "${RUN_POSENRICH:-{{ run_defaults.posenrich }}}" = true ]; then
    NF_FLAGS+=(
        --egg_members_file "${EGG_MEMBERS_FILE}"
        --egg_annotations_file "${EGG_ANNOTATIONS_FILE}"
        --cosmic_db "${COSMIC_DB}"
        --domain_variability_file "${DOMAIN_VARIABILITY_FILE}"
        --ucr_positions_file "${UCR_POSITIONS_FILE}"
        --fubar_sites_file "${FUBAR_SITES_FILE}"
        --posenrich_min_size "${POSENRICH_MIN_SIZE:-5}"
        --posenrich_max_size "${POSENRICH_MAX_SIZE:-0}"
        --posenrich_padj_thr "${POSENRICH_PADJ_THR:-0.15}"
        --posenrich_fold_thr "${POSENRICH_FOLD_THR:-1.5}"
    )
else
    [ -n "${POSENRICH_BACKGROUND_FILE:-}" ] && NF_FLAGS+=(--posenrich_background_file "$POSENRICH_BACKGROUND_FILE")
fi

# Species and Tax ID Flags
[ -n "${ALI_SP_NAMES:-}" ] && NF_FLAGS+=(--ali_sp_names "$ALI_SP_NAMES")
[ -n "${INPUT_TAX_ID:-}" ] && NF_FLAGS+=(--tax_id "$INPUT_TAX_ID")

# Precomputed FADE/RER summaries for scoring
[ -n "${SCORING_RER_INPUT:-}" ] && NF_FLAGS+=(--scoring_rer_input "$SCORING_RER_INPUT")
[ -n "${SCORING_RER_PERMS_INPUT:-}" ] && NF_FLAGS+=(--rer_perms_file "$SCORING_RER_PERMS_INPUT")
[ -n "${SCORING_FADE_SUMMARY_TOP:-}" ] && NF_FLAGS+=(--scoring_fade_summary_top "$SCORING_FADE_SUMMARY_TOP")
[ -n "${SCORING_FADE_SUMMARY_BOTTOM:-}" ] && NF_FLAGS+=(--scoring_fade_summary_bottom "$SCORING_FADE_SUMMARY_BOTTOM")
[ -n "${SCORING_FADE_SITE_TOP:-}" ] && NF_FLAGS+=(--scoring_fade_site_top "$SCORING_FADE_SITE_TOP")
[ -n "${SCORING_FADE_SITE_BOTTOM:-}" ] && NF_FLAGS+=(--scoring_fade_site_bottom "$SCORING_FADE_SITE_BOTTOM")
[ -n "${SCORING_VEP_COSMIC:-}" ] && NF_FLAGS+=(--scoring_vep_cosmic "$SCORING_VEP_COSMIC")

# --- CLASS-SPECIFIC FLAGS ---
if [ "$CLASS" = "1" ]; then
    NF_FLAGS+=(
        --my_traits "$TRAIT_FILE"
        --traitname "$TRAIT"
        --secondary_trait "$SECONDARY_TRAIT"
        --n_trait "$N_TRAIT"
        --c_trait "$C_TRAIT"
        --branch_trait "$BRANCH_TRAIT"
    )
    # Pruning is triggered by this phenotype specifying a prune list, not by a
    # separate manual toggle — a row with no PRUNE_FILE just isn't pruned.
    if [ -n "$PRUNE_FILE" ]; then
        NF_FLAGS+=(
            --prune_data
            --prune_list "${PRUNE_DIR}/${PRUNE_FILE}"
        )
        [ -n "$PRUNE_SECONDARY_FILE" ] && NF_FLAGS+=(--prune_list_secondary "${PRUNE_DIR}/${PRUNE_SECONDARY_FILE}")
    fi
elif [ "$CLASS" = "2" ]; then
    NF_FLAGS+=(
        --my_traits "$SIMPLE_TRAIT_FILE"
        --traitname "$TRAIT"
        --branch_trait "$BRANCH_TRAIT"
        --discrete_method "$DISCRETE_METHOD"
        --n_trait ""
        --c_trait ""
        --secondary_trait ""
    )
else
    echo "Error: CLASS must be 1 or 2, got: $CLASS"
    exit 1
fi

echo "======================================================"
echo "Running Nextflow Single Phenotype: $TRAIT"
echo "SLURM TASK ID     : ${SLURM_ARRAY_TASK_ID:-n/a}"

echo "Profile           : {{ profile }}"
echo "Trait             : $TRAIT  [CLASS $CLASS]"
echo "Alignments        : $ALI_DIR"
echo "Output            : $RESULTS_BASE"
echo "Work dir          : $WORK_DIR"

echo "Resuming?         : $([ "$RESUME" = 1 ] && echo yes || echo 'no (clean run)')"
echo "======================================================"

nextflow run "${REPO_DIR}/main.nf" "${NF_FLAGS[@]}" -w "$WORK_DIR"

if [ -f "${RESULTS_BASE}/low_contrasts.skip" ]; then
    echo "Warning: Skipped '${TRAIT}': too few foreground contrasts."
    exit 0
fi

echo "Success: Completed $TRAIT [CLASS $CLASS]"
