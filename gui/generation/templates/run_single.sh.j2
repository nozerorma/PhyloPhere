# ── Nextflow engine flags ─────────────────────────────────────────────────────
# Only Nextflow engine flags (single dash) go on the command line; the pipeline
# parameters (double dash) are in params.json above.
NF_ENGINE=(
    -params-file "$PARAMS_JSON"
    -profile {{ profile }}
{% if resources.process_overrides %}
    -c "$RESOURCES_OVERRIDE"
{% endif %}
    -w "$WORK_DIR"
)
if [ "${RUN_TOWER:-{{ run_defaults.tower }}}" = true ]; then
    NF_ENGINE+=( -with-tower )
fi
NF_ENGINE+=(
    -name "${TRAIT}${RUN_TAG}_$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-' | cut -c1-8 || printf '%08x' $RANDOM)"
)
if [ "$RESUME" = 1 ]; then
    NF_ENGINE+=( -resume )
fi

# ── Extra flags (extra_flags fields of the GUI) ───────────────────────────────
# Free-form Nextflow flags given by the user. They may be engine flags or parameter
# overrides, which cannot go in params.json, so they stay on the command line and take
# precedence over both params.json and the config defaults.
{% if modules.caas.extra_flags %}
if [ "$_RUN_CAAS" = true ]; then
    NF_ENGINE+=({{ modules.caas.extra_flags }})
fi
{% endif %}
{% if modules.disambiguation.extra_flags %}
if [ "$_RUN_DISAMBIGUATION" = true ]; then
    NF_ENGINE+=({{ modules.disambiguation.extra_flags }})
fi
{% endif %}
{% if modules.rer.extra_flags %}
if [ "$_RUN_RER" = true ]; then
    NF_ENGINE+=({{ modules.rer.extra_flags }})
fi
{% endif %}
{% if modules.fade.extra_flags %}
if [ "$_RUN_FADE" = true ]; then
    NF_ENGINE+=({{ modules.fade.extra_flags }})
fi
{% endif %}
{% if modules.scoring.extra_flags %}
if [ "$_RUN_SCORING" = true ]; then
    NF_ENGINE+=({{ modules.scoring.extra_flags }})
fi
{% endif %}
{% if modules.vep.extra_flags %}
if [ "$_RUN_VEP" = true ]; then
    NF_ENGINE+=({{ modules.vep.extra_flags }})
fi
{% endif %}
{% if modules.posenrich.extra_flags %}
if [ "$_RUN_POSENRICH" = true ]; then
    NF_ENGINE+=({{ modules.posenrich.extra_flags }})
fi
{% endif %}
{% if modules.enrichment.extra_flags %}
if [ "$_RUN_ENRICHMENT" = true ]; then
    NF_ENGINE+=({{ modules.enrichment.extra_flags }})
fi
{% endif %}

echo "======================================================"
echo "Running Nextflow Single Phenotype: $TRAIT"
echo "SLURM TASK ID     : ${SLURM_ARRAY_TASK_ID:-n/a}"

echo "Profile           : {{ profile }}"
echo "Trait             : $TRAIT"
echo "Alignments        : $ALI_DIR"
echo "Output            : $RESULTS_BASE"
echo "Work dir          : $WORK_DIR"
echo "Params file       : $PARAMS_JSON"

echo "Resuming?         : $([ "$RESUME" = 1 ] && echo yes || echo 'no (clean run)')"
echo "======================================================"

nextflow run "${REPO_DIR}/main.nf" "${NF_ENGINE[@]}"

# remove_work: reached only when nextflow run exited 0 (set -e aborts earlier otherwise, so a failed run
# keeps work/ for debugging and -resume). Both passes of a two-pass run tag RUN_TAG, hence have their own
# WORK_DIR, RUN_DIR and NXF_HOME, and the complete pass reads the exploratory pass from its published outdir.
cleanup_work() {
    # Validate every target before deleting any directory. Published results and source code must survive.
    local base target results repo candidate
    base=$(realpath -m -- "${WORK_BASE:?}")
    results=$(realpath -m -- "${RESULTS_BASE:?}")
    repo=$(realpath -m -- "${REPO_DIR:?}")
    for candidate in "${WORK_DIR:?}" "${RUN_DIR:?}" "${NXF_HOME:?}"; do
        target=$(realpath -m -- "$candidate")
        case "$target" in "$base"/*) ;; *) echo "[cleanup] Refusing target outside work base: $target" >&2; return 1;; esac
        case "$results/" in "$target/"*) echo "[cleanup] Refusing to remove published results: $target" >&2; return 1;; esac
        case "$repo/" in "$target/"*) echo "[cleanup] Refusing to remove source code: $target" >&2; return 1;; esac
    done
    echo "[cleanup] Removing the Nextflow work directories of '${TRAIT}${RUN_TAG}': $WORK_DIR"
    # The run directory is the cwd of this script; its Nextflow log is kept with the results before it goes.
    mkdir -p "${RESULTS_BASE}/pipeline_info"
    cp "${RUN_DIR:?}/.nextflow.log" "${RESULTS_BASE}/pipeline_info/nextflow.log" 2>/dev/null || true
    cd "$REPO_DIR"
    rm -rf "${WORK_DIR:?}" "${RUN_DIR:?}" "${NXF_HOME:?}"
}

if [ -f "${RESULTS_BASE}/low_contrasts.skip" ]; then
    echo "Warning: Skipped '${TRAIT}': too few foreground contrasts."
    if [ "$_REMOVE_WORK" = true ]; then cleanup_work; fi
    exit 0
fi

if [ "$_REMOVE_WORK" = true ]; then cleanup_work; fi

echo "Success: Completed $TRAIT"
