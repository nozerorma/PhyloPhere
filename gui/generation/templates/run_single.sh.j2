#!/bin/bash
set -Eeuo pipefail

# Generated by the PhyloPhere runner GUI — edit the project file and regenerate
# rather than hand-editing this file, unless you're making a one-off tweak.

# --- ARGUMENTS ---
CLASS="${1:?Usage: $0 <CLASS> <TRAIT> [SECONDARY_TRAIT] [N_TRAIT] [C_TRAIT] [PRUNE_FILE] [PRUNE_SECONDARY_FILE] [TRAIT_TYPE]}"
TRAIT="${2:?TRAIT must be provided}"
SECONDARY_TRAIT="${3:-}"
N_TRAIT="${4:-}"
C_TRAIT="${5:-}"
PRUNE_FILE="${6:-}"
PRUNE_SECONDARY_FILE="${7:-}"
TRAIT_TYPE="${8:-}"   # "" / auto = infer, ordinal = coded fg/bg, continuous = force PSS

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
timestamp=$(date +%Y%m%d_%H%M%S)

# --- ENV ACTIVATION ---
source ~/.bashrc
conda deactivate
conda activate phylophere

# Setup unique Nextflow home directory to avoid file lock collisions on history database
export NXF_HOME="$WORK_BASE/.nextflow/.nextflow_${TRAIT}"
mkdir -p "$NXF_HOME"
ln -sfn "{{ general.nextflow_plugins_dir }}" "$NXF_HOME/plugins"

# Create and cd into a unique run directory to prevent Nextflow session/cache database lock collisions
RUN_DIR="$WORK_BASE/${TRAIT}_nxf_run"
mkdir -p "$RUN_DIR"
cd "$RUN_DIR"

if [ "${POSTPROC_MODE:-}" = "exploratory" ]; then
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}_exploratory"
    RUN_TAG="_exploratory"
    # Exploratory only sweeps minlen_values x maxcaas_values and stops there — every
    # downstream module (and RER/FADE, neither of which even depend on postproc) waits
    # for the _complete pass. If RER/FADE are enabled in the project, they run there.
    RUN_ACCUMULATION=false
    RUN_VEP=false
    RUN_FADE=false
    RUN_RER=false
    RUN_SCORING=false
elif [ "${POSTPROC_MODE:-}" = "filter" ]; then
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}_complete"
    RUN_TAG="_complete"
{% if reuse_exploratory %}
    # An _exploratory pass was generated alongside this script — reuse its already-computed
    # CAAS/Disambiguation output by file instead of recomputing it (no -resume/shared-workdir
    # reliance): CT discovery/resample/bootstrap and live Disambiguation are both switched off,
    # and CT_POSTPROC (still on, now applying the single chosen filter_minlen/filter_maxcaas
    # pair instead of the exploratory sweep) reads Disambiguation's master CSV + background
    # genes straight from the _exploratory outdir. ASR robustness was already produced during
    # _exploratory (same disambiguation data), so it's not regenerated here.
    RUN_CAAS=false
    RUN_DISAMBIGUATION=false
    ASR_ROBUSTNESS=false
    EXPLORATORY_OUTDIR="${CAAS_OUTBASE}/${TRAIT}${TAG}_exploratory"
    DISAMBIGUATION_INPUT="${EXPLORATORY_OUTDIR}/ct_disambiguation/caas_convergence_master.csv"
    DISAMBIGUATION_DIR="${EXPLORATORY_OUTDIR}/ct_disambiguation"
    BACKGROUND_INPUT="${EXPLORATORY_OUTDIR}/caastools/background_genes.output"
    # background.output (tested positions, gene<TAB>comma-sep cols) is the
    # position-level analogue of background_genes.output — posenrich_enrich.py
    # needs it to build its background position set. PRECOMP_USE_DISCOVERY
    # already sets this same variable when reusing a prior full run; mirror it
    # here so the _complete pass (which skips live CT) passes it through rather
    # than falling back to the NO_FILE sentinel and crashing.
    POSENRICH_BACKGROUND_FILE="${EXPLORATORY_OUTDIR}/caastools/background.output"

    # CAAS permulation-excess null. CAAS_PERMULATION only runs where CT ran — i.e.
    # the _exploratory pass — but SCORING/ENRICHMENT, which consume it, run only
    # here. Point them at _exploratory's published outputs, exactly as the tree /
    # trait / background substitutions above do. Without this the CAAS FCS p.perm
    # and the report's position-level permulation section silently come out empty
    # even though the (expensive) permulation null was already computed.
    CAAS_PERMS_FILE="${EXPLORATORY_OUTDIR}/caas_permulation/caas_perms.rds"
    CAAS_POS_PVAL_FILE="${EXPLORATORY_OUTDIR}/caas_permulation/perm_pos_pval.tsv"
    CAAS_POS_SAMPLE_FILE="${EXPLORATORY_OUTDIR}/caas_permulation/perm_pos_sample.tsv"
    CAAS_POS_QUANTILES_FILE="${EXPLORATORY_OUTDIR}/caas_permulation/perm_pos_quantiles.tsv"
    for _f in "$CAAS_PERMS_FILE" "$CAAS_POS_PVAL_FILE" "$CAAS_POS_SAMPLE_FILE" "$CAAS_POS_QUANTILES_FILE"; do
        [ -f "$_f" ] || echo "[WARN] expected permulation output missing, p.perm will be empty: $_f" >&2
    done
    # When set, SCORING REBUILDS the null from this instead of importing caas_perms.rds
    # as-is (CAAS_PERMS_REBUILD — minutes, no ASR replay). A cached null is only valid
    # while it holds the same gene-level statistic as the observed score; rebuilding
    # guarantees that, and fcs_enrich.R leaves p.perm NA when it does not hold.
    CAAS_POS_DETAIL_FILE="${EXPLORATORY_OUTDIR}/caas_permulation/perm_pos_detail"
    [ -d "$CAAS_POS_DETAIL_FILE" ] || CAAS_POS_DETAIL_FILE="${EXPLORATORY_OUTDIR}/caas_permulation/perm_pos_detail.tsv.gz"  # legacy single-file layout
    [ -e "$CAAS_POS_DETAIL_FILE" ] || {
        echo "[WARN] perm_pos_detail missing: cannot rebuild the null, falling back to the cached caas_perms.rds (p.perm will be NA if it is stale)" >&2
        CAAS_POS_DETAIL_FILE=""
    }

    # REPORTING (dataset exploration + tree name-curation, and pruning for CLASS 1 rows
    # with a PRUNE_FILE) ran identically during _exploratory — same --my_traits/--tree
    # inputs regardless of POSTPROC_MODE — so rerunning it here would only reproduce the
    # same HTML/data_exploration reports a second time. Reuse instead: substitute the
    # tree/trait file the _complete pass hands to Nextflow with _exploratory's already-
    # curated (and, if this row prunes species, already-pruned) output, published
    # unconditionally by TREE_CLEANUP/DATASET_PRUNE regardless of which subworkflow
    # (REPORTING vs CONTRAST_SELECTION) invoked them. Overriding $TREE_FILE/$TRAIT_FILE
    # here — rather than wiring a new main.nf param — means every downstream consumer
    # that already falls back to params.tree (e.g. FADE's SELECTION_PREP) transparently
    # gets the curated tree with no further plumbing. Pruning is CLASS 1-only in this
    # GUI (see the CLASS-specific block below), and 0.Data_pruning.Rmd's pruned_trait_file
    # is a plain row-filtered copy of the original --my_traits file (same columns,
    # tab-separated) — safe to substitute for CLASS 1's own tab-separated TRAIT_FILE;
    # never applies to CLASS 2 (SIMPLE_TRAIT_FILE, comma-separated), which never prunes.
    RUN_REPORTING=false
    PRUNED_TREE_CANDIDATE="${EXPLORATORY_OUTDIR}/data_exploration/0.Data-pruning/pruned_tree_file.nwk"
    if [ -f "$PRUNED_TREE_CANDIDATE" ]; then
        TREE_FILE="$PRUNED_TREE_CANDIDATE"
        TRAIT_FILE="${EXPLORATORY_OUTDIR}/data_exploration/0.Data-pruning/pruned_trait_file.tsv"
    else
        TREE_FILE="${EXPLORATORY_OUTDIR}/name_curation/curated_tree.nwk"
    fi

    # FADE's SELECTION_PREP (subworkflows/SELECTION/selection_prep.nf) falls back to
    # ${outdir}/data_exploration/1.Data-exploration/1.Species_distribution/trait_stats.csv
    # whenever it has no live upstream channel — exactly this pass's situation, since
    # REPORTING is off above. That fallback is always relative to $RESULTS_BASE (this
    # _complete pass's OWN outdir, not _exploratory's), and it doesn't assert the file
    # exists before handing the path to the process — so without this, FADE fails with
    # a bare FileNotFoundError the moment EXTRACT_EXTREME_SPECIES runs. Symlink
    # _exploratory's already-published data_exploration/ in, same idea as the tree/trait
    # substitution above: make the existing fallback path resolve, rather than adding a
    # new main.nf param.
    mkdir -p "$RESULTS_BASE"
    if [ -d "${EXPLORATORY_OUTDIR}/data_exploration" ] && [ ! -e "${RESULTS_BASE}/data_exploration" ]; then
        ln -sfn "${EXPLORATORY_OUTDIR}/data_exploration" "${RESULTS_BASE}/data_exploration"
    fi
{% endif %}
else
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}"
    RUN_TAG=""
fi
WORK_DIR="${WORK_BASE}/${TRAIT}${TAG}"
mkdir -p "${RESULTS_BASE}" "${WORK_DIR}"

# --- PRECOMPUTED REUSE (Precomputed Run tab) ---
# Every path below is base_path/<TRAIT>/<known-subpath> — verified against each
# producing process's actual publishDir, see gui/models/precomputed.py's module
# docstring for the full table. Checking a box in the GUI both sets one of these
# and switches the corresponding module off (via that module's own enable_toggle,
# so RUN_* above already reflects it) — this block only supplies the *value* each
# module's existing precomputed-fallback branch (below) was already able to consume.
PRECOMP_OUTDIR="${PRECOMP_BASE_PATH:-}/${TRAIT}"

if [ "${PRECOMP_USE_DISCOVERY:-false}" = true ]; then
    DISCOVERY_FROM="${PRECOMP_OUTDIR}/caastools/discovery.tab"
    SIGNIFICATION_FROM="${PRECOMP_OUTDIR}/signification/meta_caas/global_meta_caas.tsv"
    [ -f "$SIGNIFICATION_FROM" ] || SIGNIFICATION_FROM="${PRECOMP_OUTDIR}/signification/meta_caas/meta_caas.tsv"
    BACKGROUND_INPUT="${PRECOMP_OUTDIR}/caastools/background_genes.output"
    POSENRICH_BACKGROUND_FILE="${PRECOMP_OUTDIR}/caastools/background.output"
    # These only exist if the source run had --caas_permulation_enrichment on.
    # All four must be wired together: caas_perms.rds alone gives the FCS p.perm but
    # leaves the report's entire position-level permulation section empty, since that
    # section is gated on the per-position files. The reuse_exploratory branch above
    # sets the same four -- keep the two lists in sync.
    CAAS_PERMS_FILE="${PRECOMP_OUTDIR}/caas_permulation/caas_perms.rds"
    CAAS_POS_PVAL_FILE="${PRECOMP_OUTDIR}/caas_permulation/perm_pos_pval.tsv"
    CAAS_POS_SAMPLE_FILE="${PRECOMP_OUTDIR}/caas_permulation/perm_pos_sample.tsv"
    CAAS_POS_QUANTILES_FILE="${PRECOMP_OUTDIR}/caas_permulation/perm_pos_quantiles.tsv"
    # Triggers CAAS_PERMS_REBUILD in SCORING -- see the reuse_exploratory branch for why.
    CAAS_POS_DETAIL_FILE="${PRECOMP_OUTDIR}/caas_permulation/perm_pos_detail"
    [ -d "$CAAS_POS_DETAIL_FILE" ] || CAAS_POS_DETAIL_FILE="${PRECOMP_OUTDIR}/caas_permulation/perm_pos_detail.tsv.gz"  # legacy single-file layout
    [ -e "$CAAS_POS_DETAIL_FILE" ] || {
        echo "[WARN] perm_pos_detail missing: cannot rebuild the null, falling back to the cached caas_perms.rds (p.perm will be NA if it is stale)" >&2
        CAAS_POS_DETAIL_FILE=""
    }
fi
if [ "${PRECOMP_USE_RESAMPLE:-false}" = true ]; then
    RESAMPLE_FROM="${PRECOMP_OUTDIR}/caastools/resample.tab"
fi
if [ "${PRECOMP_USE_BOOTSTRAP:-false}" = true ]; then
    BOOTSTRAP_FROM="${PRECOMP_OUTDIR}/caastools/bootstrap.tab"
fi

if [ "${PRECOMP_USE_DISAMBIGUATION:-false}" = true ]; then
    DISAMBIGUATION_INPUT="${PRECOMP_OUTDIR}/ct_disambiguation/caas_convergence_master.csv"
    DISAMBIGUATION_DIR="${PRECOMP_OUTDIR}/ct_disambiguation"
fi

if [ "${PRECOMP_USE_POSTPROC:-false}" = true ]; then
    # gene_filtering/cleaned_backgrounds only exist if the source run had
    # gene_filter_mode != 'none' (the default).
    ACCUMULATION_CAAS_INPUT="${PRECOMP_OUTDIR}/postproc/gene_filtering/filtered_discovery.tsv"
    VEP_CAAS_INPUT="$ACCUMULATION_CAAS_INPUT"
    SCORING_POSTPROC_INPUT="$ACCUMULATION_CAAS_INPUT"
    ACCUMULATION_BACKGROUND_INPUT="${PRECOMP_OUTDIR}/postproc/cleaned_backgrounds/cleaned_background_main.txt"
    SCORING_BACKGROUND_INPUT="$ACCUMULATION_BACKGROUND_INPUT"
fi

if [ "${PRECOMP_USE_ACCUMULATION:-false}" = true ]; then
    SCORING_ACCUM_DIR="${PRECOMP_OUTDIR}/accumulation"
fi

if [ "${PRECOMP_USE_RER:-false}" = true ]; then
    RER_CONTINUOUS_FILE="${PRECOMP_OUTDIR}/rerconverge/rer_results/${TRAIT}.continuous.output"
    # perms RDS only exists if the source run's phenotype actually had permulation on.
    RER_PERMS_FILE="${PRECOMP_OUTDIR}/rerconverge/rer_results/${TRAIT}.continuous.perms.rds"
    SCORING_RER_PERMS_INPUT="$RER_PERMS_FILE"
    # Scoring's own RER fallback is RER_REPORT's rendered summary, not RER_CONT's raw
    # output above — different producer, filename carries a variable suffix so it's
    # resolved with a glob at generation time here rather than a fixed path.
    SCORING_RER_INPUT="$(ls "${PRECOMP_OUTDIR}/rerconverge/rer_results/"rerconverge_summary_*.tsv 2>/dev/null | head -n1 || true)"
fi

if [ "${PRECOMP_USE_FADE:-false}" = true ]; then
    FADE_JSON_DIR_TOP="${PRECOMP_OUTDIR}/selection/fade/top/json"
    FADE_JSON_DIR_BOTTOM="${PRECOMP_OUTDIR}/selection/fade/bottom/json"
    # summary/site TSVs are optional emits — only exist if FADE's report step actually
    # produced them for the source run.
    SCORING_FADE_SUMMARY_TOP="${PRECOMP_OUTDIR}/selection/fade/top/fade_summary_top.tsv"
    SCORING_FADE_SUMMARY_BOTTOM="${PRECOMP_OUTDIR}/selection/fade/bottom/fade_summary_bottom.tsv"
    SCORING_FADE_SITE_TOP="${PRECOMP_OUTDIR}/selection/fade/top/fade_site_bf_top.tsv"
    SCORING_FADE_SITE_BOTTOM="${PRECOMP_OUTDIR}/selection/fade/bottom/fade_site_bf_bottom.tsv"
fi

if [ "${PRECOMP_USE_VEP:-false}" = true ]; then
    # only exist if the source run had the matching DB (PrimateAI-3D/COSMIC) configured.
    SCORING_VEP_PRIMATEAI="${PRECOMP_OUTDIR}/vep/primateai_mapped.tsv"
    SCORING_VEP_COSMIC="${PRECOMP_OUTDIR}/vep/cosmic_scores.tsv"
fi

{% if resources.process_overrides %}
# Per-process cpus/memory overrides from the Resources tab's advanced table.
# Nextflow only reads these from a config file, never from --flags, so this is
# generated here and loaded last via -c below (last-defined selector wins),
# overriding conf/resources.config's own per-process defaults where set.
RESOURCES_OVERRIDE="$WORK_DIR/resources.override.config"
cat > "$RESOURCES_OVERRIDE" <<'EOF'
process {
{% for o in resources.process_overrides %}
    {{ o.selector_type }}: '{{ o.selector }}' {
{% if o.cpus %}        cpus   = { {{ o.cpus }} }
{% endif %}
{% if o.memory %}        memory = { {{ o.memory }} }
{% endif %}
    }
{% endfor %}
}
EOF
{% endif %}

# =============================================================================
# RESOLVE CONDITIONAL VALUES
# =============================================================================
# All module toggles are resolved to shell variables (true/false) BEFORE writing
# params.json. This replaces the old approach of conditionally appending flags to
# a bash NF_FLAGS array.
#
# Key design principle: ALL parameters are included in params.json unconditionally.
# When a module is off, its parameters still appear (matching conf/*.config defaults
# or as empty strings) — Nextflow ignores them because main.nf gates on the toggle.
# This eliminates all conditional NF_FLAGS+=() logic.

_RUN_REPORTING="${RUN_REPORTING:-{{ run_defaults.reporting }}}"
_RUN_CAAS="${RUN_CAAS:-{{ run_defaults.caas }}}"
_RUN_DISAMBIGUATION="${RUN_DISAMBIGUATION:-{{ run_defaults.disambiguation }}}"
_RUN_CT_POSTPROC="${RUN_CT_POSTPROC:-{{ run_defaults.ct_postproc }}}"
_RUN_ACCUMULATION="${RUN_ACCUMULATION:-{{ run_defaults.accumulation }}}"
_RUN_RER="${RUN_RER:-{{ run_defaults.rer }}}"
_RUN_FADE="${RUN_FADE:-{{ run_defaults.fade }}}"
_RUN_VEP="${RUN_VEP:-{{ run_defaults.vep }}}"
_RUN_SCORING="${RUN_SCORING:-{{ run_defaults.scoring }}}"
_RUN_SCORING_STRESS="${RUN_SCORING_STRESS:-{{ run_defaults.scoring_stress }}}"
_RUN_ENRICHMENT="${RUN_ENRICHMENT:-{{ run_defaults.enrichment }}}"
_RUN_POSENRICH="${RUN_POSENRICH:-{{ run_defaults.posenrich }}}"
_ASR_ROBUSTNESS="${ASR_ROBUSTNESS:-{{ run_defaults.asr_robustness }}}"
_TOY_MODE="${TOY_MODE:-false}"

# CAAS: when enabled, pass the tool string; when off, an empty ct_tool disables the
# CT() workflow in main.nf (empty string is falsy in Groovy, unlike CLI's
# --ct_tool "" which becomes Boolean true). In JSON, "ct_tool": "" cleanly delivers
# an empty string — no --ct_tool= workaround needed.
if [ "$_RUN_CAAS" = true ]; then
    _CT_TOOL="{{ ct_tool_string }}"
else
    _CT_TOOL=""
fi

# Contrast selection is tracked separately from CAAS because it is the only producer
# of the fg/bg trait file (CHECK_MIN_CONTRASTS' traitfile_ok.tab), and that file is
# consumed by more than CT itself. CT_DISAMBIGUATION needs it to know which species
# are foreground vs background when it re-analyses convergence, so a run that reuses
# a precomputed CAAStools discovery but still computes disambiguation must keep
# contrast selection on — otherwise no trait file exists anywhere and main.nf stops
# with "CT disambiguation requires a trait file from CT/contrast_selection or
# --caas_config" (the GUI drives phenotypes through --my_traits and never sets
# --caas_config). Re-deriving it is safe: the contrast algorithm is deterministic
# given the same --my_traits and tree, so it reproduces the pairing the precomputed
# discovery was built on.
if [ "$_RUN_CAAS" = true ] || [ "$_RUN_DISAMBIGUATION" = true ]; then
    _CONTRAST_SELECTION=true
else
    _CONTRAST_SELECTION=false
fi

# RER tool string: only when RER is enabled.
if [ "$_RUN_RER" = true ]; then
    _RER_TOOL_STR="${RER_TOOL}"
else
    _RER_TOOL_STR=""
fi

# Class-specific values: resolve my_traits source, secondary/n/c traits, and
# pruning based on CLASS before writing params.json.
# trait_type applies to both classes: CLASS 1 count-rate traits are always
# continuous (auto-detect won't fire), CLASS 2 traits are where an "ordinal"
# coded fg/bg phenotype lives. Pass through unchanged.
_TRAIT_TYPE="$TRAIT_TYPE"
if [ "$CLASS" = "1" ]; then
    _MY_TRAITS="$TRAIT_FILE"
    _SECONDARY_TRAIT="$SECONDARY_TRAIT"
    _N_TRAIT="$N_TRAIT"
    _C_TRAIT="$C_TRAIT"
    if [ -n "$PRUNE_FILE" ]; then
        _PRUNE_DATA=true
        _PRUNE_LIST="${PRUNE_DIR}/${PRUNE_FILE}"
        _PRUNE_LIST_SECONDARY=""
        [ -n "$PRUNE_SECONDARY_FILE" ] && _PRUNE_LIST_SECONDARY="${PRUNE_DIR}/${PRUNE_SECONDARY_FILE}"
    else
        _PRUNE_DATA=false
        _PRUNE_LIST=""
        _PRUNE_LIST_SECONDARY=""
    fi
elif [ "$CLASS" = "2" ]; then
    _MY_TRAITS="$SIMPLE_TRAIT_FILE"
    _SECONDARY_TRAIT=""
    _N_TRAIT=""
    _C_TRAIT=""
    _PRUNE_DATA=false
    _PRUNE_LIST=""
    _PRUNE_LIST_SECONDARY=""
else
    echo "Error: CLASS must be 1 or 2, got: $CLASS"
    exit 1
fi

# =============================================================================
# WRITE params.json
# =============================================================================
# Nextflow's -params-file natively accepts JSON. All pipeline parameters go here
# instead of 50-100+ --flag arguments on the command line, which:
# 1. Exceeded the ~8,096-char shell command-line limit on some systems
# 2. Was rejected by Seqera Cloud (Tower) UI
#
# -params-file values UNCONDITIONALLY override conf/*.config defaults (higher
# priority) — confirmed empirically 2026-08-01: a key present in params.json with
# value "" permanently defeats that param's `?: "default"` Elvis line in conf/*.config,
# even though the exact same "" arriving via a bare CLI flag (`--flag=`) does NOT (CLI
# values apply at a lower tier that config's Elvis defaulting still runs on top of).
# This is NOT the same thing as omitting the key entirely — an absent key still lets
# the config default apply normally; it's specifically writing "" that burns in empty.
#
# Boolean values are unquoted true/false (valid JSON boolean literals).
# String values use shell $VAR expansion (heredoc is unquoted for this).
# For params whose real conf/*.config default IS "" by design (e.g. fade_postproc_top,
# trait_out) the ${VAR:-} fallback below is correct and intentional. But for any param
# whose config default is a real, non-empty value (e.g. lg_dat_path, gene_trees), the
# same ${VAR:-} pattern silently breaks it the moment the corresponding GUI field is
# left blank (the common/optional case) — hit for real with lg_dat_path (crashed
# fade.nf's unconditional `file(params.lg_dat_path)` with "Argument of `file` function
# cannot be empty" the first time a run left the LG matrix path at its default). Bake
# the real default into the bash fallback for any such param instead of leaving it "".

PARAMS_JSON="$RUN_DIR/params.json"
cat > "$PARAMS_JSON" <<PARAMS_EOF
{
  "alignment": "$ALI_DIR",
  "ali_format": "${ALI_FORMAT:-fasta}",
  "ali_sp_names": "${ALI_SP_NAMES:-}",
  "tree": "$TREE_FILE",
  "outdir": "$RESULTS_BASE",
  "seed": "$SEED",
  "max_cpus": "$MAX_CPUS",
  "max_memory": "$MAX_MEMORY",
  "max_time": "$MAX_TIME",
  "sp_colname": "${SP_COLNAME:-species}",
  "clade_name": "${CLADE_NAME:-primates}",
  "taxon_of_interest": "${TAXON_OF_INTEREST:-family}",
  "tax_id": "${INPUT_TAX_ID:-}",
  "slurm_queue": "${SLURM_QUEUE:-haswell}",

  "my_traits": "$_MY_TRAITS",
  "traitname": "$TRAIT",
  "secondary_trait": "$_SECONDARY_TRAIT",
  "n_trait": "$_N_TRAIT",
  "c_trait": "$_C_TRAIT",
  "branch_trait": "$BRANCH_TRAIT",
  "trait_type": "$_TRAIT_TYPE",
  "prune_data": $_PRUNE_DATA,
  "prune_list": "$_PRUNE_LIST",
  "prune_list_secondary": "$_PRUNE_LIST_SECONDARY",

  "reporting": $_RUN_REPORTING,
  "toy_mode": $_TOY_MODE,
  "toy_n": "$TOY_N",

  "contrast_selection": $_CONTRAST_SELECTION,
  "ct_tool": "$_CT_TOOL",
  "caas_config": "$CAAS_CONFIG",
  "patterns": "${PATTERNS:-1,2,3}",
  "perm_pool_size": "$PERM_POOL_SIZE",
  "caas_permulation_enrichment": {{ run_defaults.caas_permulation_enrichment }},
  "caas_full_perms": "$CAAS_FULL_PERMS",
  "pss_top_pct": "${PSS_TOP_PCT:-0.01}",
  "max_contrasts": "${MAX_CONTRASTS:-0}",
  "min_contrasts": "${MIN_CONTRASTS:-3}",
  "publish_intermediates": {{ run_defaults.publish_intermediates }},
  "ct_discovery_batch_size": "${CT_DISCOVERY_BATCH_SIZE:-25}",
  "ct_bootstrap_batch_size": "${CT_BOOTSTRAP_BATCH_SIZE:-10}",
  "min_divergent_fraction": "${MIN_DIVERGENT_FRACTION:-0.5}",
  "max_bg_gaps_fraction": "${MAX_BG_GAPS_FRACTION:-0.0}",
  "max_fg_gaps_fraction": "${MAX_FG_GAPS_FRACTION:-0.0}",
  "max_gaps_fraction": "${MAX_GAPS_FRACTION:-0.0}",
  "max_bg_miss_fraction": "${MAX_BG_MISS_FRACTION:-0.0}",
  "max_fg_miss_fraction": "${MAX_FG_MISS_FRACTION:-0.0}",
  "max_miss_fraction": "${MAX_MISS_FRACTION:-0.0}",
  "miss_pair": {{ run_defaults.miss_pair }},
  "caap_mode": {{ run_defaults.caap_mode }},
  "resample_use_n": {{ run_defaults.resample_use_n }},
  "perm_strategy": "${PERM_STRATEGY:-BM}",
  "max_tries": "${MAX_TRIES:-1000000}",
  "chunk_size": "${CHUNK_SIZE:-500}",
  "include_b0": {{ run_defaults.include_b0 }},
  "multi_hypothesis": {{ run_defaults.multi_hypothesis }},
  "max_fop": "${MAX_FOP:-100}",
  "caas_perms_fop": {{ run_defaults.caas_perms_fop }},
  "export_groups": {{ run_defaults.export_groups }},
  "export_perm_discovery": {{ run_defaults.export_perm_discovery }},
  "discovery_from": "${DISCOVERY_FROM:-}",
  "resample_from": "${RESAMPLE_FROM:-}",
  "bootstrap_from": "${BOOTSTRAP_FROM:-}",

  "ct_disambiguation": $_RUN_DISAMBIGUATION,
  "ct_postproc": $_RUN_CT_POSTPROC,
  "asr_robustness": $_ASR_ROBUSTNESS,
  "ct_disambig_asr_mode": "$ASR_MODE",
  "ct_disambig_asr_model": "${ASR_MODEL:-lg}",
