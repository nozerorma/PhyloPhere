#!/bin/bash
{# run_single.sh.j2 — Single-phenotype runner: writes params.json and runs Nextflow for one phenotype.
   PhyloPhere | gui/generation/templates/

   Rendered by gui/generation/render.py (render_single) from the context of
   gui/generation/context.py, and called once per phenotype row by the script
   rendered from sbatch_array.sh.j2, which exports the shell variables read here.

   Consumes: general, runtime, resources, modules, precomputed, run_defaults, profile,
             ct_tool_string, rer_tool_string, reuse_exploratory, strict_pass.
   Produces: bash script; its run directory holds params.json, and the Nextflow
             results go to <results_dir>/<trait>[<tag>] (RESULTS_BASE). #}
set -Eeuo pipefail

# Generated by the PhyloPhere runner GUI. Edit the project file and regenerate
# instead of editing this file, unless the change is a one-off.

# ── Arguments ─────────────────────────────────────────────────────────────────
TRAIT="${1:?Usage: $0 <TRAIT> [SECONDARY_TRAIT] [N_TRAIT] [C_TRAIT] [PRUNE_FILE] [PRUNE_SECONDARY_FILE] [TRAIT_TYPE]}"
SECONDARY_TRAIT="${2:-}"
N_TRAIT="${3:-}"
C_TRAIT="${4:-}"
PRUNE_FILE="${5:-}"
PRUNE_SECONDARY_FILE="${6:-}"
TRAIT_TYPE="${7:-}"   # "" / auto = infer, ordinal = coded fg/bg, continuous = force PSS

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
timestamp=$(date +%Y%m%d_%H%M%S)

# ── Environment activation ────────────────────────────────────────────────────
# Activates the phylophere environment with micromamba, or with conda when micromamba
# is absent. nounset is off while the activation hooks run.
set +u
if command -v micromamba >/dev/null 2>&1; then
    eval "$(micromamba shell hook --shell bash)"
    micromamba activate phylophere
elif [ -n "${CONDA_EXE:-}" ] || command -v conda >/dev/null 2>&1; then
    __base="$(conda info --base 2>/dev/null || dirname "$(dirname "${CONDA_EXE:-}")")"
    [ -f "$__base/etc/profile.d/conda.sh" ] && . "$__base/etc/profile.d/conda.sh"
    conda activate phylophere
fi
set -u

# ── Post-processing pass and output directories ───────────────────────────────
# The post-processing mode sets RUN_TAG ("_exploratory", "_complete" or "") first, so
# that the Nextflow home, run and work directories below are keyed on
# ${TRAIT}${RUN_TAG} as RESULTS_BASE is. Otherwise the exploratory and complete passes
# of one trait would share NXF_HOME, RUN_DIR and WORK_DIR and collide on the locks of
# the history database and the session cache.
if [ "${POSTPROC_MODE:-}" = "exploratory" ]; then
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}_exploratory"
    RUN_TAG="_exploratory"
    # The exploratory pass only sweeps minlen_values x maxcaas_values. Every downstream
    # module waits for the _complete pass, RER and FADE included (they do not depend on
    # post-processing); they run there when enabled in the project.
    RUN_POSENRICH=false
    RUN_VEP=false
    RUN_FADE=false
    RUN_RER=false
    RUN_SCORING=false
    # The evidence table is written after SCORING; main.nf rejects it without --scoring.
    CAAS_EVIDENCE_TOP_N=0
elif [ "${POSTPROC_MODE:-}" = "filter" ]; then
{% if strict_pass %}
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}_strict"
    RUN_TAG="_strict"
{% else %}
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}_complete"
    RUN_TAG="_complete"
{% endif %}
{% if reuse_exploratory or strict_pass %}
    # This pass reuses the CAAS and Disambiguation output of another pass by file instead of recomputing it (no -resume
    # or shared work directory involved): the exploratory pass generated alongside this script, or, for the strict
    # pass, the strict tables of the normal run. CT discovery/resample and live Disambiguation are off. CT_POSTPROC
    # stays on: it applies the single chosen filter_minlen/filter_maxcaas pair instead of the exploratory sweep, and
    # reads the master CSV of Disambiguation and the background genes from the reused outdir. The ASR diagnostics
    # report was already produced with the same disambiguation data and is not rerun.
    RUN_CAAS=false
    RUN_DISAMBIGUATION=false
    ASR_DIAGNOSTICS=false
{% if strict_pass %}
    # The strict pass reads the strict tables (<outdir>/strict/) that the normal run wrote, and everything that does not
    # depend on conservation (curated tree, data exploration, permulation design) from that run itself. The strict
    # tables come from the pass that ran the permulation core: the plain run, the complete pass, or, when the exploratory
    # and complete passes were both generated, the exploratory pass (the complete pass reuses its CAAS output).
    NORMAL_RUN_OUTDIRS=("${CAAS_OUTBASE}/${TRAIT}${TAG}_complete" "${CAAS_OUTBASE}/${TRAIT}${TAG}" "${CAAS_OUTBASE}/${TRAIT}${TAG}_exploratory")
    PASS_SOURCE_OUTDIR=""
    for _d in "${NORMAL_RUN_OUTDIRS[@]}"; do
        if [ -d "${_d}/strict" ]; then PASS_SOURCE_OUTDIR="$_d"; break; fi
    done
    [ -n "$PASS_SOURCE_OUTDIR" ] || {
        echo "[ERROR] no strict tables in any of: ${NORMAL_RUN_OUTDIRS[*]} (under /strict). Run the normal scripts first, with min_divergent_fraction < 1 and strict_conservation_output on" >&2
        exit 1
    }
    CAAS_REUSE_OUTDIR="${PASS_SOURCE_OUTDIR}/strict"
    # FADE and RER are computed by the pass that runs the downstream modules (the complete pass, not the exploratory one),
    # so each is looked for among the normal runs on its own.
    FADE_SOURCE_OUTDIR=""
    RER_SOURCE_OUTDIR=""
    for _d in "${NORMAL_RUN_OUTDIRS[@]}"; do
        [ -z "$FADE_SOURCE_OUTDIR" ] && [ -f "${_d}/selection/fade/top/fade_summary_top.tsv" -o -f "${_d}/selection/fade/bottom/fade_summary_bottom.tsv" ] && FADE_SOURCE_OUTDIR="$_d"
        [ -z "$RER_SOURCE_OUTDIR" ] && [ -d "${_d}/rerconverge/rer_results" ] && RER_SOURCE_OUTDIR="$_d"
    done
{% else %}
    PASS_SOURCE_OUTDIR="${CAAS_OUTBASE}/${TRAIT}${TAG}_exploratory"
    CAAS_REUSE_OUTDIR="$PASS_SOURCE_OUTDIR"
{% endif %}
    # The evidence table re-scores the rows of the observed discovery.tab, which this pass was not given through
    # --discovery_from (that would also make it look for permulation exports next to the file).
    CAAS_EVIDENCE_DISCOVERY="${CAAS_REUSE_OUTDIR}/caastools/discovery.tab"
    DISAMBIGUATION_INPUT="${CAAS_REUSE_OUTDIR}/ct_disambiguation/caas_convergence_master.csv"
    DISAMBIGUATION_DIR="${CAAS_REUSE_OUTDIR}/ct_disambiguation"
    BACKGROUND_INPUT="${CAAS_REUSE_OUTDIR}/caastools/background_genes.output"
    # background.output (tested positions, gene<TAB>comma-separated columns) is the
    # position-level counterpart of background_genes.output; POSENRICH Accumulation
    # builds its universe of positions from it. PRECOMP_USE_DISCOVERY sets the same
    # variable below. This pass skips live CT, so without it the file would fall back
    # to the NO_FILE sentinel and POSENRICH would fail.
    POSENRICH_BACKGROUND_FILE="${CAAS_REUSE_OUTDIR}/caastools/background.output"

    # CAAS permulation-excess null. The permulation core runs only where CT ran (the
    # exploratory pass), while SCORING and ENRICHMENT, which consume it, run only in
    # this pass. They are pointed at the published outputs of the exploratory pass, as
    # the background substitutions above are. Without them the CAAS FCS p.perm and the
    # position-level permulation section of the report come out empty, although the
    # permulation null was computed.
    CAAS_NULL_DIR="${CAAS_REUSE_OUTDIR}/caas_permulation"
    CAAS_PERM_MANIFEST_FILE="${PASS_SOURCE_OUTDIR}/caastools/permulation_manifest.tsv"
    CAAS_PERM_HARVEST_FILE="${PASS_SOURCE_OUTDIR}/caastools/permulation_harvest.tsv"
    for _f in "$CAAS_NULL_DIR/cycle_roster.txt" "$CAAS_NULL_DIR/cycle_summary.tsv"; do
        [ -f "$_f" ] || echo "[WARN] expected canonical null output missing: $_f" >&2
    done

    # REPORTING (dataset exploration, tree name curation and, for a row with a
    # PRUNE_FILE, pruning) ran identically in the exploratory pass, with the same
    # --my_traits and --tree whatever the POSTPROC_MODE, so rerunning it would only
    # reproduce the same HTML and data_exploration reports. The tree and trait file
    # handed to Nextflow are instead replaced by the curated output of the exploratory
    # pass (pruned too, if this row prunes species), which TREE_CLEANUP and DATASET_PRUNE
    # publish whichever subworkflow (REPORTING or CONTRAST_SELECTION) invoked them.
    # Overriding $TREE_FILE and $TRAIT_FILE here, rather than adding a main.nf
    # parameter, gives the curated tree to every consumer that falls back to
    # params.tree (e.g. SELECTION_PREP of FADE). The pruned_trait_file of
    # 0.Data_pruning.Rmd is a row-filtered, tab-separated copy of the original
    # --my_traits file with the same columns, so it can stand in for TRAIT_FILE.
    RUN_REPORTING=false
    PRUNED_TREE_CANDIDATE="${PASS_SOURCE_OUTDIR}/data_exploration/0.Data-pruning/pruned_tree_file.nwk"
    if [ -f "$PRUNED_TREE_CANDIDATE" ]; then
        TREE_FILE="$PRUNED_TREE_CANDIDATE"
        TRAIT_FILE="${PASS_SOURCE_OUTDIR}/data_exploration/0.Data-pruning/pruned_trait_file.tsv"
    else
        TREE_FILE="${PASS_SOURCE_OUTDIR}/name_curation/curated_tree.nwk"
    fi

    # SELECTION_PREP of FADE (subworkflows/SELECTION/selection_prep.nf) falls back to
    # ${outdir}/data_exploration/1.Data-exploration/1.Species_distribution/trait_stats.csv
    # when it has no live upstream channel, which is the case here because REPORTING is
    # off. The fallback is relative to $RESULTS_BASE (the outdir of this pass, not of the
    # exploratory one) and the file is not checked for existence before it reaches the
    # process, so FADE would fail with a FileNotFoundError in EXTRACT_EXTREME_SPECIES.
    # The data_exploration/ published by the exploratory pass is symlinked in, so that
    # the existing fallback path resolves.
    mkdir -p "$RESULTS_BASE"
    if [ -d "${PASS_SOURCE_OUTDIR}/data_exploration" ] && [ ! -e "${RESULTS_BASE}/data_exploration" ]; then
        ln -sfn "${PASS_SOURCE_OUTDIR}/data_exploration" "${RESULTS_BASE}/data_exploration"
    fi
{% endif %}
else
    RESULTS_BASE="${CAAS_OUTBASE}/${TRAIT}${TAG}"
    RUN_TAG=""
fi

# A Nextflow home of its own per trait and pass avoids lock collisions on the history database.
export NXF_HOME="$WORK_BASE/.nextflow/.nextflow_${TRAIT}${RUN_TAG}"
mkdir -p "$NXF_HOME"
ln -sfn "{{ general.nextflow_plugins_dir }}" "$NXF_HOME/plugins"

# Run from a directory of its own for the same reason (session and cache database locks).
RUN_DIR="$WORK_BASE/${TRAIT}${RUN_TAG}_nxf_run"
mkdir -p "$RUN_DIR"
cd "$RUN_DIR"

WORK_DIR="${WORK_BASE}/${TRAIT}${TAG}${RUN_TAG}"
mkdir -p "${RESULTS_BASE}" "${WORK_DIR}"

# ── Precomputed reuse (Precomputed Run tab) ───────────────────────────────────
# Every path below is base_path/<TRAIT>/<subpath>, the publishDir of the process that
# produces the file (gui/models/precomputed.py lists the table). Checking a box in the
# GUI both sets the matching variable and switches the corresponding module off through
# its enabled toggle, which RUN_* already reflects. This block therefore only supplies
# the value that the precomputed input of each module takes.
PRECOMP_OUTDIR="${PRECOMP_BASE_PATH:-}/${TRAIT}"
if [ ! -d "$PRECOMP_OUTDIR" ] && [ -d "${PRECOMP_BASE_PATH:-}/${TRAIT}_complete" ]; then
    PRECOMP_OUTDIR="${PRECOMP_BASE_PATH:-}/${TRAIT}_complete"
elif [ ! -d "$PRECOMP_OUTDIR" ] && [ -n "${TAG:-}${RUN_TAG:-}" ] && [ -d "${PRECOMP_BASE_PATH:-}/${TRAIT}${TAG:-}${RUN_TAG:-}" ]; then
    PRECOMP_OUTDIR="${PRECOMP_BASE_PATH:-}/${TRAIT}${TAG:-}${RUN_TAG:-}"
fi

{% if strict_pass %}
# FADE and RER do not depend on conservation: the strict pass reads the tables of the run it derives from instead of
# running them again (only when that run has them).
PRECOMP_OUTDIR="$PASS_SOURCE_OUTDIR"
if [ "${RUN_FADE:-false}" = true ] && [ -n "$FADE_SOURCE_OUTDIR" ]; then
    PRECOMP_USE_FADE=true
    RUN_FADE=false
fi
if [ "${RUN_RER:-false}" = true ] && [ -n "$RER_SOURCE_OUTDIR" ]; then
    PRECOMP_USE_RER=true
    RUN_RER=false
fi
{% endif %}
if [ "${PRECOMP_USE_DISCOVERY:-false}" = true ]; then
    DISCOVERY_FROM="${PRECOMP_OUTDIR}/caastools/discovery.tab"
    # meta_caas/ is where CT_META_CAAS publishes.
    META_CAAS_FROM="${PRECOMP_OUTDIR}/meta_caas/meta_caas/meta_caas.tsv"
    BACKGROUND_INPUT="${PRECOMP_OUTDIR}/caastools/background_genes.output"
    POSENRICH_BACKGROUND_FILE="${PRECOMP_OUTDIR}/caastools/background.output"
    # These exist only if the source run had --caas_permulation_enrichment on. The caas_permulation/ directory
    # (null_positions.parquet, blocks/, cycle_roster.txt, counts.json, cycle_summary.tsv, cycle_hist.tsv) is the
    # position-level null of SCORING and POSENRICH Accumulation. The reuse_exploratory branch above sets the same
    # variable; keep the two in sync.
    CAAS_NULL_DIR="${PRECOMP_OUTDIR}/caas_permulation"
    [ -f "$CAAS_NULL_DIR/cycle_roster.txt" ] || {
        echo "[WARN] cycle_roster.txt missing in $CAAS_NULL_DIR: the position-level null cannot be used" >&2
        CAAS_NULL_DIR=""
    }
    CAAS_PERM_MANIFEST_FILE="${PRECOMP_OUTDIR}/caastools/permulation_manifest.tsv"
    CAAS_PERM_HARVEST_FILE="${PRECOMP_OUTDIR}/caastools/permulation_harvest.tsv"
fi
if [ "${PRECOMP_USE_RESAMPLE:-false}" = true ]; then
    RESAMPLE_FROM="${PRECOMP_OUTDIR}/caastools/resample.tab"
fi

if [ "${PRECOMP_USE_DISAMBIGUATION:-false}" = true ]; then
    DISAMBIGUATION_INPUT="${PRECOMP_OUTDIR}/ct_disambiguation/caas_convergence_master.csv"
    DISAMBIGUATION_DIR="${PRECOMP_OUTDIR}/ct_disambiguation"
fi

if [ "${PRECOMP_USE_POSTPROC:-false}" = true ]; then
    # gene_filtering/ and cleaned_backgrounds/ exist only if the source run had
    # gene_filter_mode other than 'none' (the default).
    _PP_CAAS="${PRECOMP_OUTDIR}/postproc/gene_filtering/filtered_discovery.tsv"
    _PP_BACKGROUND="${PRECOMP_OUTDIR}/postproc/cleaned_backgrounds/cleaned_background_main.txt"
    SCORING_POSTPROC_INPUT="$_PP_CAAS"
    SCORING_BACKGROUND_INPUT="$_PP_BACKGROUND"
    # A standalone Accumulation input given in the POSENRICH tab wins over the precomputed Post-processing output.
    [ -n "${ACCUMULATION_CAAS_INPUT:-}" ] || ACCUMULATION_CAAS_INPUT="$_PP_CAAS"
    [ -n "${ACCUMULATION_BACKGROUND_INPUT:-}" ] || ACCUMULATION_BACKGROUND_INPUT="$_PP_BACKGROUND"
fi

if [ "${PRECOMP_USE_RER:-false}" = true ]; then
    # The source run wrote <trait>.binary.* for a binary trait and <trait>.continuous.* otherwise.
    _RER_RES="${RER_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/rerconverge/rer_results"
    if [ -f "${_RER_RES}/${TRAIT}.binary.output" ] && [ ! -f "${_RER_RES}/${TRAIT}.continuous.output" ]; then
        _RER_KIND=binary
        RER_BINARY_FILE="${_RER_RES}/${TRAIT}.binary.output"
    else
        _RER_KIND=continuous
        RER_CONTINUOUS_FILE="${_RER_RES}/${TRAIT}.continuous.output"
    fi
    # The perms RDS exists only if the source run had permulation on for this phenotype.
    RER_PERMS_FILE="${_RER_RES}/${TRAIT}.${_RER_KIND}.perms.rds"
    SCORING_RER_PERMS_INPUT="$RER_PERMS_FILE"
    # Scoring takes the summary table of RER_REPORT, not the raw RER_CONT output above:
    # a different producer, whose filename carries a variable suffix, so it is resolved
    # with a glob here instead of a fixed path.
    SCORING_RER_INPUT="$(ls "${RER_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/rerconverge/rer_results/"rerconverge_summary_*.tsv 2>/dev/null | head -n1 || true)"
fi

if [ "${PRECOMP_USE_FADE:-false}" = true ]; then
    # One direction at a time: a run with a single FADE direction has an empty directory for the other, and main.nf
    # rejects a --fade_tables_dir_<direction> without its merged tables. The summary and site TSVs are optional emits:
    # they exist only if the report step of FADE produced them in the source run.
    if [ -f "${FADE_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/selection/fade/top/fade_summary_top.tsv" ]; then
        FADE_TABLES_DIR_TOP="${FADE_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/selection/fade/top"
        SCORING_FADE_SUMMARY_TOP="${FADE_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/selection/fade/top/fade_summary_top.tsv"
        SCORING_FADE_SITE_TOP="${FADE_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/selection/fade/top/fade_site_bf_top.tsv"
    fi
    if [ -f "${FADE_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/selection/fade/bottom/fade_summary_bottom.tsv" ]; then
        FADE_TABLES_DIR_BOTTOM="${FADE_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/selection/fade/bottom"
        SCORING_FADE_SUMMARY_BOTTOM="${FADE_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/selection/fade/bottom/fade_summary_bottom.tsv"
        SCORING_FADE_SITE_BOTTOM="${FADE_SOURCE_OUTDIR:-$PRECOMP_OUTDIR}/selection/fade/bottom/fade_site_bf_bottom.tsv"
    fi
fi

if [ "${PRECOMP_USE_VEP:-false}" = true ]; then
    # Each exists only if the source run had the matching database (PrimateAI-3D, COSMIC, Ensembl VEP) configured.
    SCORING_VEP_PRIMATEAI="${PRECOMP_OUTDIR}/vep/primateai_mapped.tsv"
    SCORING_VEP_COSMIC="${PRECOMP_OUTDIR}/vep/cosmic_scores.tsv"
    SCORING_VEP_ENSEMBL="${PRECOMP_OUTDIR}/vep/ensembl_vep_mapped.tsv"
fi

{% if resources.process_overrides %}
# Per-process cpus and memory overrides from the advanced table of the Resources tab.
# Nextflow reads per-process settings only from a config file, not from flags, so the
# file is generated here and loaded last through -c below (the last selector wins),
# which overrides the per-process defaults of conf/resources.config where set.
RESOURCES_OVERRIDE="$WORK_DIR/resources.override.config"
cat > "$RESOURCES_OVERRIDE" <<'EOF'
process {
{% for o in resources.process_overrides %}
    {{ o.selector_type }}: '{{ o.selector }}' {
{% if o.cpus %}        cpus   = { {{ o.cpus }} }
{% endif %}
{% if o.memory %}        memory = { {{ o.memory }} }
{% endif %}
    }
{% endfor %}
}
EOF
{% endif %}

# ── Resolve conditional values ────────────────────────────────────────────────
# The module toggles are resolved to shell variables (true/false) before params.json
# is written. Every parameter is written to params.json unconditionally: when a module
# is off its parameters still appear (with the conf/*.config default or an empty
# string) and Nextflow ignores them, because main.nf gates on the toggle. No flag is
# appended conditionally.

_RUN_REPORTING="${RUN_REPORTING:-{{ run_defaults.reporting }}}"
_RUN_CAAS="${RUN_CAAS:-{{ run_defaults.caas }}}"
_RUN_DISAMBIGUATION="${RUN_DISAMBIGUATION:-{{ run_defaults.disambiguation }}}"
_RUN_CT_POSTPROC="${RUN_CT_POSTPROC:-{{ run_defaults.ct_postproc }}}"
_RUN_RER="${RUN_RER:-{{ run_defaults.rer }}}"
_RUN_FADE="${RUN_FADE:-{{ run_defaults.fade }}}"
_RUN_VEP="${RUN_VEP:-{{ run_defaults.vep }}}"
_RUN_SCORING="${RUN_SCORING:-{{ run_defaults.scoring }}}"
_RUN_ENRICHMENT="${RUN_ENRICHMENT:-{{ run_defaults.enrichment }}}"
_RUN_POSENRICH="${RUN_POSENRICH:-{{ run_defaults.posenrich }}}"
_ASR_DIAGNOSTICS="${ASR_DIAGNOSTICS:-{{ run_defaults.asr_diagnostics }}}"
_TOY_MODE="${TOY_MODE:-false}"
_REMOVE_WORK="${REMOVE_WORK:-{{ 'true' if runtime.remove_work else 'false' }}}"

# CAAS: the tool string when enabled; when off, an empty ct_tool disables the CT()
# workflow in main.nf (an empty string is falsy in Groovy, whereas a command-line
# --ct_tool "" arrives as Boolean true). "ct_tool": "" in params.json delivers a real
# empty string.
if [ "$_RUN_CAAS" = true ]; then
    _CT_TOOL="{{ ct_tool_string }}"
else
    _CT_TOOL=""
fi

# Contrast selection is tracked apart from CAAS because it is the only producer of the
# foreground/background trait file (traitfile_ok.tab of CHECK_MIN_CONTRASTS), which CT
# is not the only consumer of: the observed scoring needs it to know which species are
# foreground or background when it re-analyzes convergence. A run that reuses a
# precomputed CAAStools discovery but still computes Disambiguation must therefore keep
# contrast selection on; otherwise no trait file exists and main.nf stops with "CT
# disambiguation requires a trait file from CT/contrast_selection or --caas_config" (the
# GUI never sets --caas_config). Deriving it again is safe: the contrast algorithm is
# deterministic for the same --my_traits and tree, so it reproduces the pairing of the
# precomputed discovery.
# The evidence table of a pass that reuses its tables (CAAS_EVIDENCE_DISCOVERY) also needs the design and the tree of the
# contrasts: without them its process has no input and does not run.
if [ "$_RUN_CAAS" = true ] || [ "$_RUN_DISAMBIGUATION" = true ] || { [ -n "${CAAS_EVIDENCE_DISCOVERY:-}" ] && [ "${CAAS_EVIDENCE_TOP_N:-0}" != 0 ]; }; then
    _CONTRAST_SELECTION=true
else
    _CONTRAST_SELECTION=false
fi

# RER tool string, only when RER is enabled.
if [ "$_RUN_RER" = true ]; then
    _RER_TOOL_STR="${RER_TOOL}"
else
    _RER_TOOL_STR=""
fi

# Trait file, secondary/n/c traits and pruning, resolved before params.json is written.
# Every field except TRAIT is optional. The R side (subworkflows/TRAIT_ANALYSIS/local/src/
# sample_size.R, commons.R) branches on the presence of columns, not on a class flag, so
# blank values pass through unchanged.
_MY_TRAITS="$TRAIT_FILE"
_SECONDARY_TRAIT="$SECONDARY_TRAIT"
_N_TRAIT="$N_TRAIT"
_C_TRAIT="$C_TRAIT"
_TRAIT_TYPE="$TRAIT_TYPE"
if [ -n "$PRUNE_FILE" ]; then
    _PRUNE_DATA=true
    _PRUNE_LIST="${PRUNE_DIR}/${PRUNE_FILE}"
    _PRUNE_LIST_SECONDARY=""
    [ -n "$PRUNE_SECONDARY_FILE" ] && _PRUNE_LIST_SECONDARY="${PRUNE_DIR}/${PRUNE_SECONDARY_FILE}"
else
    _PRUNE_DATA=false
    _PRUNE_LIST=""
    _PRUNE_LIST_SECONDARY=""
fi

# ── Write params.json ─────────────────────────────────────────────────────────
# Nextflow's -params-file accepts JSON, and every pipeline parameter goes there instead
# of 50 to 100 --flag arguments, which can exceed the command-line length limit of
# some systems.
#
# The values of -params-file take precedence over the defaults of conf/*.config. A key
# written as "" therefore keeps the empty string, even where the config has a
# `?: "default"` line, whereas an absent key lets the config default apply. Hence the
# bash fallbacks below: for a parameter whose config default is "" by design
# (e.g. gene_ensembl_file, secondary_trait), the ${VAR:-} fallback is intended; for one
# whose config default is a real value (e.g. lg_dat_path, gene_trees), the real default
# is written into the bash fallback, so that a blank GUI field does not turn it into "".
#
# Booleans are unquoted true/false (JSON literals). Strings use shell $VAR expansion
# (the heredoc is unquoted for this).

# Generate tax_id and gene_ensembl_file when left blank (bin/resolve_core_inputs.py).
# This happens here, before Nextflow starts, and not inside main.nf: Nextflow keeps
# only the first assignment of a params key, so a params.tax_id set after the default
# of conf/common.config has run is silently ignored.
if [[ -z "${INPUT_TAX_ID:-}" || ( -z "${GENE_ENSEMBL_FILE:-}" && "${AUTO_GENERATE_ENSEMBL:-false}" == "true" ) ]]; then
    _CORE_INPUTS_RESOLVED="$(python3 "$REPO_DIR/bin/resolve_core_inputs.py" \
        --outdir "$RESULTS_BASE" --tree "$TREE_FILE" --alignment "$ALI_DIR" \
        --tax-id "${INPUT_TAX_ID:-}" --gene-ensembl-file "${GENE_ENSEMBL_FILE:-}" \
        $([ "${AUTO_GENERATE_ENSEMBL:-false}" == "true" ] && echo "--auto-generate-ensembl") \
        --ensembl-dataset "${ENSEMBL_DATASET:-}" \
        --ref-species "${REF_SPECIES_NAME:-Homo_sapiens}")"
    INPUT_TAX_ID="$(echo "$_CORE_INPUTS_RESOLVED" | grep '^TAX_ID=' | cut -d= -f2-)"
    GENE_ENSEMBL_FILE="$(echo "$_CORE_INPUTS_RESOLVED" | grep '^GENE_ENSEMBL_FILE=' | cut -d= -f2-)"
fi

# Resolve --gmt_dir when left blank: copies the gene sets versioned in
# subworkflows/ENRICHMENT/dat/ and, when AUTO_FETCH_GMT is true, adds the current GO and
# WikiPathways sets (bin/resolve_gmts.py). A failed download stops the run;
# core_inputs/gmt/gmt_source.json records the origin and checksum of every file.
